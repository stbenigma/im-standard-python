[ODM]
#base directory for all model data (with ending /)
#odmbasedirec = 

#base directory for odm-model-files (with ending /)
#default <odmBaseDirec> + odmIMDefaultDirec
#odmimdirec = 

#model name
#default: single .dmd file in <odmIMDirec> or <odmIMDirec>/IM or <odmIMDirec>/github/IM
odmmodelname = "IM_ATTR_FYAYC"

#directory containing versioned model
odmvcsdirec = "gitHub/"

#default directory for odm-model—file (below odmIMDirec)
#odmimdefaultdirec = "IM/"

#default extension of odm-model-base file
#odmimextension = ".dmd"

#directory containing odm-configuration-files (below odmIMDirec)
#odmkonfdirec = "Konfiguration/"

#name of user defined property-File containing translations udp"s
#odmudptranslfilename = "translation"

#name of user defined property-File containing data mapping udp"s
#odmudpmappingfilename = "datamapping"

######################
#FROM HERE ON: DO NEVER CHANGE UNLESS ODM-Structures changes
#name of file in odm-configuration containing domain definitions
#odmdomainsfile =  "defaultdomains.xml"

#name of file in odm-configuration containing type definitions
#odmtypesfile =  "types.xml"

#directory in odm-directory-structure containing files 
#odmfilesdirec =  "files/"

#directory in odm-directory-structure containing entities 
#odmentitydirec =  "logical/entity/"

#directory in odm-directory-structure containing relations
#odmrelationdirec =  "logical/relation/"

#directory in odm-directory-structure containing arcs
#odmarcdirec =  "logical/arc/"

#directory in odm-directory-structure containing subvies
#odmentisubviewdirec = "logical/subviews/"

#default file extension for user defined property files
#odmudpfileextension = ".udposdm"
########################################

[DB]
#default language of model in DB
#dbdefaultlang = "de"

