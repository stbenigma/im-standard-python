<?xml version="1.0" encoding="UTF-8" ?>
<udp_library>
	<udp_groups>
		<group name="zoomlevel" id="9349CE74-2F47-B9E5-A332-69E5AF2255FF" />
	</udp_groups>
	<properties>
		<property name="minzoomlevel" dispalay_name="Minimal Zoom Level" type="List" group_id="9349CE74-2F47-B9E5-A332-69E5AF2255FF" default_value="0">
		<description>
			<![CDATA[Minimum zoom level  (closest to reality) in which element is displayed]]>
		</description>
			<objects>
				<object class="oracle.dbtools.crest.model.design.logical.Attribute" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Entity" visible="true" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Relation" visible="false" color="-1"/>
			</objects>
			<list_of_values>
				<item value="0" default="true"/>
				<item value="1" default="false"/>
				<item value="2" default="false"/>
				<item value="3" default="false"/>
				<item value="4" default="false"/>
			</list_of_values>
		</property>
		<property name="maxzoomlevel" dispalay_name="Maximum Zoom Level" type="List" group_id="9349CE74-2F47-B9E5-A332-69E5AF2255FF" default_value="4">
		<description>
			<![CDATA[Maximum zoom level (Overvie, Entry-Point) in which element is displayed]]>
		</description>
			<objects>
				<object class="oracle.dbtools.crest.model.design.logical.Attribute" visible="false" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Entity" visible="true" color="-1"/>
				<object class="oracle.dbtools.crest.model.design.logical.Relation" visible="false" color="-1"/>
			</objects>
			<list_of_values>
				<item value="0" default="false"/>
				<item value="1" default="false"/>
				<item value="2" default="false"/>
				<item value="3" default="false"/>
				<item value="4" default="true"/>
			</list_of_values>
		</property>
		<property name="isdescriptive" dispalay_name="Descriptive Attribute" type="List" group_id="" default_value="FALSE">
		<description>
			<![CDATA[TRUE -&amp;amp;gt; Attribute helps to understand Entity
FALSE -&amp;amp;gt; Attribute is not important for understanding]]>
		</description>
			<objects>
				<object class="oracle.dbtools.crest.model.design.logical.Attribute" visible="false" color="-1"/>
			</objects>
			<list_of_values>
				<item value="TRUE" default="false"/>
				<item value="FALSE" default="true"/>
			</list_of_values>
		</property>
	</properties>
</udp_library>