<userDefinedSQL><![CDATA[SELECT
    transportauftrag.lieferdatum,
    transportauftrag.etikettenlink,
    transportauftrag.exportdokumentenlink,
    transporteur.name,
    "Postalische Adresse".strasse   AS abhol_str,
    "Postalische Adresse".ort       AS abhol_ort,
    "Postalische Adresse".plz       AS abhol_plz,
    kunde.name                      AS kundenname,
    "Postalische Adresse".strasse   AS liefer_str,
    "Postalische Adresse".ort       AS liefer_ort,
    "Postalische Adresse".plz       AS liefer_plz,
    artikel.ean
FROM
    "Postalische Adresse",
    transportauftrag,
    transporteur,
    artikel,
    "Sendung / Lieferung?",
    kunde]]></userDefinedSQL>
