#directory containing versioned model
#odmvcsdirec = "gitHub/"

#default directory for odm-model—file (below odmIMDirec)
#odmimdefaultdirec = "IM/"

#default extension of odm-model-base file
#odmimextension = ".dmd"

#directory containing odm-configuration-files (below odmIMDirec)
odmkonfdirec = "configuration/"

#name of user defined property-File containing translations udp"s
#odmudptranslfilename = "translation"

#name of user defined property-File containing data mapping udp"s
#odmudpmappingfilename = "datamapping"

######################
#FROM HERE ON: DO NEVER CHANGE UNLESS ODM-Structures changes
