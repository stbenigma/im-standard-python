<TableView class="oracle.dbtools.crest.model.design.relational.TableView" directorySegmentName="seg_0" id="7E928F9F-8695-0A2A-A232-2DF519FBC930" name="WERTEBEREICH_TEXT">
<createdBy>stb</createdBy>
<createdTime>2020-02-03 20:18:17 UTC</createdTime>
<ownerDesignName>ModellModell_neu</ownerDesignName>
<ordsAlias>view_1</ordsAlias>
<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT
    wertebereich.wrtb_id,
    wertebereich.wrtb_business_rule,
    uetx_name.uetx_originaltext as WRTB_NANE,
    wertebereich.wrtb_uetx_id_name,
    uetx_beschr.uetx_originaltext as WRTB_BESCHR,
    wertebereich.wrtb_uetx_id_beschr,
    wertebereich.wrtb_text_maxlng,
    wertebereich.werb_text_syntaxregel
FROM
    wertebereich
    LEFT JOIN uebersetz_text uetx_name ON uetx_name.uetx_id = wertebereich.wrtb_uetx_id_name                              
    left JOIN uebersetz_text uetx_beschr ON uetx_beschr.uetx_id = wertebereich.wrtb_uetx_id_beschr 
WHERE wrtb_typ = 'TEXT'
             
 ]]></userDefinedSQL>
