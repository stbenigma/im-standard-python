<ordsAlias>view_1</ordsAlias>
<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT
    wertebereich.wrtb_id,
    wertebereich.wrtb_business_rule,
    uetx_name.uetx_originaltext as WRTB_NAME,
    wertebereich.wrtb_uetx_id_name,
    uetx_beschr.uetx_originaltext as WRTB_BESCHR,
    wertebereich.wrtb_uetx_id_beschr,
    wertebereich.wrtb_zpkt_maxwert,
    wertebereich.wrtb_zpkt_minwert,
    wertebereich.wrtb_zpkt_granularitaet
FROM
    wertebereich
    LEFT JOIN uebersetz_text uetx_name ON uetx_name.uetx_id = wertebereich.wrtb_uetx_id_name                              
    left JOIN uebersetz_text uetx_beschr ON uetx_beschr.uetx_id = wertebereich.wrtb_uetx_id_beschr 
WHERE wrtb_typ = 'ZPKT']]></userDefinedSQL>
