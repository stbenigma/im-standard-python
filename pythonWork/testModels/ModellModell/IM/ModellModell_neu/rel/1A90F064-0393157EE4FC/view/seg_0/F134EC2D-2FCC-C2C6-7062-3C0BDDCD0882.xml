<TableView class="oracle.dbtools.crest.model.design.relational.TableView" directorySegmentName="seg_0" id="F134EC2D-2FCC-C2C6-7062-3C0BDDCD0882" name="WERTEBEREICH_ZPKT">
<createdBy>stb</createdBy>
