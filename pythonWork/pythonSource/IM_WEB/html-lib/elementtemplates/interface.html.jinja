{# expected parameters:
	timestamp
	metainfo
	tables
	columns
	domains
	diagram
	#}
{% set company =  "foryouandyourcustomers"  %} {# metainfo.company #}
{% set modelname = metainfo.modelname  %}
{% set interfacename = metainfo.interfacename  %}
{% set title = metainfo.interfacename  %}
{% set logofilename = "logo.jpg" %}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{ title }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="image/imicon.png">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="css/main.css">
    <script src="js/IM.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<body>
	<div class="header" id="TopBar">
		<p4>{{ company }}</p4>
		<p4>{{ title }}</p4>
		<p5>{{ timestamp }}</p5>
		<img src="image/{{ logofilename }}" alt="{{ company }}" id="LLogo">
	</div>
	<button id="btnF" type="button" class="btn btn-info" data-toggle="modal" data-target="#MobileSearch">
		<img class="icon-filter" alt="filter" src="icons/search.svg">
	</button>
	<div class="container" id="sidebar">
		<div id="toc_list">
			<div class="form-wrapper">
				<form autocomplete="off">
					<div class="form-group">
						<label class="form-label" for="first">search key</label>
						<input id="first" class="form-input" type="text" onkeyup="$d_Find('toc_list',this.value,'a')" />
						<img id="searchclear" class="icon-times" src="icons/cross.svg">
						<img class="icon-search" alt="minus" src="icons/search.svg" id="searcher">
					</div>
				</form>
			</div>
			<p6>Hits:</p6>
			<output id="count"></output>
			<div class="contentView">
				<div class="panel-body" id="TablesL">
					<div class="panel">
						<div class="panel-heading collapsed" data-toggle="collapse" data-target="#bartabl">
							<label class="label0">Tables</label>
							<img class="icon-minus" alt="minus" src="icons/minus.svg">
							<img class="icon-plus" alt="plus" src="icons/plus.svg">
						</div>
					</div>
					<!-- The inside div eliminates the 'jumping' animation. -->
					<div class="collapse" id="bartabl">
						<ol class="tree" id="TablesList">
							{% for tab in tables %} 
							<li class="obj"><a href="#{{ tab[0] }}" target="_self">{{ tab[1] }}</a></li>
							{% endfor %}
						</ol>
					</div>
				</div>
				<div class="panel-body" id="ColumnsL">	
					<div class="panel">
						<div class="panel-heading collapsed" data-toggle="collapse" data-target="#barcolu">
							<label class="label0">Columns</label>
							<img class="icon-minus" alt="minus" src="icons/minus.svg">
							<img class="icon-plus" alt="plus" src="icons/plus.svg">
						</div>
					</div>
					<!-- The inside div eliminates the 'jumping' animation. -->
					<div class="collapse" id="barcolu">
						<ol class="tree" id="ColumnsList">
							{% for col in columns %}
							{% set tablid = getelem(col[0])["table-id"] %}
							{% set tabl = getelem(tablid) %}
							<li class="obj"><a href="#{{ col[0] }}" target="_self">{{ col[1] ~ " (" ~ tabl["name"] ~ ")" }}</a></li> {# ["table-id"] #}
							{% endfor %}
						</ol>
					</div>
				</div>

				{% if domains|count > 0 %}
				<div class="panel-body" id="DomainsL">	
					<div class="panel">
						<div class="panel-heading collapsed" data-toggle="collapse" data-target="#bardoma">
							<label class="label0">Domains</label>
							<img class="icon-minus" alt="minus" src="icons/minus.svg">
							<img class="icon-plus" alt="plus" src="icons/plus.svg">
						</div>
					</div>
					<!-- The inside div eliminates the 'jumping' animation. -->
					<div class="collapse" id="bardoma">
						<ol class="tree" id="DomainList">
							{% for dom in domains %}
							<li class="obj"><a href="#{{ dom[0] }}" target="_self">{{ dom[1] }}</a></li>
							{% endfor %}
						</ol>
					</div>
				</div>
				{% endif %}
				
				{% if diagram|count > 0 %}
				<div class="panel-body" id="ColumnsL">	
					<label class="label0">Diagram</label><br>
					<a href="#{{ diagram.id }}" target="_self">{{ title }}</a>
					{% endif %}
				</div>
			</div>
		</div>
	</div>

	<div class="wrapper">
        <div class="top-container">
            <p3 class="descr">This website contains the complete content 
			of the <p2 class="IM">{{ modelname }} - {{ interfacename }}</p2> from {{ company }}. 
            This page was created with software from <p2 class="fyayc">foryouandyourcustomers</p2>. 
            </p3>
            <br>References in brackets are indirect references:<br>
                 (Table reference) for tables: Indirect linking of a table via an entity to a table in another interface<br>
                 (Column reference): Indirect linking of a column via an attribute to a column  in another interface
                  
		</div>
		<br><hr>
		{% if diagram|count > 0 %}
		<div id="{{ diagram.id }}-container">
			<h3 id="{{ diagram.id }}">{{ interfacename }}</h3>
		{{ diagram.svg }}
			<div class="print-button-container">
				<button class="print-button" onclick="printElem(this)">print</button>
			</div>
		</div>
		{% endif %}
		
		{% for tabl in tables %}
		{% set tablid = tabl[0] %}
		{% set elem = getelem (tablid) %}
		<!--tables-->       
		<div class="entity" id="{{ tablid }}">
			<div class="describtion">
				 <span>
						<p>{{ gettext('Table') }}</p>
						<h1>{{ elem["name"] }}</h1>
						<p1>{{ elem["descr"] }}</p1>
				</span>
			</div>
			<div class="panel-body">
				<div class="collapse" id="{{ tablid }}main">
					<h2>Informationen</h2>
					<div class="table-responsive">
						<table class="table borderless">
							<tbody>
								<tr>
									<th>Dev. Status</th>
									<th>updated</th>
								</tr>
								<tr>
									<td class="attribute">{{ elem["devstatus"] }}</td>
									<td class="attribute">{{ "{}, {}".format(elem["uc"],elem["dc"]) }}</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div class="panel">
				<div class="panel-heading collapsed" data-toggle="collapse"  data-target="#{{ tablid }}colu">
					<img class="icon-chevron-up" alt="minus" src="icons/chevron-up.svg">
					<img class="icon-chevron-down" alt="plus" src="icons/chevron-down.svg">
					<label class="label1"><h3>Columns</h3></label>				
				</div>
			</div>
			<div class="collapse" id="{{ tablid }}colu">
				<div class="table-responsive">
					<table class="table borderless" >
						<tbody>
							<tr>
								<th>Name</th>
								<th>Description</th>
								<th>Domain</th>
								<th>Datatype</th>
							</tr>
							{% for colid in elem["columns+"] %}
							{% set colu = getelem(colid) %}
							{% set domaid = colu["domain"] %}
							{% set doma = getelem(doamid) %}
							<tr>
								<td><a href="#{{ colid }}" target="_self">{{ colu["name"] }}</a></td>
								<td>{{ getnvl(colu["descr"]) }}</td>
								<td> {% if doma["origin"]== 'DER' %}
									{{ getlangname(doma["name"]) }}
									{% else %}
									{{ getelemlink(domaid,getlangname(doma["name"]),doma["interfaceid"]) }}
									{% endif %}
								</td>
								<td>{{ colu["datatype"] }}</td>
							</tr>
							{% endfor %}
						</tbody>
					</table>
				</div> 
			</div>
			<div class="panel">
				<div class="panel-heading collapsed" data-toggle="collapse"  data-target="#{{ tablid }}map">
					<img class="icon-chevron-up" alt="minus" src="icons/chevron-up.svg">
					<img class="icon-chevron-down" alt="plus" src="icons/chevron-down.svg">
					<label class="label1"><h3>Mappings</h3></label>				
				</div>
			</div>
			{% set tablref = getreflist (tablid) %}
			{% if tablref|count > 0 %}
			<div class="collapse" id="{{ tablid }}map">
				<div class="table-responsive">
					<table class="table borderless" >
						<tbody>
							<tr>
								<th>Model</th>
								<th>Entity(ies) / Table(s)</th>
							</tr>
							{% for key,val in tablref.items() %}
							<tr>
								<td>{{ key }}</td>
								<td>{{ val }}</td>
							</tr>
							{% endfor %}
						</tbody>
					</table>
				</div> 
			</div>
			{% endif %}
			<div class="panel">
				<div class="panel-heading collapsed" data-toggle="collapse" data-target="#{{ tablid }}main">
					<img class="icon-chevron-up" alt="minus" src="icons/chevron-up.svg">
					<img class="icon-chevron-down" alt="plus" src="icons/chevron-down.svg">
					<label class="label1">more</label>
				</div>
			</div>
		</div>
		{% endfor %}


