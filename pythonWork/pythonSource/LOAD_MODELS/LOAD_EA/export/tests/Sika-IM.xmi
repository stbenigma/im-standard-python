      <element xmi:idref="EAID_ENTI164_20_6A7A_43ED_A410_6BC6F1D8916D" xmi:type="uml:Class" name="Sika Sicherheitsdatenblatt" scope="public">
        <model package="EAPK_CFEE6068_3D8A_43B0_8B8C_B06E8B32EB10" tpos="0" ea_localid="68" ea_eleType="element"/>
        <project author="bue" created="2021-12-07 13:55:11" keywords="ENTI164" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Datenblatt, in dem alle sicherheitsrelvanten Angaben, Restriktionen, Anwendungsprozeduren etc. stehen f&#252;r eine sichere Anwendung.&#10;&#10;Alle chemischen Produkte brauchen ein Sicherheitsdatenblatt (SDS).&#10;Artikel die keine chemische Produkte sind (Folien, Baffles, ...) brauchen kein SDS.&#10;&#10;In Kapitel 1 des SDS steht die Adresse der Produktion (Inverkehrbringer).&#10;Mehrere SDS bei mehreren Produktionsst&#228;tten (Stuttgart, Leimen, ...) aber nur einen Inverkehrbringer (Sika DE)?" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={f779417d-28f6-4ada-a4e8-45fd68a81bab}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={1a295285-843e-4b58-bced-9d4359ee5eb4}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={9c36d5cd-822d-4ea8-bd5c-3fce66b89362}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={1a295285-843e-4b58-bced-9d4359ee5eb4}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI165_02_C722_48B7_907B_9CDF0A6557F5" xmi:type="uml:Class" name="Sika-Artikel" scope="public">
        <model package="EAPK_CFEE6068_3D8A_43B0_8B8C_B06E8B32EB10" tpos="0" ea_localid="69" ea_eleType="element"/>
        <project author="stb" created="2021-12-01 09:56:42" keywords="ENTI165" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein Artikel der verkauft wird, muss immer als Verkaufsartikel mit einer Verkaufsmenge angelegt werden (auch wenn die Verkaufsmenge ausschliesslich 1 ist).&#10;&#10;In SAP haben diese Verkaufsartikel einen SAP-Code.&#10;Den Artikel (= Unit) die sie referenzieren sind in SAP als zus&#228;tzliche EAN gef&#252;hrt.&#10;&#10;Fl&#228;schchen in einem Karton ('Aufrisskarton') k&#246;nnen einzeln verkauft werden.&#10;Die 'Liefermengeneinheit' definiert, ob der Inhalt des Kartons einzeln verkauft werden darf." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={b43693b9-075c-480d-9288-8016825a668b}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={34156933-e859-45f0-be87-bcade23f73fd}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={1af80b56-f700-4ba1-9feb-0b788c125f05}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={34156933-e859-45f0-be87-bcade23f73fd}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
