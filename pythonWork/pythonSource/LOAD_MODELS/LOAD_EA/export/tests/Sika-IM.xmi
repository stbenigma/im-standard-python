        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Materialien in einer festen Form.&#10;&#10;Nach der REACH-Verordnung (European Chemicals Agency) ist ein Erzeugnis ein &#8222;Gegenstand, der bei der Herstellung eine spezifische Form, Oberfl&#228;che oder Gestalt erh&#228;lt, die in gr&#246;&#223;erem Ma&#223;e als die chemische Zusammensetzung seine Funktion bestimmt&quot;. &#10;Gem&#228;&#223; REACH sind Erzeugnisse beispielsweise Bekleidung, Fu&#223;b&#246;den, M&#246;bel, Schmuck, Zeitungen und Kunststoffverpackungen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
