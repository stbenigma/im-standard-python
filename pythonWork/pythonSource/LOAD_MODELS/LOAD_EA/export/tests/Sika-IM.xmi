        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Bestandteil, Baustein, aus dem Produkte und dann Artikel zusammengesetzt werden.&#10;Typischerweise aus Rohmaterial produziert, reagiert, kombiniert.&#10;&#10;Komponenten in FR und USA m&#252;ssen ein Sicherheitsdatenblatt haben, &#10;in DE ist es nicht gesetzlich vorschrieben. Kein Sicherheitsdatenblatt bedeutet &quot;sicher&quot;." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
