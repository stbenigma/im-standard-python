        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Sekund&#228;rverpackungen verpacken einen Artikel (oder mehrere) um sie im Verkauf und in der Logstik einfacher zu verwenden.&#10;Tyischerweise dekoriert oder beschriftet &#10;&#10;Fl&#228;schchen in einem Karton ('Aufrisskarton') k&#246;nnen einzeln verkauft werden.&#10;Die Liefermengeneinheit definiert, ob der Inhalt des Kartons einzeln verkauft werden darf." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
