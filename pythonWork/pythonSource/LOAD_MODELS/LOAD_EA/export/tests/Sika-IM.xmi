      <element xmi:idref="EAID_ENTI172_EA_9A70_401F_B738_DF74EE357A38" xmi:type="uml:Class" name="Verbraucher Artikel" scope="public">
        <model package="EAPK_CFEE6068_3D8A_43B0_8B8C_B06E8B32EB10" tpos="0" ea_localid="76" ea_eleType="element"/>
        <project author="stb" created="2021-11-02 12:36:31" keywords="ENTI172" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Etwas was Sika als verkaufbare Artikel in bestimmten vordefinierten Mengen anbieten und verkaufen kann.&#10;Ein Artikel kann erst verkauft werden, wenn er als Verkaufbarer Artikel existiert. D.h. jeder Artikel der verkauft wird muss als verkaufbarer Artikel existieren. Auch wenn der Artikel immer nur als 1 St&#252;ck verkauft wird.&#10;&#10;Artikel haben eine EAN-Nr (falls es in einem Land mit EAN-Nr angeboten wird), obwohl sie als einzelne Elemente (z.B. eine Kartouche) nie verkauft werden.&#10;Hat entweder eine EAN (Europ&#228;ische  Artikel Nummer) oder eine UPC (Universal Product Code), welche als GTIN (global trade item number) verwendet wird&#10;&#10;Es gibt Artikel, die keinem bestimmen Produkt zugeordnet sind. Sie erhalten heue  &#8220;Others&#8221;   als Proudkt (999)&#10;Artikel sind Produkte die ggf. zusammen mit Verpackung aus einem Produkt abgeleitet werden.&#10;&#10;Im Fall von Mehrkomponenten Produkte die Artikel k&#246;nnen einzelne Komponenten oder die gemeinsamen Komponenten sein.&#10;&#10;Verkaufseinheit kann sein St&#252;ck, m, lt, m^2, m^3, kg&#10;&#10;Einige Artikel m&#252;ssen eine prim&#228;re Verpackung haben (Fass, Kartouche), da sie sonst nicht verkauft werden k&#246;nnen.&#10;Es gibt Artikel, die per liter oder kg verkauft werden, f&#252;r die es keine Prim&#228;rverpackung braucht, da diese beim Transport (z.B: Lieferung oder Abholung in Tanklastwagen) zum tragen kommt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={9ff9e15b-46ad-4cb1-81a9-7a29dd4387cb}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={5206a0bd-b8fb-4ef8-a8db-56a4e39b257c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={a5231e42-a3cd-4009-9ae5-aef376bcba1f}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={5206a0bd-b8fb-4ef8-a8db-56a4e39b257c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR369_76_5C0F_4FC0_A0BA_4A975A773965" name="Nr"/>
          <attribute xmi:idref="EAID_ATTR370_64_DCEC_4C0B_9EB3_9033B3539F1F" name="Bezeichnung"/>
          <attribute xmi:idref="EAID_ATTR371_04_4B75_47F2_BBFF_BC1757791747" name="GTIN (EAN/UPC)"/>
