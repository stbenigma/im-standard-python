      <element xmi:idref="EAID_ENTI319_F5_3A80_49F8_83A5_DD3EAC6D71BA" xmi:type="uml:Class" name="Massnahme LDG " scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="92" ea_eleType="element"/>
        <project author="stb" created="2018-08-29 12:40:28" modified="2022-06-15 18:13:47" keywords="ENTI319" status="Proposed"/>
