        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Flags (J/N) um Tarifnummer oder Sonderausscheidungen zu markieren.&#10;&#10;Aus dem Modell GSD &#252;bernommene.&#10;Diejenigen, die Tabellen waren m&#252;ssen f&#252;r die Umsysteme weiterhin als Tabellen zur Verf&#252;gung gestellt werden.&#10;&#10;Zollcode (ZOLLCODE)&#10;   Agrar-Zoll&#10;   Industrie-Zoll&#10;&#10; Tarifgruppe (TARIFGRP, TN8_TGR) nur intern verwendet&#10;  bt&#10;&#10; Kennzeichen&#10;   Bio-Treibstoff&#10; &#10; Felder aus TN8&#10;   FLSC Liechtenstein...&#10;   TOT1 und TOT2 &#10;   BMCI IMP&#10;   BMCI EXP" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
