      <element xmi:idref="EAID_ENTI275_EE_DC47_4AD3_8E09_991C40245A57" xmi:type="uml:Class" name="Warenbezogener Bewilligungstyp" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="167" ea_eleType="element"/>
        <project author="stb" created="2018-09-10 07:35:29" keywords="ENTI275" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Typ von Bewilligungspflicht die f&#252;r Firmen / Personen ausgestellt wird f&#252;r die Einfuhr oder Ausfuhr von G&#252;tern.&#10;Die eigentlichen Bewilligungen die den Firmen zugeteilt sind werden nicht in den Stammdaten verwaltet!&#10;&#10;Bewilligungen mit Nachweispflicht erfordern bei der Deklaration die Angabe eine Zertifikat- / (e-)Bewilligungs-Nr.&#10;Bewilligungen ohne Nachweispflicht erfordern bei der Deklaration nur die Angabe, dass eine Bewilligung vorliegt.&#10;&#10;Generaleinfuhrbewilligungen (GEB) wie sie heute gepflegt werden. Sind eine Form von Verbringungsbewilligungen, die an Firmen erteilt werden.&#10;Die Nummernbereiche der GEB sind mit einer neuen L&#246;sung nicht mehr notwendig. Sie werden noch gef&#252;hrt f&#252;r die Zeit der Migration, w&#228;hrend der eine R&#252;ckw&#228;rtskompatibilit&#228;t notwendig ist.&#10;Beispiele: (???mit Reserve-Suisse &#171;rs&#187; abkl&#228;ren???):&#10;  Speis&#246;le und -fette 100'001 - 120'000&#10;   Reis zu Speisezwecken 120'001 - 140'000&#10;   Zucker 140'001 - 160'000&#10;&#10;Aus den Bewilligungen mit der selben Pflichtgruppen-Nr  muss eine zwingend ausgew&#228;hlt werden, falls die Gruppenpflicht besteht.&#10;&#10;Meeting mit Mich Biger (18.2.19):&#10;Die Revers f&#252;r Tabakimport/-export und -produktion k&#246;nnten evtl. als Bewilligungen gef&#252;hrt werden. Damit braucht es auf den Tarifnummern / Steuerelementen eine NZE vom Typ Verbringungsbewilligung. Das w&#252;rde edec erlauben die Reversnummern bei der Deklaration direkt mit dem Register bei der Tabakabteilung zu pr&#252;fen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={357d0d63-4f52-4f99-82c9-e94fcacfdb8b}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d40265d6-ba39-40f3-8dbc-a1f5bf392e79}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={cc9f80e1-4e96-40f2-a780-62ee1189f174}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d40265d6-ba39-40f3-8dbc-a1f5bf392e79}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR622_49_A456_4D21_97F7_D3B17A197E66" name="Nachweispflicht (J/N)"/>
          <attribute xmi:idref="EAID_ATTR623_A9_F2B9_4FC5_AA7E_885DCB79104E" name="GEB-Minimalnr"/>
          <attribute xmi:idref="EAID_ATTR624_32_946A_4996_8D0F_EE98723DCE3C" name="GEB-Maximalnr"/>
          <attribute xmi:idref="EAID_ATTR625_D5_13A1_44AF_99FC_909C2D2953AB" name="Generalklausel (J/N)"/>
        </attributes>
      </element>
