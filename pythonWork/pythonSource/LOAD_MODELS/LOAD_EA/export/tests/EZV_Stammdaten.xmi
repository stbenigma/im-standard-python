      <element xmi:idref="EAID_ENTI241_15_D571_45F8_8C25_EA29E3718141" xmi:type="uml:Class" name="Steuerelement Zweck" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="133" ea_eleType="element"/>
        <project author="stb" created="2019-01-15 15:08:21" keywords="ENTI241" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zweck f&#252;r den ein Steuerelement definiert wurde.&#10;Damit  kann &#252;berwacht (ausgewertet) werden, wozu die verschiedenen Steuerelemente genutzt werden.&#10;Weiter k&#246;nnen daraus Regeln abgeleitet werden, welche Details zu den Steuerelementen erfasst werden m&#252;ssen.&#10;&#10;Ein Steuerelement f&#252;r den Zweck &quot;Bewilligung&quot; muss eine Bewilligung angeh&#228;ngt haben. (Oder zumindest eines der Steuerelemente der selben TN8 muss eine Bewilligung haben)&#10;&#10;An die Verkn&#252;pfung k&#246;nnten weitere Regeln angeh&#228;ngt werden wie z.B.&#10;-Sichtbarkeit der Details in Tares, externen Systemen&#10;-Nutzung f&#252;r Steuerungen und Regeln in edec oder &#228;hnlich&#10;-L&#228;nderabh&#228;ngigkeit der Details eines Steuerungselementes.&#10;&#10;Wird vorerst nicht umgesetzt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={c828ebb2-66fa-44d9-92fe-1aa93bcb253d}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d6d4e924-cef5-44ec-aa54-51667175a1ef}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={ec1d904c-3e23-43e2-8f3c-c6cc9b4e6e38}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d6d4e924-cef5-44ec-aa54-51667175a1ef}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
