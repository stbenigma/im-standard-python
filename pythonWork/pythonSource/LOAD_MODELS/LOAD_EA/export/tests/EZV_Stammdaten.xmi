      <element xmi:idref="EAID_ENTI299_35_7902_4C9A_BAC0_2C770B5FE43F" xmi:type="uml:Class" name="Anwendbarer Ansatz" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="9" ea_eleType="element"/>
        <project author="stb" created="2018-11-01 12:17:17" modified="2022-06-15 18:13:47" keywords="ENTI299" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Normalans&#228;tze (NT) werden verrechnet, wenn keine Abkommen oder besonderen Beg&#252;nstigungen vorliegen.&#10;Es kann mehr als einen Normalansatz geben. Dann m&#252;ssen sie durch einen Erl&#228;uterungstext unterscheidbar sein (und einer Lfd. Nr).&#10;Beispiel 0406.9051 Halbhartk&#228;se Normal Lfd. Nr. 1: 383.00 Fr. je 100 kg brutto / Normal Lfd. Nr. 2: 50.00 Fr. je 100 kg brutto: innerhalb des besonderen Zollkontingentes (&quot;Fontalkontingent&quot;) eingef&#252;hrt;  &#10;&#10;Der Normalansatz muss immer billiger sein als der Ansatz des Generaltarifs (GT) (bei gleicher Bemessungsgrundlage). Wenn gleiche Bemessungsgrundlage (z. B. 100 kg brutto) dann darf der NT nicht h&#246;her als der GT sein. Er darf aber auch gleich hoch sein (Beispiel 01012190: GT und NT 3834.00 Fr. je 100 kg brutto). Es k&#246;nnte vorkommen, dass der EU-Ansatz (da Bemessungsgrundlage je 100 kg Eigenmasse) h&#246;her ist als der GT.&#10;&#10;Der Tarestext wird verwendet als Bemessungsgrundlage in der Anzeige neben dem Ansatzwert.&#10;Er setzt sich zusammen aus &#10;- Faktor des Ansatzes (leer oder 100)&#10;- Tarestext (Wiederholung - Tarestext setzt sich zusammen aus Tarestext? siehe oben, was ist hier gemeint?)  der Bemessungsgrundlage (Einheit + ggf. Messmethode, Stellenanzahl) Kann man dies erkl&#228;ren (Einheit ist aktuell z.B. Fr., dies ist ja gem&#228;ss Aussage von Dir nicht der Fall, neu heisst dies Verrechnungseinheit)?&#10;- brutto / Eigenmasse je nach Deklarationsfeld (Rohmasse/Eigenmasse) in der Deklarationsvorschrift  (Deklarationsvorschrift sollte erkl&#228;rt werden)&#10;Beispiele f&#252;r Tarestext bei Zollansatz:&#10;je 100 kg brutto (Normalfall); je Meter (Tarifnr. 3706.1010); je St&#252;ck (Tarifnr. 0101.2110); je 100 kg Eigenmasse (Tarifnr.1704.1010); je MWh (Tarifnr. 2716.0000)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={f28b7dff-dc49-4b88-b5ed-e40ec0c4c301}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={c09a0699-f5af-4bc6-9e30-c2ca005ee077}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={15757a14-6f23-49cc-a3b9-50fbd3144daa}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={c09a0699-f5af-4bc6-9e30-c2ca005ee077}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR847_6B_AE7F_4C18_B59F_F03E54BEC26A" name="LaufNr"/>
          <attribute xmi:idref="EAID_ATTR848_08_8D20_4EFB_93BE_9D0FDE373F72" name="Tares-Text"/>
        </attributes>
      </element>
