      <element xmi:idref="EAID_ENTI316_5E_A534_4D31_BC36_F8BDB7B7CC6A" xmi:type="uml:Class" name="LDG nicht Tarif" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="77" ea_eleType="element"/>
        <project author="stb" created="2018-08-29 13:27:04" modified="2022-06-15 18:13:47" keywords="ENTI316" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="L&#228;ndergruppen f&#252;r Statistik, Fracht und Massnahmen k&#246;nnen in mehreren Hierarchien organisiert sein.&#10;Bisher hiessen diese Hierarchien L&#228;ndergruppengliederungen.&#10;Die L&#228;ndergruppen werden via L&#228;ndergruppe-L&#228;ndergruppe miteinander verkn&#252;pft.&#10;&#10;F&#252;r nicht Tarif-L&#228;ndergruppen, d&#252;rfen L&#228;nder nur an die unterteste Hierarchiestufe (Bl&#228;tter) angeh&#228;ngt werden.&#10;&#10;Neu ist die alte L&#228;ndergruppengliederung  (aus GSD) die Wurzel der Hierarchie, d.h. die oberste Gruppe, die selber an niemandem h&#228;ngt.&#10;=&gt; nein. Die Wurzel der Hierarchie wird durch die L&#228;ndergruppengliedrung gebildet. Daran h&#228;ngen dann die L&#228;ndergruppen der 1. Stufe&#10;&#10;L&#228;ndergruppen d&#252;rfen nur zu Hierarchien verkn&#252;pft werden, die alle die gleich Benutzerart (Fracht, Statistik, Massnahme) haben.&#10;&#10;Eine L&#228;ndergruppe kann in mehreren Hierarchien (der selben Benutzerart) verwendet werden. Bespiel Euro-Zone mit seinen L&#228;ndern kann in mehreren Hierarchien genutzt werden. Die Gruppe wird nur 1x gepflegt aber mehrfach angeh&#228;ngt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={71a10f27-0d51-4812-8f19-c6fe590f1a40}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={9e7cf193-91b7-4924-84cf-0b399c215a7a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={78fcd7e5-edaa-4068-895d-ab74a3036d58}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={9e7cf193-91b7-4924-84cf-0b399c215a7a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI317_33_FD61_4BBE_B816_C7686F921EB8" xmi:type="uml:Class" name="LSVA-Abfertigungsterminal" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="78" ea_eleType="element"/>
        <project author="stb" created="2020-01-21 15:12:23" modified="2022-06-15 18:13:47" keywords="ENTI317" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ger&#228;t an dem LSVA-Gesch&#228;fte get&#228;tigt werden k&#246;nnen&#10;&#10;Ein LSVA Abfertigungsterminal dient zum Deklarieren und Ausgeben von LSVA Belegen f&#252;r ausl&#228;ndische Fahrzeuge ohne Erfassungsger&#228;t.&#10;AT Classic: Die HW Komponenten sind in einem gemeinsamen Geh&#228;use untergebracht.&#10;AT Rapid: Wird bei Arbeitspl&#228;tzen in Hochkabinen installiert. Die HW Komponenten sind untergebracht im Handger&#228;t und im Basisgeh&#228;use. Zur Bedienung des Handger&#228;tes muss der Fahrer nicht aus dem Fahrzeug aussteigen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2a9f20aa-2dcc-4f9f-bf6f-f6b1c49dd8ae}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={73020d9f-6bdf-4bfc-bfa4-ee192dd2d25f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={1f615c3b-db11-42d3-8f1f-e4a56fd53d06}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={73020d9f-6bdf-4bfc-bfa4-ee192dd2d25f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
