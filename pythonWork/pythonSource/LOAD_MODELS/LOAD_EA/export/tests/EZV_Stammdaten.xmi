      <element xmi:idref="EAID_ENTI189_61_A485_478B_BB7B_D24C364BD2BC" xmi:type="uml:Class" name="Land" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="81" ea_eleType="element"/>
        <project author="stb" created="2018-08-22 13:07:16" keywords="ENTI189" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Land gem&#228;ss ISO-Liste.&#10;F&#252;r den Zoll sind auch Regionen L&#228;nder. (z.B. kanarische Inseln (XA) bei den Massnahmen)&#10;Was passiert z.B. wenn Spanien eine Ausnahmereferenz erh&#228;lt?&#10;Haben dann die Kanaren auch eine?&#10;&#10;L&#246;sung GSD:&#10;Falls ein PR-Ansatz f&#252;r ein einzelnes Land definiert ist, wird dieses Land als L&#228;ndergruppe definiert. Damit ist der Ansatz immer mit einer LDGRP verkn&#252;pft.&#10;Verkn&#252;pfungen von NZE mit L&#228;ndern geht &#252;ber L&#228;ndergruppen (d.h. ein einzelnes Land wird zur L&#228;ndergruppe, analog Ansatz)&#10;&#10;&#10;Ein Land ist ein Staat oder ein Teilgebiet, welches aus Zollsicht betrachtet wird, u.a. f&#252;r die Aussenhandelsstatistik.&#10;Aspekte: Export-, Import-, Transitland (nach EUROSTAT, TAXUD), Sicherheitseinstufung f&#252;r ein Land" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={ad651f3f-523f-4990-adea-587535ff485d}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={05f94994-d2af-4674-934e-b8d6a1d3e1d7}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={b71fb8b6-9eb9-4f03-9342-6c3e89d2e9d4}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={05f94994-d2af-4674-934e-b8d6a1d3e1d7}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR659_0F_4B20_4D92_A945_4ACE7A206A20" name="Bezeichnung"/>
          <attribute xmi:idref="EAID_ATTR660_34_8B85_4676_9834_094761D4A6EA" name="ISO Code"/>
          <attribute xmi:idref="EAID_ATTR661_58_B4E9_48B3_853F_56362E75B30B" name="G&#252;ltigkeitsperiode"/>
