      <element xmi:idref="EAID_ENTI246_7A_66FC_4074_A760_2E1CC1B7AA3B" xmi:type="uml:Class" name="Tabakproduktuntergruppe" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="138" ea_eleType="element"/>
        <project author="stb" created="2018-08-21 09:23:29" keywords="ENTI246" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Siehe Modell TaBi&lt;br/&gt;&lt;br/&gt;Einzelprodukt untergruppen bezeichnen in Tabi die Art der Tabakprodukte (Zigaretten X, Stumpen gross, Zigarillo)&lt;br/&gt;&lt;br/&gt;Meeting mit Mich Bigler (18.2.19):&lt;br/&gt;Es w&#228;re grunds&#228;tzlich m&#246;glich, die Tabakproduktuntergruppen als Steuerungselemente zu f&#252;hren und damit die Unterscheidung f&#252;r Steuern zu machen.&lt;br/&gt;Da die Tabaksteuer als Zusatzabgabe von den Untergruppen abh&#228;ngig ist, k&#246;nnte damit die Tabaksteuer als &quot;normale&quot; Zusatzabgabe (abh&#228;ngig nur vom Steuerungselement) gef&#252;hrt werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={bc30d8b6-9335-4b8c-9c74-6781d6d360e1}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={7e7f8bc1-646a-4063-b101-4f94787f57d9}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={ecb84c62-343e-41f1-a462-dbaead1e1076}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={7e7f8bc1-646a-4063-b101-4f94787f57d9}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
