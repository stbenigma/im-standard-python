        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Normalans&#228;tze werden verrechnet wenn keine Abkommen oder besonderen Beg&#252;nstigungen vorliegen.&#10;Falls ein Land eine Pr&#228;ferenzansatzausnahme (AUSNREF) hat, gilt ebenfalls der Normalansatz.&#10; &#10;Es kann mehr als einen Normalansatz geben. Dann m&#252;ssen sie durch einen Erl&#228;uterungstext (und eine nichtssagende Laufnummer) unterscheidbar sein&#10;&#10;Der Normalansatz soll (umgerechnet auf die gleiche Bemessungsgrundlage) immer billiger oder gleich sein wie der Generaltarifansatz." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
