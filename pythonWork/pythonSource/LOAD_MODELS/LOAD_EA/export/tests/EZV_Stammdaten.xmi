      <element xmi:idref="EAID_ENTI192_89_E70A_4B12_AC45_A2C672AEA2E8" xmi:type="uml:Class" name="Landspezifische NZ-Massnahme" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="84" ea_eleType="element"/>
        <project author="stb" created="2018-09-10 07:24:54" keywords="ENTI192" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zuweisung einer NZM zu L&#228;ndern.&#10;Dabei k&#246;nnen L&#228;ndergruppenzuweisungen gemacht werden und dann einzelne&#10;L&#228;nder davon eingeschlossen (NZM gilt f&#252;r diese L&#228;nder) oder ausgeschlossen werden (NZM nicht f&#252;r diese L&#228;nder anwendbar).&#10;Die normale Zuteilung ist eine Einschluss (ist_ausschluss = N). Normal ist: Einschluss &quot;Alle L&#228;nder&quot;, d.h. alle L&#228;nder unterliegen dem NZE. Falls ein Land oder eine L&#228;ndergruppe nicht dem NZE unterliegt, wird es ausgeschlossen (z.B. Auschluss NZ)&#10;&#10;Beispiele: Tarifnummer 0203.1110, &#10;ZUAC  290 GTU ZUSCHL 002: Einschluss &quot;Alle L&#228;nder&quot;, Ausschluss &quot;andere L&#228;nder ohne GTU&quot; (z.B. wenn Guadeloupe), &quot;EFTA&quot;, &quot;EU&quot; und Neuseeland; &#10;ZUAC 290 ZUSCHL 003: Einschluss Neuseeland (andere Geb&#252;hr die nur f&#252;r dieses Land gilt))&#10;- NZE gilt f&#252;r Entwicklungsl&#228;nder&#10;   gleiche NZE gilt nicht f&#252;r Brasilien (diesen Fall hatten wir bei den NZE noch nie, keine Ahnung, ob das funktionieren w&#252;rde (Aktuell keine L&#228;ndergruppe EL und f&#252;r Brasilien in den L&#228;ndern f&#252;r Massnahmen)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={80b16f97-186f-4cde-94af-0738962dfc87}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={64915525-2ef9-4ae9-8d54-0011662062a8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={c78b6f35-3c83-4d70-a2f6-f44c937f8ef7}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={64915525-2ef9-4ae9-8d54-0011662062a8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
