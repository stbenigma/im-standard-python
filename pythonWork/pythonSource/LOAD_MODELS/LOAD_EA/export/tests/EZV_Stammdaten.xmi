      <element xmi:idref="EAID_ENTI287_45_1DF4_44BF_8EF7_49B958922649" xmi:type="uml:Class" name="Zusatzabgabe" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="179" ea_eleType="element"/>
        <project author="stb" created="2018-09-10 07:02:42" modified="2022-06-15 18:13:47" keywords="ENTI287" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Abgabe, die zus&#228;tzlich zum Zoll erhoben wird.&#10;&#10;Die Mengenangaben aus denen die Zusatzabgaben berechnet werden, werden in den Deklarationen in eigenen Feldern (1 je Zusatzabgabe) erfasst.&#10;Diese Felder sind nicht Bestandteil der Stammdaten.&#10;&#10;Ob (und wie) diese Mengenangaben aus den Deklartionsfeldern (Rohmasse, Eigenmasse, Zusatzmenge) abgeleitet werden kann ist aktuell nicht Bestandteil der Stammdaten. Diese Information w&#252;rde aber M&#246;glichkeiten der Vereinfachung der Deklaration bieten: Zusatzabgabenmengen werden automatisch nachgef&#252;hrt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={7e2fc139-ef7a-4f57-89df-a1ebe7e64470}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={9f35eee2-be4d-4ef4-8eaa-7d8ae6f25029}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={42eaa8e7-3d3b-4ce8-b24d-eb6660a81202}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={9f35eee2-be4d-4ef4-8eaa-7d8ae6f25029}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
