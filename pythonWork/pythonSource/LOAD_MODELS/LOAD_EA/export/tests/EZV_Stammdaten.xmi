      <element xmi:idref="EAID_ENTI123_89_40FD_47F9_AB69_07CC73F342A8" xmi:type="uml:Class" name="Bemessungseinheit" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="15" ea_eleType="element"/>
        <project author="stb" created="2018-09-10 15:08:55" keywords="ENTI123" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zolltechnische (teilweise physikalische) Einheit f&#252;r die Bemessung aller Abgaben und statistischen Angaben. (oder auch bei der Bewilligungspflicht &#8211; Toleranz?)&#10;&#10;Spezielle Einheiten:&#10;-Sendung&#10;  Beispiel CITES Abgabe wird f&#252;r eine Deklaration (Zollanmeldung) erhoben, egal wie viele Positionen CITES auf der Deklaration sind.&#10;-Warenwert (CHF, EUR)&#10;   erfasst in den Eingabefeldern  &#10;   -- Ware mit Zollabgaben (ohne MWST)&#10;   -- Kompletter Wert inkl. MWST" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={dd80860f-36f4-4784-9bcd-5ba57cfc748e}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={5e8ffa0f-bc77-4417-b370-42ef87912769}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={0f24aebe-635f-43f6-893b-871e014ebc26}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={5e8ffa0f-bc77-4417-b370-42ef87912769}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
