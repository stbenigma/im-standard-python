        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Schr&#228;nkt die Anwendbarkeit eines Zollansatzes auf eine oder mehrer Perioden innerhalb des Jahres ein.&#10;Wird vorzugsweise bei der Aushandlung von Zollreduktionen im Bereich Fr&#252;chte und Gem&#252;se angewendet, welche grossen saisonalen Schwankungen unterliegen. Vergleiche auch Beschreibung ANSATZ." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
