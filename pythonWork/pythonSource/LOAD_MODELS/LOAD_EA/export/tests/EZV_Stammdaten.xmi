        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zollberleichterung f&#252;r eine Tarifnummer.&#10;Es wird eine ZE gef&#252;hrt, weil f&#252;r diese TN8 ein Verwendungszweck oder -nachweis beigelegt werden muss.&#10;&#10; Die L&#246;sung mit der virtuellen ZE (Nr 00) ist eine technische L&#246;sung, f&#252;r den Umstand, dass Tarifnummern ohne ZE direkt am Ansatz h&#228;ngen.&#10;&#10;Art. 14 ZG Absatz 1 A" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
