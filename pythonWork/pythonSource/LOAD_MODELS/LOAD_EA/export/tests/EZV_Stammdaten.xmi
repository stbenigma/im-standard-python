        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zuweisung eines Mehrwertsteuersatzes zu einer Tarifnummer/Steuerungselement.&#10;&#10;Ein reduzierter Satz bzw. 0% kann bei gewissen Tarifnummern / Steuerungselementen von Verfahren (Umzug) oder von weiteren Beschreibungen (Verwendung, Art der Ware) abh&#228;ngig sein.&#10;&#10;Es wurde diskutiert die MWST auch an Steuerungselemente anzuh&#228;ngen. Da im Moment aber kein Bedarf besteht, wird es nicht umgesetzt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
