        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="&quot;Einheiten&quot; f&#252;r die Bemessung einer Abgabe.&lt;br/&gt;-physikalische Einheiten.&lt;br/&gt;-Wert (Warenwert von dem Prozente abzugeben sind)&lt;br/&gt;-Volk (Bienen)&lt;br/&gt;&lt;br/&gt;Ehemals Mengencode&lt;br/&gt;&lt;br/&gt;Beispiele:&lt;br/&gt;Kilo&lt;br/&gt;Tonne&lt;br/&gt;MhW&lt;br/&gt;(Bienen-)Volk&lt;br/&gt;Wert&lt;br/&gt;St&#252;ck&lt;br/&gt;Sendung (z.B. Container f&#252;r Bewilligungen)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
