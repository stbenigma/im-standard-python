      <element xmi:idref="EAID_ENTI267_54_4F71_46AC_8821_75CC11E6052F" xmi:type="uml:Class" name="Verteilschl&#252;ssel" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="159" ea_eleType="element"/>
        <project author="stb" created="2018-09-10 07:04:53" keywords="ENTI267" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Verteilschl&#252;ssel bestimmt, welche Anteile des Zoll- und Zollbeg&#252;nstigungsansatzes in welche Kasse des Bundes fliessen.&lt;br/&gt;Im Agrarbereich bestimmt der Verteilschl&#252;ssel den prozentualen Anteil der verschiedenen Zollanteile vom tarifizierten Zollansatz. Die Einnahmen werden anhand dieser prozentualen Anteile in Z&#246;lle und in die zum Teil zweckgebundenen Zollanteile aufgeteilt.&lt;br/&gt;&lt;br/&gt;Bedeutung von &quot;mit Generalbewilligung&quot; ist unklar. ????Muss noch bei Tarif (K. Vonnez) abgekl&#228;rt werden???&lt;br/&gt;&lt;br/&gt;27.6.2019 Wird nicht mehr gebraucht. Seit 2003 sind alle Eintr&#228;ge 100% Zoll. dh. nicht mehr genutzt&lt;br/&gt;" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={eb857861-dd79-4dd8-81b9-b24a3b2c7e3c}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={2c5d67ed-11f9-400b-9ea2-2b2a20599aec}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={7b8fe352-360f-41cd-82f1-495dda8575ca}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={2c5d67ed-11f9-400b-9ea2-2b2a20599aec}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
