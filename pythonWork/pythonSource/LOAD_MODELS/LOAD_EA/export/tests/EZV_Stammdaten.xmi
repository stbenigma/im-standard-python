      <element xmi:idref="EAID_ENTI284_81_873E_4485_90B5_0E7356332CB6" xmi:type="uml:Class" name="Zollerleichterung" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="176" ea_eleType="element"/>
        <project author="stb" created="2018-08-22 12:55:29" keywords="ENTI284" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zollerleichterung (unterscheidung von Ans&#228;tzen) je nach Verwendungszweck (mit Begr&#252;ndung oder Nachweis)&#10;f&#252;hrt zu einer Reduktion des Normalansatzes&#10;&#10;Code war fr&#252;her in einer eigenen Tabelle ZBCODE&#10;mit virtuelle (J/N) und dem Code 00 (= virtuell) .. 99&#10;&#10;Gesetzliche Grundlagen&#10;- ZB &#10;   ZE TN8 Art. 14 ZG Absatz 1 A&#10;   ZE Detail Nach Verordnung Zollerleichterungsverordnung Art 14&#10;   Art 50-55 ZV&#10;   Zollerleichterungsverordnung&#10;- Pr&#228;ferenzverordnungen (ZTG, Anhang 1 GT)&#10;-Abkommen GATT Aviatik&#10;&#10;HINCO (verkn&#252;pft mit TN8) kann berechnet werden aus ZE-Zuweisung und ZE-Code (ZBG_CODE)&#10;2 NUR ZE: Code nicht 00 (nicht virtuell)&#10;1 KEIN ZE: Code 00 nur auf Tariflinie&#10;3 Beides: Code 00 auf Tariflinie, Darunter nicht-00 Code&#10;4, 5 MIN&#246;St Codes, k&#246;nnen nicht generiert werden. WERDEN DIE NOCH GEBRAUCHT. =&gt; JA f&#252;r rechtlichen Hinweis&#10;Die beiden Codes (Zollerleichterung / Min&#246;st-Steuerverg&#252;nstigungi) werden in TN8 gef&#252;hrt.&#10;Codes 1-3 betreffen die Zollerleichterung und k&#246;nnen mit den Eintr&#228;gen in die ZE abgebildet werden. Es braucht den Code nicht mejhr.&#10;Codes 4 und 5 betreffen Zusatzabgaben-Schl&#252;ssel-Verbindungen und sagen aus, ob es eine Bewilliung braucht. Sie werden neu dort verwaltet&#10;ENTSCHEID 14.5.2019 te, stb, Andr&#233;?? Der Hinco wird nicht mehr gef&#252;hrt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={c853df7d-0f8d-42cc-a724-a7944a75f7ea}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={40e164a6-a284-4d55-9c36-7febf52cfefa}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={182f9c63-46ff-42c8-9080-c7fa7be62822}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={40e164a6-a284-4d55-9c36-7febf52cfefa}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
