        <properties documentation="Minimalgeb&#252;hr, die f&#252;r eine Einheit f&#252;r die ZE-Geb&#252;hr verlangt wird.&#10;&#10;Die Minimalgeb&#252;hr gilt f&#252;r alle ZE. Es ist ein einziger Wert (je W&#228;hrung) der in der Rechnungsstellung als Grenze verwendet wird." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
