        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Erhebungen oder Einschr&#228;nkungen, die von der EZV umgesetzt werden, aber von anderen Departementen / Organisationen (gesetzlich) vorgegeben werden.&#10;Es gibt Zusatzabgaben, die nur bei Import/Export/Transit verlangt werden.&#10;Andere werden auch im Inland erhoben (Tabaksteuer, Sota)&#10;&#10;Der Ansatz gilt immer f&#252;r &quot;Faktor&quot; Einheiten der Bemessungseinheit." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
