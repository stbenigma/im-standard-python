      <element xmi:idref="EAID_ENTI138_EE_A48C_4674_BD80_DBA3E7CC7DB4" xmi:type="uml:Class" name="Deklarationsvorschrift" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="30" ea_eleType="element"/>
        <project author="stb" created="2018-11-27 07:58:17" keywords="ENTI138" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Erfassungs-Feld (Rohmasse, Eigenmasse, Zusatzmenge) gibt an, in welches Feld bei einer Deklaration ausgef&#252;llt werden muss und in welcher Einheit der Wert interpretiert wird.&#10;&#10;F&#252;r jede TN8, und jedes Steuerungselement (d.h. durch die 00-L&#246;sung nur f&#252;r Steuerungselemente) braucht es die Angabe, welche Deklarationsfelder bei der Deklaration Pflicht sind und was dort einzuf&#252;llen ist.&#10;Diese Felder werden verwendet f&#252;r die Berechnung des Ansatzes und oder f&#252;r statistische Zwecke (nur Eigenmasse, und Zusatzmenge). &#10;Der Ansatz kann nur eine Deklarationsvorschrift referenzieren, der f&#252;r seine TN8 g&#252;ltig ist.&#10;&#10;Dies war fr&#252;her der Mengencode.&#10;&#10;&quot;braucht Eigenmasseumrechung (J/N)&quot; sagt aus, dass es in Umsystem (DDB) die Eigenmasse mittels Faktor aus der Zusatzmenge berechnet wird.&#10;Macht nur Sinn, f&#252;r das Eingabefeld Zoll-Zusatzmenge. &#10;Neu kann das gel&#246;st werden, indem der Zusatzmenge ein Umrechnungsfaktor angeh&#228;ngt wird. Dieser Faktor ist pflicht, wenn es keine Eigenmassedeklarationsvorschrift gib t." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={4d32538e-83a7-4c89-b6e2-741e6a461d52}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={6647e2e1-4153-4770-8a55-b102e25452a6}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={02cca27a-4d7c-49a6-b05a-598ccd7e6092}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={6647e2e1-4153-4770-8a55-b102e25452a6}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR799_C6_651A_4EF1_98C5_DE45A9B8C3C4" name="Erfassungfeld"/>
          <attribute xmi:idref="EAID_ATTR800_08_520A_43C2_B771_50B7B1F33BE5" name="f&#252;r Ansatz brauchbar (J/N)"/>
          <attribute xmi:idref="EAID_ATTR801_14_3123_4F5A_A6C7_3BCA48CC00C4" name="Tares-Text"/>
          <attribute xmi:idref="EAID_ATTR802_2B_ABFD_4F54_AE9B_1E589C94C549" name="Verkehrsrichtung"/>
          <attribute xmi:idref="EAID_ATTR803_D7_2777_45CD_B750_78F3F4C9AB21" name="G&#252;ltigkeitsperiode"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI301_C5_4DC0_4021_9B50_FC57BB315C1F" xmi:type="uml:Class" name="Detail ZE" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="31" ea_eleType="element"/>
