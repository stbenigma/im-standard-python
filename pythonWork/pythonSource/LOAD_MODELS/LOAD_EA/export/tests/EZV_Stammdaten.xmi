      <element xmi:idref="EAID_ENTI141_4E_D987_421E_9F6C_6DF4394AFCA7" xmi:type="uml:Class" name="Dienststelle" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="33" ea_eleType="element"/>
        <project author="stb" created="2020-03-27 10:02:17" keywords="ENTI141" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zusammenfassung von Nationaler und internationaler Dienststellen&#10;&#10;Als Dienststelle im Sinn der gemeinsamen Stammdaten f&#252;r IT-Systeme gilt ein Standort der Eidgen&#246;ssischen Zollverwaltung EZV (in Zukunft: Bundesamt f&#252;r Zoll und Grenzsicherheit BAZG). Dies umfasst s&#228;mtliche geografisch lokalisierten Niederlassungen f&#252;r alle dienstlichen Aufgaben des BAZG.&#10;Es sind somit alle Standorte f&#252;r Belange des Warenverkehrs (Zoll), der Grenzwache wie auch alle weiteren Dienstgeb&#228;ude oder -gel&#228;nde in der ganzen Schweiz enthalten.&#10;Normalerweise kann eine Dienststelle f&#252;r alle Arten von Diensten verwendet werden. Aufgrund aufgabenbezogener Attribute werden die Dienste zugeordnet.&#10;Bedingungen:&#10;Die Dienststelle in Sinne dieser Definition erf&#252;llt alle diese Punkte:&#10;-       Kann geografisch auf einen festen Punkt verortet werden&#10;-       Hat eine dienstliche Bedeutung f&#252;r EZV&#10;-       Hat f&#252;r IT-Systeme oder Liegenschaftsdienste eine Bedeutung&quot;&#10;&#10;Beispiele: OZD, Zollstelle, Grenzwachtposten, Kontrollstation des fahrenden Verkehrs, B&#252;ro im Ausland, Verzollungskasten&#10;Basel Weil&#10;Koblenz Zoll" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={7fe65817-9849-45d7-a531-51e3776bf3a1}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={1076aea1-7cab-4f15-a788-fc2812dbfa22}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={dd8692b3-96b7-496e-8451-4d52f170900c}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={1076aea1-7cab-4f15-a788-fc2812dbfa22}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
