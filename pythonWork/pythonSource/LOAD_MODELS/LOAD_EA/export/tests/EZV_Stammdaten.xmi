      <element xmi:idref="EAID_ENTI329_01_E0B8_4A5A_AE97_B5AEF762510B" xmi:type="uml:Class" name="Steuerungselement" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="134" ea_eleType="element"/>
        <project author="stb" created="2018-08-21 08:34:59" modified="2022-06-15 18:13:47" keywords="ENTI329" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Sonderausscheidung / Schl&#252;ssel f&#252;r diverse Zwecke.&#10;&#9;&#8226; wegen Statistik (intern. Vorgabe, Zuweisung zu Warengrp, CTC etc.)&#10;&#9;&#8226; Steuerung: Bewilligungen, Kontingent, Min&#246;sch, Abgaben, &#10;&#9;&#8226; Nachtr&#228;gliche Erhebung einer Geb&#252;hr&#10;Ursprung von Sonderausscheidungen&#10;  kommen von Firmen z.B. Uhren (Stat.)&#10;  Bundes&#228;mter, Kontrollstellen f&#252;r Steuerung (Bewilligung, Konti.)&#10;  EZV intern (Min&#246;st)&#10;&#10;Gesetzliche Grundlage:&#10;Verordnung &#252;ber Statistik des Aussenhandels&#10;&#10;Name Sonderausscheidung kam aus Gesetz.&#10;Steuerungselement (Okt. 2018) Vorschlag von Alexandra Meier NZE&#10;&#10;Die Beziehung zum Deklarationsfeld kann nur als Ab&#228;nderung zur TN8 vorkommen und kann nur vom Feldtyp Zusatzmenge sein." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
