        <properties documentation="Einheit f&#252;r die Bemessung von Ans&#228;tzen und Geb&#252;hren&lt;br/&gt;Die Bemessung gilt f&#252;r&lt;br/&gt;Rohmasse (100 kg)&lt;br/&gt;Eigenmasse (100 kg)&lt;br/&gt;Zusatzmenge (jeweils 1, Einheiten siehe Beispiele)&lt;br/&gt;&lt;br/&gt;Beispiele:&lt;br/&gt;Basismenge&lt;br/&gt;   Rohmasse je 100 kilo&lt;br/&gt;   Eigenmasse je 100 kilo&lt;br/&gt;Zusatzmenge&lt;br/&gt;  St&#252;ck,Paar,Dutzend,Anwendungseinheit&lt;br/&gt;  Liter&lt;br/&gt;  MWh&lt;br/&gt;  Meter&lt;br/&gt;  Meter^2&lt;br/&gt;  Meter^3&lt;br/&gt;" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
