      <element xmi:idref="EAID_ENTI220_0D_7418_473A_A971_A4CF669ED655" xmi:type="uml:Class" name="NZ Massnahmetyp" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="112" ea_eleType="element"/>
        <project author="stb" created="2022-05-23 15:54:22" keywords="ENTI220" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Typ / Art von Massnahme, die eine Deklaration beim Zoll angewendet werden kann.&#10;&#10;&#220;berpr&#252;fungstyp gibt an, ob diese Bewilligung vom System bei der Deklarationspr&#252;fung automatisch gepr&#252;ft wird oder ob es eine manuelle Pr&#252;fung braucht.&#10;&#10;Es gibt Massnahmen, die von der Abfertigungsstelle abh&#228;ngne. Beispiel: BLV-VET Drittland Flugverkehr&#9;Aus Drittl&#228;ndern via ZH und GE&#10;&#10;Generalklausel:&#10;Bsp: Elfenbein ist nur mit Zertifikat (&quot;&#228;lter als x Jahre&quot;) einf&#252;hrbar. Diese Bewiilligungspflicht ist beim Klavier explizit zugewiesen, gilt aber auch f&#252;r M&#246;bel oder andere Gegenst&#228;nde.&#10;&#10;ALT: &quot;Generalklausel = JA&quot;  heisst, die Massnahme  gilt f&#252;r s&#228;mtliche Tarifnummern, nicht nur f&#252;r die aktuell zugeteilten.&#10;&#10;NEU: Eine Massnahme kann sowohl einer Tarifnummer zugewiesen sein  als auch eine Generalklause (=f&#252;r alle Tarifnummern anzuwenden) haben. Beispiel: Elfenbein gilt f&#252;r alles aber ist Klavieren zugewiesen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={15225112-1260-4744-b7b4-4f972cb3a982}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={0e5b68b6-33b7-4d5a-a8f1-085bf2daba86}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={ae79efc7-4e6b-4380-85ea-17c5dc780786}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={0e5b68b6-33b7-4d5a-a8f1-085bf2daba86}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
