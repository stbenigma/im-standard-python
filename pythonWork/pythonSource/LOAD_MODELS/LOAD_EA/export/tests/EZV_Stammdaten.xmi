      <element xmi:idref="EAID_ENTI173_8C_2F35_4C88_9B40_7D8DF70BA4CF" xmi:type="uml:Class" name="Hinweis NZE" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="65" ea_eleType="element"/>
        <project author="stb" created="2019-02-06 15:18:04" keywords="ENTI173" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Regeln (Hinweise, Verbote, Embargos), die bei Warentransfer ber&#252;cksichtigt werden m&#252;ssen und die nicht &#252;ber tarifarische NZE (Bewilligung, Meldung, Abgabe) gel&#246;st sind.&#10;&#10;Hinweise bei der Einfuhr oder Ausfuhr einer bestimmten Ware oder aller Waren die eine bestimmte Bedingungen erf&#252;llen.&#10;Dient dazu dem Deklaranten die richtigen Fragen zu stellen, bzw. den kontrollierenden Organen die Liste der m&#246;glichen Bedingungen zu liefern.&#10;Kann Artenschutz, Sicherheit, Gesundheit, Embargos, Waffen, Chemikalien, Schwermetalle, etc. sein.&#10;&#10;Beispiele&#10;nicht Steuerungselement abh&#228;ngig&#10;   CITES&#10;   Elfenbein ist jeglicher Menge und Verarbeitungsform grunds&#228;tzlich bewilligungspflichtig. (Anmerkung: wir haben bereits in Tares CITES- Eintr&#228;ge f&#252;r Elfenbein abgebildet (dort wo es Sinn macht). Generalklausel CITES: den Artenschutzbestimmungen k&#246;nnen ebenfalls Waren von Tarifnummern unterstellt sein, bei welchen auf der Seite &quot;Anzeige Details&#8220;, &quot;Zusatzabgaben&#8220; kein Hinweis auf CITES besteht, die aber mit Teilen gesch&#252;tzter Tierarten versehen sind oder die solche enthalten (z.B. Kleider mit Pelzbesatz von gesch&#252;tzten Tierarten, Schatulle mit Schnitzereien aus Elfenbein).&#10;   Kinderpornographie ist in jedem Artikel (auch als Verpackung) verboten&#10;   dual use G&#252;ter unterliegen einer Bewilligungspflicht (dies haben wir &#252;berall abgebildet, u.E. nicht erw&#228;hnen))&#10;Steuerungselement-abh&#228;ngig&#10;  Schweinfleisch aus der Seuchenregion xy ist verboten (wie will man das implementieren ?)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={3d0c9b11-4830-427c-8e98-7de75d2260be}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={107177ef-01f5-46b3-a106-5963668a808b}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={c5de0c53-b661-4511-9ee5-ad22e813a2fd}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={107177ef-01f5-46b3-a106-5963668a808b}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
