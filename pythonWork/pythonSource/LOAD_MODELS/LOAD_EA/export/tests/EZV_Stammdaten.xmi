        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Sammlung von Tarifnummern, unter der man etwas ein- oder ausf&#252;hren kann.&#10;&#10;Rein fachlich h&#228;ngen die Details wie Schl&#252;ssel, MWSt, Ans&#228;tze, Zollbeg&#252;nstigungen etc. direkt an TN4, TN6 oder TN8&#10;Dies ist so gel&#246;st, dass es immer eine 6- und 8-stellige Tarifnummer und eine Sonderausscheidung (Schl&#252;ssel) mit Nummer 00 gibt.&#10;&#10;Eine 00(0)-Nr irgend einer Stufe bedeutet demnach, dass diese Stufe nicht existiert und alle Details an der n&#228;chsth&#246;hreren h&#228;ngen.&#10;ACHTUNG: Es kann Sonderausscheidungen geben f&#252;r eine 00-TN8. D.h. faktisch h&#228;ngt die Sonderausscheidung direkt am TN6 oder TN4" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={93370599-c7c2-49f9-86d4-de4bd446a51b}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={343d4695-3f05-4158-93d1-cb8a675c868a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={dc7a2c55-073f-4193-ad42-7d1e65b7b5a5}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={343d4695-3f05-4158-93d1-cb8a675c868a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
