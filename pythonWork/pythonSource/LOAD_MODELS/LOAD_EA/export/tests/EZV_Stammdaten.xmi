      <element xmi:idref="EAID_ENTI194_FE_019A_4737_A9E1_F4E190E13EA2" xmi:type="uml:Class" name="Leere Deklarationsvorschrift" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="86" ea_eleType="element"/>
        <project author="stb" created="2020-06-09 14:19:00" modified="2022-06-15 18:13:47" keywords="ENTI194" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Wird gebraucht um explitzit festzuhalten, dass es f&#252;r eine Tarifposition keine Mengendeklaration braucht.&#10;in GSD Mengencode 10&#10;Macht nur Sinn f&#252;r Zusatzmenge.&#10;Das Konstrukt wird ben&#246;tigt, weil ein Steuerungselement keine Zusatzmenge braucht, die &#252;bergordnete Nationale Unterposition (TN8) aber eine ben&#246;tigt.&#10;&#10;Umsetzungshinweis: Es wird f&#252;r jede Tarifnummer f&#252;r jedes der aktuell 3 Erfassungsfelder (Rohmasse, Eigenmasse, Zusatzmenge) eine Deklarationsvorschrift aus GSD &#252;bernommen (in GSD ist sichergestellt, dass jede TN8 mind. die 3 Eintr&#228;ge hat.&#10;Bei Steuerungselementen werden Deklarationsvorschriften &#252;bernommen. Es werden keine DKV f&#252;r Steuerungslemente generiert. Hat ein Steuerungs keine DKV, gilt die der Vater TN8" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={29edbe5c-3a5b-4226-8a44-db65efb558d8}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d6d83550-443d-4e32-90da-be65e559c784}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={26309cff-72f6-4db3-9bd3-4e3dfc279725}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d6d83550-443d-4e32-90da-be65e559c784}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI195_3C_80E1_46FC_805C_3D9CCDD42B69" xmi:type="uml:Class" name="Lokalbereich" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="87" ea_eleType="element"/>
        <project author="stb" created="2020-04-09 07:29:04" keywords="ENTI195" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Die neuen Lokalebenen sind jeweils f&#252;r alle Kontrollbereiche Waren, Personen und Transportmittel verantwortlich. Die regionale und die lokale Gebietsaufteilung hat nichts damit zu tun, wo wir operativ t&#228;tig sein werden. Wir werden auch in Zukunft schweizweit Standorte haben und sowohl station&#228;re wie auch mobile Eins&#228;tze durchf&#252;hren." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={93acd62d-1bed-4b87-ae0a-88f1d29461a4}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={7104d37c-91f9-499f-98bf-89e224243e8d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={1af7a848-98b2-499b-be13-ab2281791aba}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={7104d37c-91f9-499f-98bf-89e224243e8d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI196_F5_4AE1_4565_B24B_689809C1E811" xmi:type="uml:Class" name="L&#228;ndergruppe" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="88" ea_eleType="element"/>
        <project author="stb" created="2018-08-22 13:12:46" keywords="ENTI196" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zusammenfassung einer Gruppe von L&#228;ndern, die statistisch, tarifarisch oder bez&#252;glich NZE gleich behandelt werden.&#10;&#10;L&#228;ndergruppen k&#246;nnen nur in einer Hierarchie verwendet werden, die aus gleichen Benutzerart ist.&#10;Spezialf&#228;lle&#10;&#10;100000 ALLE L&#196;NDER  f&#252;r Normalansatz verwendet -&gt; wird nicht mehr benutzt, da Tarif nur 1 Hierarchie kennt.&#10;(d.h. alle L&#228;nder sind dem Normalansatz zugeteilt)&#10;&#10;Tarif, statistik, massnahmen fracht" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={650806ed-4a8a-4bb0-aaef-dce7d4841ff0}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={07c8d182-4570-4686-8de7-f3d11230a5ee}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={a7f2f730-4ad3-4ef1-a8ab-7931a35f7075}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={07c8d182-4570-4686-8de7-f3d11230a5ee}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR594_DA_A8B1_4FB8_B298_113A73FE16C2" name="Bezeichnung"/>
          <attribute xmi:idref="EAID_ATTR595_06_6136_4B5F_90C9_E506BA4E68A3" name="Kurzbezeichnung"/>
          <attribute xmi:idref="EAID_ATTR596_AF_BE1A_491E_9E7E_611BA95F69D5" name="G&#252;ltigkeitsperiode"/>
          <attribute xmi:idref="EAID_ATTR597_15_8A06_4AFD_A4BB_FB5BD55BBF05" name="Alle L&#228;nder (J/N)"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI197_DD_8A8A_4AB5_807F_759F9C97D75C" xmi:type="uml:Class" name="L&#228;ndergruppe Land" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="89" ea_eleType="element"/>
        <project author="stb" created="2018-08-29 12:42:32" keywords="ENTI197" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Weist ein Land einer L&#228;ndergruppe zu.&#10;Die Zuweisung darf nur auf L&#228;ndergruppen der untertesten Hierarchiestufe geschehen.&#10;Ein Land darf in einer Hierarchie (begr&#252;ndet durch die L&#228;ndergruppengliederung) maximal 1 L&#228;ndergruppe zugewiesen sein.&#10;&#10;&#10;ALT LDZUW:&#10;Wurde verwendet um L&#228;nder zuzuweisen und um Gruppen zuzuweisen.&#10;&#10;Weist eine LDG einer Benutzerart  einer Gliederung des selben Benutzerart zu.&#10;Damit k&#246;nnen L&#228;ndergruppen gruppiert werden.&#10;&#10;Ein Land kann innerhalb einer L&#228;ndergruppengliederung max. einer L&#228;ndergruppe zugewiesen sein&#10;&#10;HLG:&#10;LDZ_HLG1 LDZ_HLG2 LDZ_HLG3 &#10;1. Hierarchie-Stufe der L&#228;ndergruppe  z.B. Industriel&#228;nder&#10;2. Hierarchie-Stufe der L&#228;ndergruppe z.B. Europ&#228;ische Industriel&#228;nder &#10;3. Hierarchie-Stufe der L&#228;ndergruppe  z.B. EU&#10;WARUM NUMBER(6), was steht in dem Feld?" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={bc8c2f52-64b2-486b-b3e9-e78797729de5}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d7650a9f-a9dd-4904-b53e-537361b8cadd}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={26b95591-c1b9-4d21-b5c9-a439db69f224}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d7650a9f-a9dd-4904-b53e-537361b8cadd}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR658_B5_8B7A_4C09_93C2_D1F49EF401EE" name="G&#252;ltigkeitsperiode"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI198_6A_3510_4761_AFA4_0FC8FF923A93" xmi:type="uml:Class" name="L&#228;ndergruppengliederung" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="90" ea_eleType="element"/>
        <project author="stb" created="2018-08-29 08:47:20" keywords="ENTI198" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Gliedert L&#228;ndergruppen und L&#228;nderzuteilungen nach w&#228;hlbaren Kriterien.&#10;Unterschieden nach Benutzerarten (Massnahme, Statistik, Tarif, Fracht)&#10;&#10;Gibt an, um welche Art Laendergruppe es sich handelt (z. B. Praeferenzgruppen wie EU, GPS etc.; Wirtschaftsgruppen, geographische Gruppen). &#10;Was der Zweck, das Thema dieser L&#228;ndergruppierung/-hierarchie ist.&#10;Damit ist es m&#246;glich hierarchische L&#228;ndergruppierungen zusammenzufassen und sicherzustellen, dass unterschiedliche Typen/Themen nicht vermischt werden&#10;&#10;NEU: Die L&#228;ndergruppengliederung ist die oberste Stufe einer Hierarchie. Jede begr&#252;ndet eine Hierarchie in einer Benutzergruppe. Ausser in der Benutzergruppe TARIF kann es mehrere Hierarchien geben. Jedes Land kann in einer HIerarchie (d.h. in einer L&#228;ndergruppengliederung) nur 1x vorhanden sein.&#10;&#10;Tarif-L&#228;ndergruppengliederungen werden nicht mehr gebraucht. Es gibt f&#252;r Tarif nur 1 Hierarchie.&#10;&#10;Beispiele&#10;97  Statistik,   WTO Stahl&#10;&#9; SACU&#10;&#9;SNB&#10;&#9;OECD&#10;  Fracht&#9;CITES&#10;  &#9;Security&#10;  Massnahmen&#9;GTU&#10;  &#9;&#9;non-GTI&#9; &#10;98 Tarif,          Normaltarif  &#10;99  Tarif,        Abkommen, Pr&#228;ferenzen&#10;-&gt; diese werden nicht mehr gebraucht. Tarife kennen nur 1 L&#228;ndergruppe, wird beibehalten f&#252;r R&#252;ckw&#228;rtskompatibilit&#228;t aber ohne angeh&#228;ngte L&#228;ndergruppen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={c2b9c4fe-a4b5-41f0-956f-eede6c1e0176}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={b0ba0eaa-99af-4151-96c7-41d7263d780f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={6c0c670c-7c70-4285-ae56-5f2df275c9f8}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={b0ba0eaa-99af-4151-96c7-41d7263d780f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR598_8A_9BDB_4CF2_B08B_A8FF1561C3A3" name="Nr"/>
          <attribute xmi:idref="EAID_ATTR599_43_3933_4D80_8F2E_1BD9C281C68A" name="Bezeichnung"/>
          <attribute xmi:idref="EAID_ATTR600_06_82FE_4524_80FA_8208E8AADA62" name="Benutzerart"/>
          <attribute xmi:idref="EAID_ATTR601_CE_20EA_4630_A6A8_9BBE4476735D" name="Alle L&#228;nder (J/N)"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI199_FB_7AD6_4A36_A0BD_CC8FF69A9FD8" xmi:type="uml:Class" name="L&#228;nderliste" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="91" ea_eleType="element"/>
        <project author="stb" created="2019-06-27 14:34:45" keywords="ENTI199" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Liste von L&#228;ndern aus unterschiedlichen Quellen:&#10;&#10;Es gibt gem&#228;ss Roger Brodbeck 3 L&#228;nderlisten (REX, Eurostat, TAXUD, Aussenhandelsstatistik (GSD))." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
