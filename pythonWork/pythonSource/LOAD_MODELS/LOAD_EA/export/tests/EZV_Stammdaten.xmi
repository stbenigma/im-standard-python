        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="NZE-Massnahme, die von einer Tarifnummer oder einem Steuerungselement abh&#228;ngig ist.&#10;&#10;Gruppenpflicht bedeutet:&#10;Massnahmen k&#246;nnen gruppiert werden.  Obwohl jede einzelne optional ist, muss eine aus der Gruppe gew&#228;hlt werden.&#10;&#10;Kontierte Zusatzabgaben vom Typ &quot;nur Detailansatz&quot; d&#252;rfen nicht direkt (sondern via eine Gesamtzuatzabgabe) mit einem Steuerungselement verkn&#252;pft werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
