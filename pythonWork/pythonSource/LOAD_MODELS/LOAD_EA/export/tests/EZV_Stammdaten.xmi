      <element xmi:idref="EAID_ENTI281_7C_A20B_4B2A_A5B8_8113D82F0936" xmi:type="uml:Class" name="Zollansatz" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="173" ea_eleType="element"/>
        <project author="stb" created="2018-08-21 06:59:26" keywords="ENTI281" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zollansatz, der f&#252;r einen Import verrechnet wird.&#10;&#10;Falls es f&#252;r ein Land mehr als einen Ansatz gibt, m&#252;ssen alle einen einmaligen Text haben&#10;&#10;Der Wert ist mit einer Verrechnungseinheit verkn&#252;pft. Diese kann W&#228;hrungen, Fr oder Rp. oder % (des Wertes der Ware) sein.&#10;&#10;Der Faktor gibt an, f&#252;r wie viele Einheiten der Bemessungsgrundlage dieser Ansatz gilt (/1000 St&#252;ck)&#10;&#10;braucht Generaleinfuhrbewilligungs:&#10;Dient dazu, in der gleichen Zeitperiode zwei Zollbeg&#252;nstigungsans&#228;tze zu erfassen. Dies geschieht jedoch in Abh&#228;ngigkeit vom sog. Generaleinfuhrbewilligungs-Code f&#252;r kontingentierte Waren. Agrar 07,08" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
