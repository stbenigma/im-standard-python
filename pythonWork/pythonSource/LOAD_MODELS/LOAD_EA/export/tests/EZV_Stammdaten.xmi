        <project author="stb" created="2019-02-06 15:20:22" keywords="ENTI216" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Kontrolle des Warenverkehrs f&#252;r bestimmte G&#252;ter mit ggf. Meldung an div. Stellen.&#10;Das Monitoring dient den Stellen der &#220;berwachung von Warenfl&#252;ssen, ohne dass der Zoll diese &#220;berwachung direkt durchf&#252;hrt. Der Zoll sorgt nur f&#252;r eine Meldung / Information.&#10;Kann auch eine Frage sein, die beim Anmelden gestellt wird (&quot;Handelt es sich um radioaktive Stoffe&quot;)&#10;&#10;??Entspricht dem heutigen ZB Artencode.(=&gt; Tarif sagt nein)&#10;&#10;&#10;Beispiele&#10; Batterien&#10; Pet-Flaschen&#10; Gold (EMK)&#10;&#10;Name gewechselt von &#220;berwachung auf Meldung (April 2019)&#10;Name gewechselt von Meldung auf Monitoring (Mail von T.Eggimann )" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
