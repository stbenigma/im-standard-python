      <element xmi:idref="EAID_ENTI124_08_4EFB_4495_BC5F_78B7256A5E5B" xmi:type="uml:Class" name="Bemessungsgrundlage" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="16" ea_eleType="element"/>
        <project author="stb" created="2018-09-10 14:58:23" keywords="ENTI124" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Einheit f&#252;r die Bemessung von Zoll- und Zusatzabgaben und Mittelwerten (aus Statistik)&#10;&#10;Die Bemessungsgrundlage sagt aus, wie ein Wert gemessen wird (Temperatur, Druck, Alkoholgehalt etc.) &#10;&#10;Der Text der Bemessungsgrundlage darf keine zus&#228;tzlichen Angaben ((wie z.B. 15% Alkoholgehalt) enthal-ten, die nicht mit den Werten der Grundlage &#252;bereinstimmt. D.h. der Text sollte aus den Attributen dynamisch (bei &#196;nderungen bzw. bei der Ausgabe) zusammengestellt werden.&#10;&#10;Nicht alle Bemessungseinheiten sind f&#252;r alle Zollmengefelder (Deklarationsfelder) sinnvoll.&#10;Z.B. gibt es f&#252;r Rohmasse nur 100 kg (brutto), MWh und Liter.&#10;&#10;Bemessungsgrundlagen k&#246;nnen im Text die Bemessungseinheit (vor allem St&#252;ck) erg&#228;nzen um eine Spezifi-kation:&#10;Volk (1 St&#252;ck heisst ein Bienenvolk, nicht 1 Biene)&#10;&#10;Der Tarestext ist ein Bestandteil f&#252;r die Anzeige neben dem Ansatzwert.&#10;Zus&#228;tzlich kommen ggf. dazu: Faktor des Ansatzes, Brutto/Eigenmasse je nach Deklarationsfeld (Rohmas-se/Eigenmasse)&#10;je 100 kg brutto&#10;je Liter 100% Alkohol" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={51dff2b0-7c3f-48da-a210-89a5dac6cdc7}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={ae66851c-633d-41fd-9f22-63f338f1a1ae}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={7b69cf54-340c-4fd9-9f56-2d1693ff7945}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={ae66851c-633d-41fd-9f22-63f338f1a1ae}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
