      <element xmi:idref="EAID_ENTI148_B5_0AF6_4AE9_9F98_473AD6843150" xmi:type="uml:Class" name="Eigenmasse Umrechnungsfaktor" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="40" ea_eleType="element"/>
        <project author="stb" created="2018-08-22 14:10:42" keywords="ENTI148" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Multiplikator zur Errechnung der Eigenmasse mit Hilfe der Zusatzmenge (z.B. Konvertierung der St&#252;ckzahl in kg) bei Tarifnummern ohne Gewichtsangabe. F&#252;r Aussenhandelsstatistische Auswertungen.&lt;br/&gt;&lt;br/&gt;Zusatzmenge * Faktor = Eigenmasse&lt;br/&gt;&lt;br/&gt;Eintrag ist notwendig, falls es keine Deklarationsvorschrift f&#252;r die Eigenmasse dieser TN gibt &lt;br/&gt;(fr&#252;her Flag &quot;braucht Eigenmassenumrechnung&quot; ).&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;27.6.2019 -&gt; wird neu in DDB gemacht, nicht mehr in Stammdaten.&lt;br/&gt;Nur noch Information, dass die Eigenmasse automatisch generiert wird." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={144a1c45-05ee-44ca-8154-dcfa8a2ef546}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={4cbadd1d-b9e6-44bf-abb7-781155152883}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={a994e24d-1d72-4904-8447-fe6571b8adbc}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={4cbadd1d-b9e6-44bf-abb7-781155152883}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
