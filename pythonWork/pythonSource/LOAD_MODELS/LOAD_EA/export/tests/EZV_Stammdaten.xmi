      <element xmi:idref="EAID_ENTI183_E1_F4FD_471F_A484_361D36B95A43" xmi:type="uml:Class" name="Kontierte Zusatzabgabe" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="75" ea_eleType="element"/>
        <project author="stb" created="2022-03-01 08:47:32" keywords="ENTI183" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Zusatzabgabe die einen Anstatz, eine Einnahmeart und damit eine Kontierung hat.&#10;&#10;Sie kann Bestandteil einer Gesamtzusatzabgabe sein.&#10;&#10;Es gibt Kontierte Zusatzabgaben, die nur als Teil einer Gesamtzusatzabgabe angewendet werden d&#252;rfen: &quot;nur Detailansatz&quot; = TRUE.&#10;Diese d&#252;rfen nicht direkt mit tarif/steuerelementen verkn&#252;pft werden. Sondern nur &#252;ber eine Gesamtzusatzabgabe.&#10;&#10;&#10;Implementiert als Flag in &quot;IST-GESAMTABGABE&quot; = FALSE  in ZAG" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={766f8beb-9ffb-4d7a-a467-23b08295bc2a}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={798241da-a3eb-4bad-a738-22341bc9a1a5}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={2f6975c5-b99c-469b-9c8a-0b46f938a01e}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={798241da-a3eb-4bad-a738-22341bc9a1a5}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR900_92_9F26_40EF_BE6A_B49F21EA470B" name="nur Detailansatz (J/N)"/>
        </attributes>
      </element>
