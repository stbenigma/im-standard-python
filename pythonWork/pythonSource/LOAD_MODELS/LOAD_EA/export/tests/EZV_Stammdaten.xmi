      <element xmi:idref="EAID_ENTI204_2D_646A_4A8D_B668_716FA8DA4D43" xmi:type="uml:Class" name="Mengen Deklarationsvorschrift" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="96" ea_eleType="element"/>
        <project author="stb" created="2020-06-09 14:20:41" modified="2022-06-15 18:13:47" keywords="ENTI204" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Erfassungs-Feld (Rohmasse, Eigenmasse, Zusatzmenge) gibt an, in welches Feld bei einer Deklaration ausgef&#252;llt werden muss und in welcher Einheit der Wert interpretiert wird.&#10;&#10;F&#252;r jede TN8, und jedes Steuerungselement (d.h. durch die 00-L&#246;sung nur f&#252;r Steuerungselemente) braucht es die Angabe, welche Deklarationsfelder bei der Deklaration Pflicht sind und was dort einzuf&#252;llen ist.&#10;Diese Felder werden verwendet f&#252;r die Berechnung des Ansatzes und oder f&#252;r statistische Zwecke (nur Eigenmasse, und Zusatzmenge). &#10;Der Ansatz kann nur eine Deklarationsvorschrift referenzieren, der f&#252;r seine TN8 g&#252;ltig ist.&#10;&#10;Dies war fr&#252;her der Mengencode.&#10;&#10;&quot;braucht Eigenmasseumrechung (J/N)&quot; sagt aus, dass es in Umsystem (DDB) die Eigenmasse mittels Faktor aus der Zusatzmenge berechnet wird.&#10;Macht nur Sinn, f&#252;r das Eingabefeld Zoll-Zusatzmenge. &#10;Neu kann das gel&#246;st werden, indem der Zusatzmenge ein Umrechnungsfaktor angeh&#228;ngt wird. Dieser Faktor ist pflicht, wenn es keine Eigenmassedeklarationsvorschrift gib t." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={69199068-bd43-45e5-849a-e839a4604ea6}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={ae8ffb59-a42f-4291-b3fa-863aa5e44236}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={d9eb5c67-d38f-41dd-aad3-2d9f7716bb56}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={ae8ffb59-a42f-4291-b3fa-863aa5e44236}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR874_19_C198_4143_9FBC_F5B955E30A2E" name="Braucht Eigenmassenumrchng (J/N)"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI205_29_1FF3_46DD_9AD4_25E3EFFBA49A" xmi:type="uml:Class" name="Mengenbeschr&#228;nkung" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="97" ea_eleType="element"/>
        <project author="stb" created="2019-02-06 15:08:22" keywords="ENTI205" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="In der Landwirtschaft Kontigente genannt.&#10;Mengen &#252;ber eine Periode die ein- oder ausgef&#252;hrt werden d&#252;rfen.&#10;Es werden nur die Beschr&#228;nkungen festgelegt. Die eigentliche Verwaltung der laufenden Kontigente geschieht nicht in den Stammdaten.&#10;&#10;Mengenbeschr&#228;nkungen k&#246;nne auch landabh&#228;ngig sein. Beispiel Palm&#246;l aus Idonesien (pr&#228;ferenzielles Zollkontingent).&#10;&#10;Bei Mengenbeschr&#228;nkung, die auf Grund eines Abkommens festgelegt wurden, ist die EZV &#220;berwachungsstelle und muss die Kontigente demnach auch EZV verwalten.&#10;&#10;Ggf. m&#252;ssen Typen von Mengenbeschr&#228;nkungen unterschieden werden:&#10;- Windhundverfahren&#10;- ??&#10;&#10;===&gt; ist mit Umsystemen zu kl&#228;ren, welche Typen von Kontigenten es gibt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={dbef72f2-c561-48cf-8f55-f50d782a9fcb}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d27260c4-f0f7-42ca-8da6-6e40c6c4f391}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={19a8f8e4-e54f-4b8a-80f1-e7744689996e}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d27260c4-f0f7-42ca-8da6-6e40c6c4f391}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR823_9C_AFDB_4051_BB71_77BBFCA34932" name="Obermenge"/>
          <attribute xmi:idref="EAID_ATTR824_CC_CA29_46A0_9830_CB20562B0198" name="Anwendungszeitraum"/>
          <attribute xmi:idref="EAID_ATTR825_50_ED09_48D6_A50D_3F3E5F391B0F" name="Typ (?)"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI206_87_D91E_491B_A86C_5FB2CF2F3032" xmi:type="uml:Class" name="Mengencode" scope="public">
        <model package="EAPK_4EA700AC_767E_4FE1_997F_AB524053B7A3" tpos="0" ea_localid="98" ea_eleType="element"/>
        <project author="stb" created="2018-09-10 15:18:53" keywords="ENTI206" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Codierung nur f&#252;r Stat. Zwecke (DDB)&lt;br/&gt;F&#252;r Aussenhandelsstatistik werden nur VOC und Monopolgeb&#252;hr (Liter rein Alkohol) &#252;bernommen.&lt;br/&gt;&lt;br/&gt;Wird in Tares als stat. Angabe anzeigt und verlangt.&lt;br/&gt;&lt;br/&gt;Siehe auch Zusatzabgabemengencode.&lt;br/&gt;&lt;br/&gt;Es gibt 4 Typen&lt;br/&gt;Zolllmenge  (Rohmasse oder Zusatzmenge oder Eigenmasse)&lt;br/&gt;Eigenmasse &lt;br/&gt;Zusatzmenge&lt;br/&gt;Zusatzabgabemenge &lt;br/&gt;&lt;br/&gt;Es gibt viele Einheiten bei Mengencodes&lt;br/&gt;Beispiele:&lt;br/&gt;Rohmasse&lt;br/&gt;Eigengewicht&lt;br/&gt;Kg, Tonne, gr&lt;br/&gt;Liter, Hektolister&lt;br/&gt;St&#252;ck, Paar, Dutzend&lt;br/&gt;Meter, meter^2, meter^3, &lt;br/&gt;Anwendungsheinheit&lt;br/&gt;(Bienen-)Volk&lt;br/&gt;H&#252;lse&lt;br/&gt;Karat&lt;br/&gt;VOC&lt;br/&gt;Sendung&lt;br/&gt;" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={1c90a87a-6d9b-4d01-849c-dec1ffab10ef}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={f2d4e073-a2f5-46c6-8406-4b565b4257a8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={36ac424b-7f9b-4674-b61d-91f9e23774f5}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={f2d4e073-a2f5-46c6-8406-4b565b4257a8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR717_A8_C136_4A32_A9A3_C1FA48227829" name="Typ"/>
          <attribute xmi:idref="EAID_ATTR718_E4_4B3A_44AD_992C_6898B02F6270" name="Umrechnungsfaktorpflicht (J/N)"/>
          <attribute xmi:idref="EAID_ATTR719_6D_0873_4F5C_8D55_D230CA129047" name="G&#252;ltigkeitsperiode"/>
        </attributes>
      </element>
