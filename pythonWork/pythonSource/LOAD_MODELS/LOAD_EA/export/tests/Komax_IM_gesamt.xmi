      <element xmi:idref="EAID_ENTI343_7B_3869_454A_943E_CB818CCC83FF" xmi:type="uml:Class" name="Baugruppe (ALT)" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="29" ea_eleType="element"/>
        <project author="stb" created="2018-03-07 08:46:10" modified="2022-06-15 18:22:58" keywords="ENTI343" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Besteht aus mehreren  Teilen (Baugruppen oder Einzelteile).&#10;Ist per se keine Mehrnutzen aus Kunden- oder Marketingsicht.&#10;Diese Aufteilung in Subteile ist f&#252;r komax in irgend einem Prozess relevant (Fertigung, Garantier, Ersatzteilt...)&#10;&#10;Sie besteht zwingend aus mindstens einem Teil und/oder einer anderen Baugruppes&#10;&#10;Testing:&#10;Dummy Baugruppe, ist eine Baugruppe, die aber nicht zusammengebaut werden soll. Es ist aber wichtig. St&#252;cklistenstrukturelement. CAD Baugruppe / Phantom Baugruppe / Strukturbaugruppe&#10;&#10;Basic Unit / Subunit ist eine Strukturierung f&#252;r Vorfertigung und Modularisierung.&#10;&#10;&#10;Beispiel Testing:&#10;CT-45&#10;&#10;&#10;30.07.19: Neue Produktview enth&#228;lt eine Baugruppe, deshalb diese auf &quot;ALT&quot; umgetauft." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={fa5c7786-6fc5-41d3-8205-cc7cbeaee914}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={645ccbbd-b111-45dd-aab1-cc1d8e8e1f05}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={ea758303-4171-456c-8f15-7412f5d78eca}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={645ccbbd-b111-45dd-aab1-cc1d8e8e1f05}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
