        <project author="ch1011185" created="2019-10-23 14:28:13" keywords="ENTI219" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="4.11.2019: Input von M. Braunschweiler: PPP werden anhand der Herstellkosten und einem Markup berechnet. Bei Intercompany gibt Controlling die Rahmenbedingungen (Kurs, Markup,...) bekannt, und bei Lieferanten das Controlling zuammen mit Einkauf / Produktion." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
