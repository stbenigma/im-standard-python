        <project author="fyayc" created="2018-04-24 11:23:01" keywords="ENTI228" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="ist am Vertriebsauftrag gespeichert (Input 14.2.19)&#10;&#10;15.03.19: Naming von Produktkonfiguration Version zu Produkttyp Variante.&#10;Es gibt auf dieser Ebene keine Versionen. Wenn eine neue Version einer Komponente in die St&#252;ckliste des Produkts aufgenommen wird, &#228;ndert sich nicht deren Version, sondern es gibt eine neue Variante. Keine wirkliche Historisierung. &#10;Applikation wird nicht in Produkttyp Variante bereits erfasst. Kommt erst sp&#228;ter dazu.&#10;&#10;13.8.19: Umbenennung in Produktvariante gem&#228;ss Call von 12.8.19&#10;&#10;&#10;28.11.19:  Renaming Entscheid im team von Produktvariante auf Produktkonfiguration, da Variante  im AX ein technischer Ausdruck ist&#10;&#10;&#10;10.12.19: bei Solutions hat die Produktkonfiguration keine Variantennummern, sondern eine Artikelnummer (da die Konfigurationen &quot;immer&quot; gezeichnet werden, gem. C. Schmid)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={8edcbab6-002b-493a-a5a4-34f2537e3f6a}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={5d5a7618-dddf-4572-b011-97ff422c24e8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={e5f6f496-4f47-419c-afe1-cf0000c8f694}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={5d5a7618-dddf-4572-b011-97ff422c24e8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
