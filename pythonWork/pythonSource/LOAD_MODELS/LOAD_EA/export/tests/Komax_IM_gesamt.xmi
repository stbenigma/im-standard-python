      <element xmi:idref="EAID_ENTI242_F4_4515_49ED_8741_37F6726A502F" xmi:type="uml:Class" name="Prospect" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="235" ea_eleType="element"/>
        <project author="fyayc" created="2018-05-02 12:30:30" keywords="ENTI242" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Diskussion vom 17.04.19: Ein Lead ist ein &#228;usserst spekulativer Sachverhalt, erst wenn gewisse Abkl&#228;rungen get&#228;tigt wurden und einige Informationen mehr bekannt sind, und es als Gesch&#228;ftschance gesehen werden kann, ist er als Account zu sehen/erfassen. Deshalb auch vom Namen her ge&#228;ndert von Lead zum Prospect. Eventuell noch deutsche Namen dazu finden?&#10;&#10;Kandidat? als deutscher Begriff&#10;&#10;&#10;Klare Unterschiede im Handling zu Debitor, andere Informationen notwendig. &#10;&#10;Angebot muss nicht an juristische Einheit, geht an Standort." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
