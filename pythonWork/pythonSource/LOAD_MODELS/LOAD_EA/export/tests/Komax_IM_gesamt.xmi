      <element xmi:idref="EAID_ENTI136_D7_7776_4E18_BC4B_57349A5C4036" xmi:type="uml:Class" name="Konfigurationsmodell" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="129" ea_eleType="element"/>
        <project author="stb" created="2018-03-07 08:13:44" keywords="ENTI136" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Verkaufbare Einheit mit fertig konfigurierter St&#252;ckliste.&#10;Die Variante ist eine Auswahl aus den m&#246;glichen Konfigurationskombinationen des Modells.&#10;Vordefinierte Varianten erhalten einen Namen als Bezeichnung&#10;Durch den Konfigurator zusammengestellt Varianten erhalten eine Nummer als Bezeichnung.&#10;&#10;Zu jedem Modell gibt es immer genau eine Defaultvariante.&#10;&#10;&#10;-  Naming von &quot;Produktkonfiguration&quot; auf &quot;Konfigurationsmodell&quot; ver&#228;ndert (Input 14.2.19 O.Heisel, S. Hofer, S. Ruggiero, M. Braunschweiler, C. Ghislini)&#10;&#10;Attribut &quot; ist Default [J/N]&quot; rausgenommen und Artikelnummer als Schl&#252;sselattribut hinzugef&#252;gt (Input 22.2.149 O.Heisel, S. Hofer, S. Ruggiero, M. Braunschweiler, C. Ghislini)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={14a94244-4bef-4d9d-a7d1-4b809b97de53}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={4987011b-98ee-4bb7-8e54-c69a0009a7a3}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={4737c033-ef1c-4d76-b982-e0b05baa7800}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={4987011b-98ee-4bb7-8e54-c69a0009a7a3}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR570_A0_8DA8_4121_978F_36CC89D3CBEE" name="Bezeichnung"/>
          <attribute xmi:idref="EAID_ATTR571_F1_E1C7_410E_A796_FF4A2E351ED3" name="G&#252;ltig (ja/nein)"/>
