        <project author="fyayc" created="2018-05-23 14:02:09" keywords="ENTI109" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Handelshemmnis als &#220;berbegriff f&#252;r Typen von Bewilligungen, Zertifikate, Sanktionen... &#10;&#10;Art der Bewilligung die f&#252;r bestimmte Produkte gefordert wird.&#10;Beispiel Dual Use: Milit&#228;r, Civil, CE Dokument, NZE, US Re Export Recht&#10;&#10;&#10;Bewilligungen k&#246;nnen von Zollinformationen abh&#228;ngig sein, m&#252;ssen aber nicht. &#10;&#10;abh&#228;ngig: Sanktion, CE (Sicherheitszertifizierung) &#10;nicht abh&#228;ngig: Dual Use, Konfliktmineralien, Reach (Chemikalien Verordnung)&#10;Geb&#252;hren, Bewilligungen, Meldepflicht, Nicht positionsbezogene Regeln, Abf&#228;lle (Recycling), Kontingente, Cites (Artenschutz): Unterschiedliche Arten von Handelshemmnisse&#10;&#10;&#10;13.05.19: Namens&#228;nderung von Handelshemmnis zu Handelsvorschrift&#10;&#10;G&#252;terbezogene Sanktionslisten werden auch als Handelshemmnisse bezeichnet. (Exportbeschr&#228;nkungen) Vom Zoll ausgegebene Strafzoll oder Verbotslisten." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
