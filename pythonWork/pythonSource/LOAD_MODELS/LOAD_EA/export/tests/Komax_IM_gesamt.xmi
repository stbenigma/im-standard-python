        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Maschine vom Kompetenzzentrum Solutions erstellt.&#10;Ist eine Maschine kundenspezifisch zusammengebaut aus standard und speziellen Moduln.&#10;&#10;Erweiterte Erkl&#228;rung: &#10;Lambda ist neue Produktschiene. Unterschiedliche Modell (Lambda 1, Lambda 4, ...) Das ganze wird nicht aus einem Modulpool ausgew&#228;hlt, sondern entwickelt f&#252;r spezifischen Kunden. Prozessmodul. &#10;Prozessmodul wird spezifisch f&#252;r einen Kunden entwickelt. Prozessmodul erg&#228;nz Produktmodell. &#10;Prozessmodul kann entwickelt oder eingekauft sein.&#10;&#10;Definition und Modellierung noch korrekt?" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
