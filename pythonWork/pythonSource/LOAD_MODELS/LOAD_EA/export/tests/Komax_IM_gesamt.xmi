          <attribute xmi:idref="EAID_ATTR668_7C_6141_47E2_B37D_9F64C6E8F13F" name="Preis"/>
          <attribute xmi:idref="EAID_ATTR669_A1_FDFF_48B2_A2BA_9C56EC3CBE5F" name="G&#252;ltig ab"/>
          <attribute xmi:idref="EAID_ATTR670_C8_A6C5_479D_B958_155096ECB50B" name="G&#252;ltig bis"/>
          <attribute xmi:idref="EAID_ATTR671_12_18BC_4C14_A594_171B397EFE06" name="Preisschema"/>
