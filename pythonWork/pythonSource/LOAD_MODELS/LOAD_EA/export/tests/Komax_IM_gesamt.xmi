      <element xmi:idref="EAID_ENTI222_B1_54E6_4117_A3D1_04D0732998C6" xmi:type="uml:Class" name="Produkteinzelpreis" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="215" ea_eleType="element"/>
        <project author="toz" created="2018-05-16 13:47:38" keywords="ENTI222" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="18.10.19: Produktpreis in Produkteinzelpreis umbenannt. Der Produkteinzelpreis wird vom PM festgelegt oder &#252;ber die Automatische Preisberechnung. &#10;&#10;Der PM gibt dem Produkt eine &quot;Schemanummer&quot; (systemgetriebener Name). Anhand dieser Nummer ist definiert, ob der PM den Preis selber festlegt oder ob die automatische Preisberechnung angewandt wird. &#10;&#10;Was ist der Unterschied vom Produkteinzelpreis und dem Master GLP CHF?" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={21e8bbd5-61b0-4298-8769-900031a0c944}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={99f9bd92-a5f5-4dbb-886e-5bb3c713010b}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={c243f8ae-76e0-42e8-bde5-9bf11505103d}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={99f9bd92-a5f5-4dbb-886e-5bb3c713010b}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
