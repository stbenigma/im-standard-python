        <properties documentation="Diskussion 23.07.19&#10;Keine unterscheidung in Kaufteil vs Zeichnungs(/Entwicklungs)Teil. Soll als Attribut abgehandelt werden. &#10;&#10;&#10;28.11.19: beinhaltet auch maschinengebundene Software" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
