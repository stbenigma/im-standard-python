        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="256" ea_eleType="element"/>
        <project author="fyayc" created="2018-05-23 14:17:11" keywords="ENTI263" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="21.2.19 Besprechung mit Nicole Suter: Sanktionsliste sind verschiedene Listen, welche bei uns &#252;ber Tool &quot;TIA-S-Check&quot; bei der Komax AG im Einsatz ist&#10;&#10;3.5.19: https://de.wikipedia.org/wiki/Sanktionsliste&#10;Liste der Sanktionslisten. Ein Eintrag in dieser Entit&#228;t ist eine bestimmte Sanktionsliste. &#220;ber Verbindungen sind dann die spezifischen Eintr&#228;ge in einer bestimmten Sanktionsliste abgedeckt. &#10;&#10;Neben Personen, Gruppen, Organisationen werden auch bestimmte Wirtschaftsg&#252;ter (Waren) in verschiedenen offiziellen Listen gef&#252;hrt. Grund hierf&#252;r kann zum einen die Exportbeschr&#228;nkung (Exportkontrolle) sein, wie es u. a. bei den sog. Dual-Use-G&#252;tern der Fall ist, die sowohl f&#252;r zivile als auch f&#252;r milit&#228;rische Zwecke verwendet werden k&#246;nnen. Listen mit Wirtschaftsg&#252;tern, die der Exportkontrolle unterliegen (z. B. Anhang I der EG-Dual-Use-Verordnung), werden allerdings im allgemeinen Sprachgebrauch bezeichnet. Der Begriff &#8220;Sanktionsliste&#8221; wird vielmehr f&#252;r G&#252;terlisten verwendet, die Waren auflisten, die mit Strafz&#246;llen belegt sind.[5]" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={e3578af1-9b39-4a70-929c-0a435b37ea2a}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={e74dfdce-d948-4de8-9fd6-c5697bd254b8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={f2adb0c2-005a-481e-bba3-ee82daddb274}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={e74dfdce-d948-4de8-9fd6-c5697bd254b8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
