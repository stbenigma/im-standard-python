      <element xmi:idref="EAID_ENTI146_FD_4EAA_40DE_B313_B64BD38D8DA9" xmi:type="uml:Class" name="Kostenstelle" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="139" ea_eleType="element"/>
        <project author="toz" created="2018-06-04 14:02:22" modified="2022-06-15 18:22:58" keywords="ENTI146" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Notizen 04.06.18: Beschreibt, wo die Kosten entstehen. Als Planungs- / Steuerungsinstrument verwendet. &#10;Sogenannte indirekten Kosten werden &#252;ber Kostenstelle umgerechnet.&#10;&#10;Kostenstelle: Jede Abteilung hat eine oder mehrere Kostenstellen. &#196;hnliche T&#228;tigkeiten, &#228;hnliche Kosten pro Stunde. Pro Standort ganz unterschiedlich&#10;Auf Kostenstelle wird Stundensatz bestimmt. Hilfskostenstellen. Mit Normalkostenrechnung auf Kostentr&#228;ger &#252;bertragen. Umrechnung von Leistung in Franken. &#10;&#220;ber-/Unterdeckung ist auch Funktion der Kostenstelle; Planungs- und Steuerungsinstrument; Und hat einen Chef.&#10;&#10;Notizen 12.09.2018:&#10;Kostenstellen sind pro Firma unterschiedlich.&#10;Kostentr&#228;ger m&#252;ssten Konzernweit gleich sein, ist aber nicht so im Moment." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={8a1d3a1d-84b4-4bb1-b9c2-2b0238efaa56}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={78d33c8c-472c-47ac-82b3-af0321d4062a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={fb666fa3-642f-4391-a218-e3079a8bab30}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={78d33c8c-472c-47ac-82b3-af0321d4062a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR717_79_BB83_42D2_A385_A8DB65CDB1D0" name="Nummer"/>
