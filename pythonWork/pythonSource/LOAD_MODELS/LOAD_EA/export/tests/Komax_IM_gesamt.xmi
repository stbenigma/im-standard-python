      <element xmi:idref="EAID_ENTI73_40C_AA3F_48F5_8E9D_7C74EF614BF9" xmi:type="uml:Class" name="Entwicklungsdienstleister" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="66" ea_eleType="element"/>
        <project author="toz" created="2019-04-19 13:17:02" keywords="ENTI73" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Im Workshop vom 17.04.19 wurde die Entit&#228;t &quot;Dienstleister&quot; gestrichen, da sie als Auspr&#228;gung eines Agenten gesehen wird. Allerdings konnten die Anwesenden nicht ausschliessen, das es in der Entwicklung gewisse Dienstleister gibt, welche mit einer speziellen Entit&#228;t erw&#228;hnt werden m&#252;ssen. &#10;&#10;Eventuell auch Marketing." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
