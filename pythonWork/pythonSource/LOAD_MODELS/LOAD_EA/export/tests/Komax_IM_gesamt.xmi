      <element xmi:idref="EAID_ENTI131_37_5B7D_4A2C_A193_8C38F6F1C7C5" xmi:type="uml:Class" name="Komponente Modulfunktion" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="124" ea_eleType="element"/>
