        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="M&#246;glicher Rabatt :&#10;Kickback auf Terminvolumen&#10;&#10;9.12.19: Bei KA: Die kumulierte Rabattierung bei KeyAccount Agreements kann Einfluss auf die Kommission nehmen. Je nach dem wie der Rabattsplit zwischen HQ und Vertretung definiert ist, f&#228;llt die Kommission h&#246;her oder tiefer aus. &#10;&#10;17.12.19: Vertragsart als Attribut hinzuf&#252;gen. Diskussion. Eventuell Attribut hinzuf&#252;gen GPA (J/N)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
