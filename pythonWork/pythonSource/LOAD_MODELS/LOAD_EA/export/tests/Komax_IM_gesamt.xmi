      <element xmi:idref="EAID_ENTI147_C0_21E4_477C_90E0_C2537489B0A7" xmi:type="uml:Class" name="Kostentr&#228;ger" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="140" ea_eleType="element"/>
        <project author="toz" created="2018-06-04 13:50:04" modified="2022-06-15 18:22:58" keywords="ENTI147" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Notizen 04.06.18: F&#252;r betriebliche Buchhaltung. Im Reporting verwendet. Sammelt / konsolidiert alle Kosten die anfallen.&#10;Direkte Kosten, beschreibt f&#252;r was die Kosten anfallen. &#10;Kostentr&#228;ger haben Hierarchie. Je nach Verwendung &#228;ndert sich Kostentr&#228;ger. &#220;berschreibt Sachmerkmal gesteuerter Kostentr&#228;ger.&#10;Zuteilung Kostentr&#228;ger bei Fixierung St&#252;ckliste.&#10;&#10;&#10;&#10;&#10;Unterschiedliche Arten f&#252;r Projekt, Produkmanagement, Unterhalt, zu kl&#228;ren&#10;Kostentr&#228;ger Art relevant f&#252;r Rechnungslegung. Wird unterschiedlich aktiviert." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
