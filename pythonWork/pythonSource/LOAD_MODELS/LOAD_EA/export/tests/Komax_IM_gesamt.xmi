        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Das K&#252;rzel der Produktgruppe entspricht der finanziellen Sachmerkmalstufe 1 (2 Stellen); im AX als &quot;Artikelgruppe&quot;  definiert&#10;&#10;&#10;Vollautomatisch&#10;Teilautomatisiert&#10;Alpha Series&#10;Gamma Series&#10;Rotations-stripper&#10;&#10;&#10;Verwendet f&#252;r &#10;Marketing (channels, externe Struktur, Suchkriterium)&#10;Finanz&#10;Service" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
