      <element xmi:idref="EAID_ENTI128_CC_DBB8_44B9_A1B6_7575A3F727C4" xmi:type="uml:Class" name="Kommission" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="121" ea_eleType="element"/>
        <project author="toz" created="2018-08-27 11:00:29" keywords="ENTI128" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Standard = Differenz GLP zu GPP&#10;&#10;Individuell bis auf Artikelgruppenebene.&#10;&#10;&#10;9.12.19: Provision ge&#228;ndert durch Kommission&#10;Kommission wird bei KA anders gerechnet als bei nicht KA. &#10;KA: Kommission ist abh&#228;ngig vom Rabattsplit. Ein Teil des gesprochenen Rabatts wird zentral &#252;bernommen, ein Teil von der Vertretung. Je nach Rabattsplit f&#228;llt die Kommission h&#246;her oder tiefer aus. &#10;Bsp: GPP 80, GLP 100. Rabatt 20. --&gt; GKP 80. Wenn jetzt der ganze Rabatt von Vertretung &#252;bernommen w&#252;rde, k&#246;nnte keine Kommission mehr gesprochen werden. Deshalb &#252;bernimmt HQ z.B. 50% vom Rabatt. --&gt; Transferpreis sinkt auf 70 und Vertretung erh&#228;lt Komission von 10 (Differenze Transferpreis - GKP)&#10;&#10;nicht KA: Kommission entsprich Prozentsatz auf Endpreis, normalerweise 10%. &#10;&#10;Grundgedanke von Komission: Besteht aus 3 Teilen: 1. Verkaufsbem&#252;hungen, 2. Installation, 3. Aftersales." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={1c7cedd5-2aba-445f-99db-2c457bc0aa7f}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={7ca65f28-4f44-4ae0-877b-13341851504c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={2db6cf9a-1d5a-465f-b7d9-a8e21eba1c13}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={7ca65f28-4f44-4ae0-877b-13341851504c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR813_DF_5019_4290_B353_40DDCF467AB0" name="Typ"/>
          <attribute xmi:idref="EAID_ATTR814_2D_2F4F_4716_BC54_D5C38CCB1589" name="Staffelung"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI364_C3_A1B9_43ED_92C3_DCEE6F51E6C8" xmi:type="uml:Class" name="Kompetenzzentrum" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="122" ea_eleType="element"/>
        <project author="stb" created="2018-08-30 10:17:57" modified="2022-06-15 18:22:58" keywords="ENTI364" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="12.09.2018: Aufteiltung von Komax in Sparten, d.h. Bereiche, deren Finanzzahlen separat konsolidiert werden und die unterschiedliche Prozesse haben oder Kundensegmente betreuen. Ein Endprodukt kann immer einem Kompetenzzentrum zugeordnet werden. Organisatorisch alles je nach Kompetenzzentrum aufgeteilt. Produkt und Kunden sind auch dem Kompetenzzentrum angeh&#228;ngt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={3716aa8d-b192-4f38-b1be-94ec3981484a}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={b6ded8a0-7d89-411c-ab9c-1443f4ce690d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={c6c071a6-5517-4530-bde4-561e3014811e}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={b6ded8a0-7d89-411c-ab9c-1443f4ce690d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI130_5E_947D_47FA_9B72_1FBB677EA58D" xmi:type="uml:Class" name="Komponente ALT" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="123" ea_eleType="element"/>
        <project author="stb" created="2018-03-07 08:59:54" keywords="ENTI130" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Ger&#228;te Komponente kann z.B. ein Ger&#252;st sein.&#10;Oder ein Tisch 70cm, Tisch 80cm Tisch 90cm&#10;&#10;Falls eine Komponenten mehrere Ursprungsl&#228;nder hat, wird im Exportdokument normalerweise &quot;Drittland&quot; angegeben.&#10;Heute gel&#246;st als Verkn&#252;pfung Lieferant - Komponente - Land, was aber nicht alle F&#228;lle sauber abdeckt. Es fehlt eine Chargenverwaltung.&#10;&#10;Verwendungsarten&#10;Finanziell: Serie, Applikation...&#10;Produktion : i(nformativ), s(ch&#252;ttgut), j(it)&#10;&#10;F&#252;r JIT- Teile wird ein Verwendungsort (Lieferort) hinterlegt, da JIT-Teile nicht gelagert werden.&#10;ACHTUNG: Gleiche Teile in mehreren Werken k&#246;nnten unterschiedliche Verwendungsorte haben (Heute nur in CH aktuell).&#10;&#10;18.2.19: Entit&#228;tsname &quot;Verkauf Kompnente&quot;  abgewandelt in &quot;Artikel&quot;&#10;&#10;&#10;Diskussion 23.07.19&#10;Der Name &quot;Komponente&quot; ist immer noch nicht akzeptiert. Unbedingt noch kl&#228;ren, wie diese Entit&#228;t heisst. In neuer Ansicht umfasst diese Entit&#228;t als Supertyp folgende Entit&#228;ten: 150% Produkt (im Moment Produkttyp), Baugruppe (im Moment EntBaugruppe) und Einzelartikel.&#10;&#10;EntModul wurde als Entit&#228;t gestrichen. Ist noch zu verifizieren." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={a81af922-339c-4a76-973e-3ed0601b079c}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={b877f089-2b17-4ebc-ad40-5d284721156c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={eba75674-2749-4a8e-a50e-45931163911e}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={b877f089-2b17-4ebc-ad40-5d284721156c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
