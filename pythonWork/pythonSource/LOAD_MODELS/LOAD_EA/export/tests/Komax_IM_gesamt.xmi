      <element xmi:idref="EAID_ENTI187_BD_693C_46AF_B0FA_28DC9A47455A" xmi:type="uml:Class" name="L&#228;nderspezifische GKP" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="180" ea_eleType="element"/>
        <project author="ch1011185" created="2019-10-31 15:51:06" keywords="ENTI187" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="31.10.19 Meeting mit D. Nufer: Lokaler GKP muss auch Zuschl&#228;ge f&#252;r Logistik, Z&#246;lle und Handling Fee ber&#252;cksichtigen  (Lokaler GKP = globaler GKP + Logistikkosten + Z&#246;lle + Handling Fee)&#10;&#10;9.12.19: Ziel ist gem. 31.10.19 Input Dani, dass f&#252;r alle KA gleiche Bedingungen pro Land herrschen&#10;&#10;Umbenennung von lokaler GKP in l&#228;nderspezifische GKP. Lokaler GKP ist verwirrend, da es (obwohl nicht mehr offiziell gew&#252;nscht) noch lokale KeyAccounts gibt. Hier geht es aber um die Vereinbarungspreisliste f&#252;r globale Key Accounts (GKP) angepasst f&#252;r jedes Land." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={ab552f69-1f62-4d70-9dcd-41b002da9c0c}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={1b39d141-5d54-4d88-9d94-5999b3166061}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={373efc28-bcaa-4bba-af02-d7ab7d77aef5}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={1b39d141-5d54-4d88-9d94-5999b3166061}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
