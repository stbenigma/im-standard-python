        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Definition: Ein Freihandelsabkommen ist ein v&#246;lkerrechtlicher Vertrag zur Gew&#228;hrleistung des Freihandels zwischen den vertragschlie&#223;enden Staaten. Die Vertragspartner verzichten untereinander auf Handelshemmnisse, betreiben jedoch gegen&#252;ber Drittl&#228;ndern eine autonome Au&#223;enhandelspolitik.&#10;&#10;Liste der Freihandelsabkommen der Schweiz bzw der EFTA: https://www.seco.admin.ch/seco/de/home/Aussenwirtschaftspolitik_Wirtschaftliche_Zusammenarbeit/Wirtschaftsbeziehungen/Freihandelsabkommen/Liste_der_Freihandelsabkommen_der_Schweiz.html" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
