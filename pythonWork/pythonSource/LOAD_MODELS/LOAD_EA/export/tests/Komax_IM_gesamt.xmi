      <element xmi:idref="EAID_ENTI348_23_5D73_4958_94E3_CBD8906645FB" xmi:type="uml:Class" name="Einzelteil (alt)" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="62" ea_eleType="element"/>
        <project author="stb" created="2018-08-23 09:55:11" modified="2022-06-15 18:22:58" keywords="ENTI348" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ist die kleinste Einheit, die komax interessiert.&#10;Falls ein Teil selbst aus vielen Teilen besteht (Elektromotor, Steuereinheit), dieses Aufteilung aber f&#252;r komax-Prozesse (Zusammenbau, Qualit&#228;t, Garantie, Ersatzteile,...) nicht relevant ist, wird es als Einzelteil bezeichnet.&#10;&#10;Ein Einzelteil ist zwingend ein Kaufteil, weil kein interner Prozess das Teil ver&#228;nderet." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={d4554ba7-d577-4607-895e-c3425ecdbc8e}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={14094f50-341b-4ace-a9b8-21f87efef994}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={cac2b614-8a3d-4d47-bc7c-12b908001657}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={14094f50-341b-4ace-a9b8-21f87efef994}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
