      <element xmi:idref="EAID_ENTI241_1E_AADF_4E59_BB57_33723BEFEA33" xmi:type="uml:Class" name="Projektpflichtenheft" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="234" ea_eleType="element"/>
        <project author="stb" created="2018-11-13 13:44:16" keywords="ENTI241" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="11.2018: Sammlung von konkretisierten Anforderungen (aus Lastenheft, falls vorhanden) mit einem L&#246;sungsvorschlag (Maschine-Typ, Modul etc.)&#10;&#10;11.2018 Vermutung:&#10;Ein Pflichtenheft kann vor definitiver Abstimmung mit dem Kunden begonnen werden f&#252;r z.B. Teile von denen wir wissen, dass sie wahrscheinlich&#10;in dieser Art kommen werden.&#10;&#10;17.7.19: Entit&#228;tsnamen &quot;Kundenpflichtenheft&quot; abgewandelt in Projektpflichtenheft, da am Pflichtenheft nicht nur der Kunde, sondern auch Komax (SLE) mitarbeiten kann; M&#246;glichkeiten sind von das Pflichtenheft kann 100% vom Kunden vorgegeben sein oder 100% von Komax  erstellt werden" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={22b74f71-b9cd-4dd4-9a52-cdcda01bec02}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={692d049c-892e-4eed-9a11-9931774033d1}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={bb2e84fe-cbaf-49a1-8e87-aac788710354}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={692d049c-892e-4eed-9a11-9931774033d1}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
