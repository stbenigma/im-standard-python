      <element xmi:idref="EAID_ENTI71_B08_E2AF_425D_8823_54281CFEF829" xmi:type="uml:Class" name="Embargo" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="64" ea_eleType="element"/>
        <project author="fyayc" created="2018-05-23 14:11:20" keywords="ENTI71" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Embargo: In der SChweiz vom SECO &quot;Sanktionsmassnahmen&quot; genannt&#10;&#10;Embargo ist nicht von Zoll bestimmt und gepr&#252;ft, sondern auf politischer Ebene entstanden und versucht durchzusetzen. &#10;Falls Zoll das Embargo pr&#252;ft, wird es zu einer G&#252;tersanktionsliste und somit zu einem Handelshemmnis. &#10;&#10;Embargo wird immer gegen ein Land ausgesprochen, nicht gegen juristische Personen oder Einheiten" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={0964f978-fe21-4c3f-a897-045f336f2d99}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={67cf8e3d-ca95-4cfa-b586-23d7e5d99010}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={fbfdb4e9-5b14-497a-ac64-8013c86d74e7}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={67cf8e3d-ca95-4cfa-b586-23d7e5d99010}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
