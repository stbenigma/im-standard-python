      <element xmi:idref="EAID_ENTI332_9C_80D4_40C6_9A57_840B2E16F842" xmi:type="uml:Class" name="Zolltarifposition" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="325" ea_eleType="element"/>
        <project author="fyayc" created="2018-05-23 13:33:57" keywords="ENTI332" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zolltarifnposition in Zolltarifnummer umgewandelt gem&#228;ss 21.2.19 Abstimmung mit Nicole Suter&#10;&#10;15.03.19: Zolltarifnummer in Zolltarifinformation umgewandelt in Workshop mit Nicole Suter und Patrick Isenschmid. Grund: Zolltarifnummer ist eine verschl&#252;sselte Information. Die Nummer an sich sagt nichts aus, nur wenn wir denn Schl&#252;ssel dazu kennen, gibt uns diese Nummer eine valide Information. Und Zolltarifinformation enth&#228;lt nicht nur Nummer, sondern auch die entsprechende textliche Beschreibung. &#10;&#10;02.05.19&#10;Eigentlich sind die ersten 6 Stellen international g&#252;ltig, aber nicht ganz immer.&#10;National geht &#252;ber weit mehr Stellen (z.B. DE: 14, CH: 11)&#10;&#10;Optionale Verkn&#252;pfung zum Land: Falls Nummer nicht landabh&#228;ngig ist Information weltweit g&#252;ltig. &#10;&#10;08.05.19: &#196;nderung zur&#252;ck in Zolltarifposition" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2442e27b-e555-4f36-93f7-215946b07cfc}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={3c5e5400-4a5f-4cdd-860d-61b21d197804}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={46454903-8c3c-4eb1-8ef6-1912e879a58a}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={3c5e5400-4a5f-4cdd-860d-61b21d197804}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR677_DE_7FE2_4A44_9822_A31F95F51707" name="Internationale Zolltarifnummer"/>
          <attribute xmi:idref="EAID_ATTR678_01_FC26_4845_9CFD_151F0BF66EDA" name="Nationale Zolltarifnummer"/>
          <attribute xmi:idref="EAID_ATTR679_4A_D353_4CFA_B2E7_8F17E7839485" name="Anmeldungstext"/>
          <attribute xmi:idref="EAID_ATTR680_76_4E37_4C71_A55A_FB994AD4A911" name="EU Zolltarifnummer"/>
