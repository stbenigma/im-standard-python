      <element xmi:idref="EAID_ENTI139_25_F832_49E2_A77D_68FAEC566B91" xmi:type="uml:Class" name="Konfigurationsregel kommerziell" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="132" ea_eleType="element"/>
        <project author="ch1011185" created="2019-11-29 09:52:04" keywords="ENTI139" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Formel, die festlegt, welche Kombinationen aus Komponenten und Modellen m&#246;glich oder zwingen ist.&#10;Formel kann alle logischen Operanden enthalten.&#10;&#10;6.8.19: alle Variantenteile werden konfiguriert, daher auch ETs werden konfiguriert; Bsp.: SPL Sensor als Einzelbestellung&#10;&#10;18.12.19 Def. Simon Abegg Konfigurationsregel kommerziell:&#10;-&#9;Beschreibt die kommerzielle Sicht wie ein Produkt konfiguriert werden kann&#10;-&#9;Pakete schn&#252;ren beinhaltet mehrere technische Optionen oder Produkte zu einer Verkaufs-&#171;Funktion&#187;&#10;&#9;- Somit kann die kommerzielle Sicht weniger Punkte in der Konfiguration beinhalten als die technische Konfiguration" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={51217f21-bff5-48a1-a511-f26adf38a315}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={23a489a6-d211-40a5-977c-b818cb01c0cf}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={73f71bdf-591e-44ac-89a4-761d9f957f3f}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={23a489a6-d211-40a5-977c-b818cb01c0cf}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR877_EA_4CEA_42A4_A8C4_59EFA995F3DA" name="Regelausdruck"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI140_EC_05FB_42F2_987D_0433B5755354" xmi:type="uml:Class" name="Konfigurationsregel technisch" scope="public">
        <model package="EAPK_499AC8BC_A071_421A_B226_BB0DCFD507C3" tpos="0" ea_localid="133" ea_eleType="element"/>
        <project author="stb" created="2018-03-15 13:43:37" keywords="ENTI140" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Formel, die festlegt, welche Kombinationen aus Komponenten und Modellen m&#246;glich oder zwingen ist.&#10;Formel kann alle logischen Operanden enthalten.&#10;&#10;6.8.19: alle Variantenteile werden konfiguriert, daher auch ETs werden konfiguriert; Bsp.: SPL Sensor als Einzelbestellung&#10;&#10;18.12.19 Def. Simon Abegg Konfigurationsregel technisch:&#10;-&#9;Beschreibt die technisch m&#246;gliche Konfiguration der Produkte / Optionen / Varianten&#10;-&#9;Was ist miteinander technisch verkn&#252;pfbar oder eben nicht kompatibel&#10;&#9;- Beschreibt welche Produkte / Optionen als Verkaufbarer Artikel miteinander kombinierbar sind" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
