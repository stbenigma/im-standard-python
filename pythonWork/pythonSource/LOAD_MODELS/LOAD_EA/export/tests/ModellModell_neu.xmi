      <element xmi:idref="EAID_ENTI292_C8_3FFA_4661_9B35_CF7B3CFB0B3A" xmi:type="uml:Class" name="ExV-Schicht" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="54" ea_eleType="element"/>
        <project author="Lea" created="2022-01-20 12:44:37" keywords="ENTI292" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Jede Ebene deckt einen Aspekt der Informationsverarbeitung ab.  Sie fasst alle Elemente zusammen, die einen Beitrag zum Aspekt / Zweck der Ebene leisten.&#10;Die Ebenen sind nach dem Holonprinzip aufgebaut. Jedes Element auf einer Ebene enth&#228;lt Elemente untergeordneter Ebenen.&#10;&#10;Es sind 6 Ebenen definiert.&#10;Kunde: welcher - au&#223;erhalb unserer Mini-Welt - uns etwas anbietet oder etwas von uns erh&#228;lt. In welcher Form und in welchen Stufen findet die Kommunikation statt.&#10;Erfahrung: &#252;ber welche Kommunikationskan&#228;le werden welche Daten / Informationen an welche Schnittstellen geliefert oder beschafft.&#10;Organisation: Wer ist verantwortlich, ausf&#252;hrend, ... f&#252;r eine Handlung, die etwas zur Erf&#252;llung des Zwecks tut.&#10;Leistung: Welche Verfahren, Vorgaben, Regeln, Prozesse werden f&#252;r die Handlungen ben&#246;tigt, befolgt, ...?&#10;Asset: Welche Werkzeuge werden zur Datenverarbeitung eingesetzt, um die Aufgaben und Prozesse zu erf&#252;llen&#10;Daten: Welche Daten werden verwendet und wo werden sie verwaltet." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={3ba24c24-fadd-440d-953d-b77ec08e87f9}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={6558bac5-ff0a-40a2-91c8-46f3a93e03b8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={edbf52b4-6a47-4f7d-bb34-f2491d0dab24}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={6558bac5-ff0a-40a2-91c8-46f3a93e03b8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR567_21_B3A0_47F3_9BD6_45FD798E9E83" name="Name"/>
          <attribute xmi:idref="EAID_ATTR568_60_4FA2_447F_BE90_F0E5D19A84BE" name="Zweck"/>
          <attribute xmi:idref="EAID_ATTR569_64_B4AE_424F_B687_1D680B40F9CA" name="Farbe"/>
        </attributes>
      </element>
