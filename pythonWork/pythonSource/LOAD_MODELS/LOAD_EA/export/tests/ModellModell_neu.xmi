      <element xmi:idref="EAID_ENTI274_8A_9874_43DE_BFD9_4595C9A23593" xmi:type="uml:Class" name="Kundenreise" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="36" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:05:22" keywords="ENTI274" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Weg eines Kunden entlang eines (regelm&#228;ssigen) Gesch&#228;ftsverh&#228;ltnisses.&#10;&#10;Aus Sicht des Marketing bezeichnet die Kundenreise (Customer Journey) alle Ber&#252;hrungspunkte (Touchpoints) eines Konsumenten mit einer Marke, einem Produkt oder einer Dienstleistung. Hierzu z&#228;hlen nicht nur die direkten Interaktionspunkte zwischen Kunden und Unternehmen (Anzeige, Werbespot, Webseite usw.), sondern auch die indirekten Kontaktpunkte, an denen die Meinung Dritter &#252;ber eine Marke, ein Produkt oder eine Serviceleistung eingeholt wird (Bewertungsportale, Userforum, Blog usw.). Kunden informieren sich zunehmend &#252;ber diese indirekten Kontaktpunkte, welche von den Unternehmen nicht unmittelbar beeinflusst werden k&#246;nnen. Ein tiefgehendes Verst&#228;ndnis der gesamten Customer Journey (inkl. direkter und indirekter Kontaktpunkte) ist Grundvoraussetzung f&#252;r eine kundenorientierte Marketing- und Vertriebsausrichtung." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={a057f79f-269f-44a5-bc5e-61aa353e5417}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={b49e7928-5413-43ff-a2d2-5e6d7995e68a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={8bd4329f-97e0-4900-bb52-d47774e36df9}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={b49e7928-5413-43ff-a2d2-5e6d7995e68a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
