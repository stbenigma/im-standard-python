        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Anwendung mit bestimmten Funktion f&#252;r die Durchf&#252;hrung der Gesch&#228;ftsprozesse.&#10;Die externe Anwendung kennen wir nur, weil wir irgendwelche Informationen auf irgend eine Art mit ihr austauschen und weil ggf. ein Gesch&#228;ftsprozess eine solche nutzt &#10;Sie wird weder intern betrieben noch von einer internen Stelle verantwortet&#10;&#10;Unsere Firma ist verantwortlich f&#252;r Administration (unserer Umgebung), Inhalt und Zugriffsrechten aber nie f&#252;r die Software oder den aktuellen Betrieb,&#10;Keine authority &#252;ber die effektive Software oder Hardware&#10;&#10;Muss keine Verbindung zu IT-System haben" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={f3d9896f-0229-4f64-91b8-31cd44fe7ef0}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={49555058-a44c-4af9-9da3-f96fca95631d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={fad930fe-71c8-4215-8fbf-757f58ca149d}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={49555058-a44c-4af9-9da3-f96fca95631d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
