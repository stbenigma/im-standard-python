      <element xmi:idref="EAID_ENTI426_D8_1205_494B_9298_B17B71602A83" xmi:type="uml:Class" name="Zentrale Anwendung" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="23" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:04:24" modified="2022-06-15 18:12:08" keywords="ENTI426" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Anwendung (Programm, SW-Paket) die als SW-Produkt gekauft oder selber hergestellt wurde.&#10;Die Anwendung kann zentral (Server, Cloud) oder lokal (Arbeitsplatz) installiert sein. &#10;Wichtige Eigenschaft ist, dass die Daten nur einmal vorhanden sind und von allen Nutzenden gemeinsam genutzt werden. Durch welche Technologie ist irrelevant." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
