        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Bezeichnet etwas, das existiert, ein Ding, ein greifbares oder abstraktes Objekt mit Eigenschaften und Beziehungen.&#10;Ding von Interesse in der betrachteten Umgebung / Miniwelt.&#10;Sie ist eine IT-System- und Technologie-unabh&#228;ngige, konsolidierte Beschreibung der Struktur und Bedeutung des interessierenden Dings.&#10;&#10;Eine Entit&#228;t kann wiederum aus einzelnen Teilen (Attributen, Unterentit&#228;ten, Beziehungen, etc.) bestehen ; entsprechend dem Begriff Holon oder Ganzes/Teil." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
