        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI385_C4_1218_4020_8DAF_9E07DCDF9C60" xmi:type="uml:Class" name="Gesch&#228;ftstransaktion" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="21" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:03:22" modified="2022-06-15 18:12:08" keywords="ENTI385" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Gesch&#228;ftstransaktion beschreibt eine Folge von Einzelt&#228;tigkeiten, die schrittweise ausgef&#252;hrt werden, um ein gesch&#228;ftliches oder betriebliches Ziel zu erreichen. &#10;Eine Gesch&#228;ftstransaktion &#252;berf&#252;hrt das System &quot;Gesch&#228;ft&quot; von einem stabilen, definierten Zustand in einen neuen.&#10;Sie besteht aus Einzelschritten, die alle oder gar nicht ausgef&#252;hrt werden. &#10;Sie kann Medienbr&#252;che enthalten (z.B. wenn der Output reale Produkte und ihre digitalen Zwillinge sind).&#10;&#10;Wird auch als Gesch&#228;ftsprozess (Business Process) (obwohl es h&#228;ufig nur eine Komponente davon ist) ein oder use case bezeichnet." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={013599e7-c56a-4321-aab7-d8fbf340455d}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={af404dd3-b839-4cf3-a19c-734dbf7f484f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={06fcc25e-7e85-4433-9c40-1946e84658a9}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={af404dd3-b839-4cf3-a19c-734dbf7f484f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI260_BF_DF9A_4C21_BE01_E225295DF96E" xmi:type="uml:Class" name="Fertigkeit" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="22" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:06:05" keywords="ENTI260" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zusammengefasste F&#228;higkeiten nach Kriterien, die dem Umfeld, dem Unternehmen und der Erfahrung der Expoerten angepasst sind.&#10;&#10;Gibt es messbare Kriterien f&#252;r die Gruppenbildung?" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={e5b9ca22-e2c0-45ad-8f9e-62b61413bf6a}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={5fd62d20-8c3d-46c6-8c44-7a8751917318}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={6b4f0fe3-29e4-4bdb-9a04-b1fa05f5077f}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={5fd62d20-8c3d-46c6-8c44-7a8751917318}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
