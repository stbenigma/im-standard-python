      <element xmi:idref="EAID_ENTI420_79_55C2_4782_9D46_646E31514A49" xmi:type="uml:Class" name="Technischer Prozess" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="136" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:06:05" modified="2022-06-15 18:12:08" keywords="ENTI420" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Gesch&#228;ftsprozess, der durch ein System durchgef&#252;hrt ist. Er kann durch einen Akteur ausgl&#246;st werden, die Ergebnisse sind aber typischerweise nicht direkt f&#252;r den Akteur berstimmt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={bd0c6d26-ea61-4515-9c6c-7ea96e0e9efc}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={bf0e73e1-15c7-46e4-805a-06fbd1be12b0}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={d0ecddd1-51e3-4dec-a84c-766c8fe4d30a}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={bf0e73e1-15c7-46e4-805a-06fbd1be12b0}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI421_72_0F82_46EA_ABAF_C756BDCBE73B" xmi:type="uml:Class" name="Anwendungsfall" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="137" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:05:22" modified="2022-06-15 18:12:08" keywords="ENTI421" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Anwendungsf&#228;lle sind Gesch&#228;ftsprozesse, die immer von Akteuren (intern oder extern) ausgl&#246;st werden. Die Akteure erwarten immer einen direkten Nutzen f&#252;r ihre aktuelle Aufgabe. D.h. sie haben eine Wirkung gegen aussen.&#10;Anwendungsf&#228;lle beschreiben, was die Umwelt (Nutzende, Kunden, Mitbewerber, Betroffene, Klienten, &#214;ffentlichkeit, &#246;ffentliche Verwaltung, etc.) vom System erwartet.&#10;&#10;Wikipedia:&#10;Ein Anwendungsfall (engl. use case) b&#252;ndelt alle m&#246;glichen Szenarien, die eintreten k&#246;nnen, wenn ein Akteur versucht, mit Hilfe des betrachteten Systems ein bestimmtes fachliches Ziel (engl. business goal) zu erreichen. Er beschreibt, was inhaltlich beim Versuch der Zielerreichung passieren kann und abstrahiert von konkreten technischen L&#246;sungen. Das Ergebnis des Anwendungsfalls kann ein Erfolg oder Fehlschlag/Abbruch sein.&#10;&#10;Spektrum De&#10;Ein Use-Case-Diagramm (dt. Anwendungsfall-Diagramm) zeigt das&#10;externe Verhalten eines Systems aus der Sicht der Nutzer, indem es die Nutzer (im&#10;UML-Jargon &#8222;Akteure&#8220; genannt), die Use-Cases und deren Beziehungen zueinander&#10;darstellt.  Use-Cases bilden die Reaktion des Systems auf Ereignisse seiner Umwelt ab und fassen dabei&#10;Teile der Systemdienstleistung zusammen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={7c875cc0-afb0-4e56-abe0-3fc7e8a875e9}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={6eaab6c1-921d-48ce-9656-6ef6c315186c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={52e28206-e41a-4800-aaf1-bc761e5730f3}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={6eaab6c1-921d-48ce-9656-6ef6c315186c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR574_C2_871B_4EA2_901B_A1B7EEB06A98" name="Bezeichnung"/>
        </attributes>
      </element>
