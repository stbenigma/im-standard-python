        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Beschreibung eines Tr&#228;gers einers Wertes.&#10;Dieses Attribut ist die g&#252;ltige Single Source of Truth des konzeptionellen Modells. &#10;&#10;Es ist nicht zwingend notwendig, dass dieses Attribut in dieser Form in einem der Systeme verwaltet wird. Die Definition gilt als Referenz f&#252;r alle, die mit dieser Information arbeiten wollen" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
