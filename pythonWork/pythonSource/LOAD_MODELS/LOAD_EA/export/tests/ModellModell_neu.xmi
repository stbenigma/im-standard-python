      <element xmi:idref="EAID_ENTI253_20_A70E_429D_B78A_C6014CC91816" xmi:type="uml:Class" name="Gesch&#228;ftsf&#228;higkeit" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="15" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:04:24" keywords="ENTI253" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Definiert eine Einheit, die eine sinnvoll zusammenfassbare Gruppe von Informationen, Prozesse und Systemen nutzt bzw. daf&#252;r zust&#228;ndig ist.&#10;&#10;Gesch&#228;ftsf&#228;higkeiten k&#246;nnen &#252;ber mehrere Gesch&#228;ftsbereiche und/oder Abteilungen verteilt sein.&#10;(Beispiele: Projektleitung kann in vielen Bereichen vorkommen)&#10;&#10;ACHTUNG: Es sollten KEINE technischen Aufteilungen (Systeme, Technologie, Medien) f&#252;r die Unterscheidung verwendet werden, da diese h&#228;ufiger &#228;ndern k&#246;nnen.&#10;Es geht um die semantische Gruppierung der Anwendungen und Gesch&#228;ftstransaktionen" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2ec119ac-fce9-487e-9e36-052989468de1}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={a2d6cf8d-2807-4bbb-ad0d-e43d4ed5fd63}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={aff531b6-1be6-4603-bd46-64e98336ee74}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={a2d6cf8d-2807-4bbb-ad0d-e43d4ed5fd63}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
