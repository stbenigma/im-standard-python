      <element xmi:idref="EAID_ENTI242_79_6D60_491F_B8C1_68237469D0A4" xmi:type="uml:Class" name="Vorgabewert" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="4" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:06:23" keywords="ENTI242" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Wert, der f&#252;r eine Aufz&#228;hlungs-Werteliste ein g&#252;ltiger Wert ist.&#10;Das Attribut &quot;Wert&quot; f&#252;r &quot;logische Vorgabewerte&quot; ist der physikalische (sprachunabh&#228;ngige) Wert, der als eigentlicher Wert im konzeptionellen Modell gilt.&#10;Intern -&gt; Logischer Wert,Informationsmodell (in der Firma)&#10;Extern -&gt; Wert in eine Schnittstelle / einem System verwendet" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={c5470005-bf22-4668-a460-b2b4a5dc660f}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={2efbb3dc-5b6a-4a82-8a6f-bbdf16a5041c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={f903af2e-cdca-4a10-950e-1ca4cdd733c3}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={2efbb3dc-5b6a-4a82-8a6f-bbdf16a5041c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
