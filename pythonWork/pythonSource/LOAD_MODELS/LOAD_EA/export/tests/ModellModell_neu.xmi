        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="1:1 Beziehung, die einen echten, exklusiven Subtyp definiert.&#10;Die Beziehungen m&#252;ssen vom Vater aus 1:1 pflicht und in einem Arc sein.&#10;Bei ODM Entity in Entity gezeichnet.&#10;Die Superentity ist immer genau eine der Subentities.&#10;Es gibt immer mindestens 2 Subentities." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
