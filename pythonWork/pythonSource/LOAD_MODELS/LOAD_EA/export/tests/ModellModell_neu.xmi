        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine definierte Schnittstelle zwischen 2 IT-Systemen.&#10;&#10;Synchron heisst, dass die Daten immer in kurzer Zeit (ms - einige Sekunden)  nachgef&#252;hrt und aktuell sind.&#10;Manuell bedeutet, dass eine Person die Daten von einem Werkzeuge in ein anderes &#252;bertr&#228;gt (copy-paste, abschreiben).&#10;online bedeutet, dass die Anwendungen direkt auf die Datenbasis (Datei, DB) einer anderen Anwendung zugreift. Z.B. via DB-Link, Service." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
