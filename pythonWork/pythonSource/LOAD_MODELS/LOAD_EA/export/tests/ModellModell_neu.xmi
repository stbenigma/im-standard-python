        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Alleinstehendes Datenbanksystem zur Verwaltung von Daten, dietypischerweise von mehreren Applikationen im Direktzugriff genutzt werden.&#10;&#10;Datenbanken ausschliesslich von einer Applikation direkt genutzt werden k&#246;nnen und wenn &#252;berhaupt nur &#252;ber Services der Applikation zugreifbar sind werden nicht als Datenbanksysteme aufgezeichnet. Sie sind integraler Bestandteil der Applikation." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
