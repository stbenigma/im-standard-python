      <element xmi:idref="EAID_ENTI250_00_B391_425A_A407_853F3C0E140A" xmi:type="uml:Class" name="Attributtransformation" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="12" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:06:23" keywords="ENTI250" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Attributtransformation transformiert 1-viele Ausgangsattribute in einen Attributwert.&#10; Transformationen von externen Systemen zum konsolidierten Modell bef&#252;llen ein Attribut und verwenden min. 1 Systemattribut.&#10; Transformationen vom Modell zu externen Systemen bef&#252;llen ein Systemattribut und verwenden min. 1 Attribut.&#10;&#10;Das Vorahndensein von Inbound oder Outbound Rule gibt an, ob  ein Attribut oder eine Column gelesen oder geschrieben wird. (RU in COL_ATTR_MAP)&#10;&#10;Falls das Mapping auf ein Attribut einer subentit&#228;t geht (die alle Attribute der Superentit&#228;t erbt), k&#246;nnen wir &#252;ber die Beziehung anwendbar f&#252;r diese Subentit&#228;t angeben." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={4f326653-0c2d-4510-9dd2-3a5a73e7efd7}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={791c741a-f9e2-4d76-ae00-d39ecb2c3923}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={b853de2c-0059-400c-a305-e9814eb581e2}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={791c741a-f9e2-4d76-ae00-d39ecb2c3923}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR534_64_ACCD_4238_85D0_C736BE1E8933" name="Laufnr"/>
          <attribute xmi:idref="EAID_ATTR535_56_3316_4FE0_83A9_D77ED77D3F87" name="Transformationformel"/>
          <attribute xmi:idref="EAID_ATTR536_D8_B7F1_4302_B866_BB0FB32D1073" name="Ausl&#246;seart"/>
          <attribute xmi:idref="EAID_ATTR537_ED_951D_47FB_8C6C_410F69E55D6E" name="Ausl&#246;seperiodizit&#228;t"/>
