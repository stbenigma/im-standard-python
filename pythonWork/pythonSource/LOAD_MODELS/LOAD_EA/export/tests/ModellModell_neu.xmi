      <element xmi:idref="EAID_ENTI422_56_2D6C_4AE1_BA04_1A3E2303D0A3" xmi:type="uml:Class" name="Anwendung" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="5" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:04:24" modified="2022-06-15 18:12:08" keywords="ENTI422" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Anwendung mit bestimmten Funktion (Features, Use cases)  f&#252;r die Unterst&#252;tzung und Durchf&#252;hrung der Gesch&#228;ftstransaktionen. Die Anwendung oder ihr Ouput wird von Personen aktiv oder passiv genutzt.&#10;&#10;Von einem Hersteller geliefert und normalerweise von der IT-Abteilung, &#10;einer Person (z.B. ein eine Anwendung mit Standardtools wie Excel gel&#246;st)  oder interner oder externen Supporter betreut.&#10;&#10;ACHTUNG: Standardtools (Excel, Word etc.) sind keine Anwendungen. Siehe Lokale Anwendung.&#10;Anwendungen die mit Standardtools gel&#246;st sind m&#252;ssen nach ihrer Funktion / ihrem Zweck als eigene Anwendung beschreiben werden.&#10;Beispiele (in Excel gel&#246;st): Ferienabrechnung, Preiskalkulation , Mahnungkontrolle&#10;&#10;Datenbanken ausschliesslich von einer Applikation direkt genutzt werden k&#246;nnen und wenn &#252;berhaupt nur &#252;ber Services der Applikation zugreifbar sind werden nicht als Datenbanksysteme aufgezeichnet. Sie sind integraler Bestandteil der Applikation und werden bei derer Beschreibung erw&#228;hnt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={513ddfe4-f4de-4ad2-8509-5c83a0eb03c5}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={e5afac59-59fd-471c-ac29-d4fa8180f873}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={b0e52230-1fe3-4fb2-8891-8b9755e4ed59}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={e5afac59-59fd-471c-ac29-d4fa8180f873}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
