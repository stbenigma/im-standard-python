      <element xmi:idref="EAID_ENTI251_56_ED5E_4B5D_BFD3_EA109F329BF9" xmi:type="uml:Class" name="Attributwerttransformation" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="13" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:06:23" keywords="ENTI251" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Historie der verarbeiteten Transformationen.&#10;Werte werden geladen, je nach Richtung der Transformation aus dem Fremdsystem oder aus dem konzeptionellen Schema.&#10;Sobald ein Wert den Status 'verarbeitet&quot; hat muss Verarbeitungsart und Transformationszeitpunkt gesetzt sein. Erst dann darf er weiter verwendet werden.&#10;G&#252;ltige verarbeitete Werte haben einen Transformationszeitpunkt, eine Verarbeitungsart, den Transformationsstatus =&quot;verarbeitet&quot; und Transformation g&#252;ltig = 'J' .&#10;Ung&#252;ltige Werte haben den Transformationsstatus =&quot;verarbeitet&quot;, eine Verarbeitungsart, Transformation g&#252;ltig = &quot;N&quot;  und zus&#228;tzlich eine Feherbeschreibung (Fehler-Nr, -Beschrieb, oder (Name der) Regel die verletzt wurde)." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={a3887949-d135-4d74-8c82-90543836cdd6}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={f65c7276-6806-4b11-b753-2413baa22381}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={9abd7e8f-7e50-44be-a298-251e70a4d43d}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={f65c7276-6806-4b11-b753-2413baa22381}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
