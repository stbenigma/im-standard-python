          <attribute xmi:idref="EAID_ATTR555_5C_E443_47FF_B795_5645F1513069" name="Ladezeitpunkt"/>
          <attribute xmi:idref="EAID_ATTR556_B8_FB47_424B_820A_802FE1975301" name="Quellsystemwert"/>
          <attribute xmi:idref="EAID_ATTR557_5B_FC34_4D7D_8F1B_B5342593CEAD" name="Zielwert"/>
