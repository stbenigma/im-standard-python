      <element xmi:idref="EAID_ENTI430_C0_50CB_46ED_8A42_D8AF9D08A613" xmi:type="uml:Class" name="Pers&#246;nliche Anwendung" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="105" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:04:24" modified="2022-06-15 18:12:08" keywords="ENTI430" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Anwendung, die mit Hilfe von generischer Standardsoftware ( Excel, Word, Visio etc.) erstellt wurde oder lokal auf einzelnen Clients installiert ist.&#10;Typischerweise von einzelnen Personen, oft f&#252;r einzelne Abteilungen, Rollen, Personen genutzt. Manchmal f&#252;r eine ganze Firma.&#10;Normalerweise sind diese Anwendungen in Dateien abgelegt, die sowohl Programm (Formeln, Regeln) als auch Daten enthalten.&#10;D.h. es gibt keine zentrale, gemeinsame Datenhaltung.&#10;&#10;Diese lokalen Anwendungen k&#246;nnen Daten aus zentralen Anwendungen beziehen oder liefern (manuell kopiert oder mittels Schnittstellen (odbc, jdbc etc.) direkt integriert." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
