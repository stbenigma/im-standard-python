          <attribute xmi:idref="EAID_ATTR630_84_158B_417D_933E_B762BEA6ED7C" name="Beschreibung"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI254_4C_BED3_4D1F_882F_9651E1ACC6E5" xmi:type="uml:Class" name="Gesch&#228;ftszustand" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="16" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:06:05" keywords="ENTI254" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein Datenzustand (z.B. tiefer Lagerbestand, zu viele offene Rechnungen f&#252;r einen Kunden, tiefer oder hoher Kontostand etc.) l&#246;st einen Gesch&#228;ftsprozess eine -transaktion aus oder ist das vorgesehene Ergebnis eines Prozesses." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={d8078d56-72da-44c7-9187-ff9728de03e8}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={dc4e22ed-bbab-428b-b68a-bc728e4130c0}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={07fe2fbf-7a70-4909-91f1-af3997aec5e5}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={dc4e22ed-bbab-428b-b68a-bc728e4130c0}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI255_79_409D_4E79_B97F_3111750F5133" xmi:type="uml:Class" name="Gesch&#228;ftaufgabe" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="17" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:04:00" keywords="ENTI255" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Unternehmerische Aufgabe, Typ, Bereich von Gesch&#228;ftsfunktionen und Anwendungen, die im Rahmen der Wertsch&#246;pfungskette und -prozesse eines Unternehmens ausgef&#252;hrt werden.&#10;&#10;Gesch&#228;ftsbereiche sind typischerweise f&#252;r 1 oder mehrere Anwendungen  (Hilfsmittel, Werkzeuge, Applikationen, Tools) sowie f&#252;r Gesch&#228;ftstransaktionen und -prozesse verantwortlich. Sie haben die Hoheit &#252;ber die Informationen / Daten, die in den vom Bereich benutzten Funktionen ben&#246;tigt / verwaltet werden.&#10;&#10;Ein Gesch&#228;ftsbereich bestimmt&#10;- Wer erstellt Datens&#228;tze zu einer Entit&#228;t?&#10;- Wer bestimmt &#252;ber &#196;nderungen / Qualit&#228;t etc.?&#10;&#10;Sie entsprechen h&#228;ufig den administrativen Organisationeinheiten (Abteilungen, Busines Units). Sie sind aber nicht aus administrativer oder &#246;rtlicher sondern aus Gesch&#228;ftsaufgabensicht organisiert." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={fb900281-c351-419d-a579-00f0fbf65594}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={9f230d23-4ce9-48d8-9b10-a6a24bfd2e25}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={fcbccf64-081d-4360-b035-aa4eeba16a13}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={9f230d23-4ce9-48d8-9b10-a6a24bfd2e25}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR615_08_888A_4071_8BCC_6B37E4BFB107" name="Name"/>
          <attribute xmi:idref="EAID_ATTR616_70_D159_404D_B6F8_FB055CDFEA7B" name="Beschreibung"/>
          <attribute xmi:idref="EAID_ATTR617_DF_8591_4ECC_8635_3A4CA927E30D" name="AnzName"/>
          <attribute xmi:idref="EAID_ATTR618_5A_54C9_4D09_A9AB_24002BA2245C" name="Zweck"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI256_47_31C0_4D55_B8B4_D42889BE8B28" xmi:type="uml:Class" name="Gesch&#228;ftsereignis" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="18" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:05:22" keywords="ENTI256" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine gesch&#228;ftliche Entscheidung, Vorgabe oder Regel, die dazu f&#252;hrt, dass eine Gesch&#228;ftsfunktion oder ein -Prozess ausgel&#246;st wird. &#10;Bei einem Gesch&#228;ftsereignis ist immer eine Person involviert, die das Ereignis als solches definiert. &#10;Automatisch ausgel&#246;ste Ereignisse sind Gesch&#228;ftszust&#228;nde." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={9eb76076-a96d-4804-bcc3-34d0c0515983}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={0d70dd8e-6b96-4cc3-a548-377bc9e162e5}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={8e116e44-abc6-4c75-b45d-30118cf444b4}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={0d70dd8e-6b96-4cc3-a548-377bc9e162e5}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI383_B1_A3EA_47C2_A384_08CCAD0C5FD4" xmi:type="uml:Class" name="Gesch&#228;ftsprozess" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="19" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:03:22" modified="2022-06-15 18:12:08" keywords="ENTI383" status="Implemented"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein Gesch&#228;ftsprozess umfasst eine Folge von Gesch&#228;ftstransaktion, die in einer bestimmten Abh&#228;ngigkeit ausgef&#252;hrt werden, um ein &#252;bergeordnetes gesch&#228;ftliches oder betriebliches Ziel zu erreichen bzw. eine Gesch&#228;ftsaufgabe zu unterst&#252;tzen oder erf&#252;llen. &#10;Er beginnt immer mit einem Ausl&#246;ser und kann mehrere Entscheidungen und Gesch&#228;fts(Zwischen-)zust&#228;nde umfassen. Am Schluss gibt es ein oder mehrere definierte Zust&#228;nde / Ergebnisse.&#10;&#10;Aus Sicht des Kunden entspricht der Gesch&#228;ftsprozess normalerweise der Customer Journey." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2f90be32-1a31-441d-ae0a-b1a092128a20}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={919418a3-f581-41d1-9bdb-dd6ab6afc0b6}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={eed77607-c949-483a-98a1-cda0ec2942a5}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={919418a3-f581-41d1-9bdb-dd6ab6afc0b6}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR638_05_2745_4346_89B4_21D9AA61F09D" name="Name"/>
          <attribute xmi:idref="EAID_ATTR639_88_A6C1_43BF_9A22_E197A88A3CB8" name="Beschreibung"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI384_A6_DA59_4247_9959_FABC129FDBDB" xmi:type="uml:Class" name="Gesch&#228;ftsregel" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="20" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:04:00" modified="2022-06-15 18:12:08" keywords="ENTI384" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="*Gesch&#228;ftsregel, die Attributwerte auf Regelkonformit&#228;t pr&#252;ft.&#10;Diese Regeln sind passiv. D.h. es wird &#252;berpr&#252;ft, ob der Wert (ggf. im Zusammenhang mit anderen Werten dieser oder anderer Entit&#228;ten) f&#252;r einen stabilen Zustand der Datenbank aus fachlicher Sicht korrekt ist.&#10;&#10;Ebene auf der die Regel pr&#252;ft (row, Tupel, Entit&#228;t, Datenbank) wird aus den Elementen der Regel abgeleitet.&#10;&#10;Regelverletzungen k&#246;nnen als formale Regeln (z.B. SQL Selects) angegeben werden. Jedes Tupel, das das Select liefert verletzt die Regel.&#10;&#10;Die Zuweisung von Regelelementen gibt an, ob dieses Element betroffen ist (gepr&#252;ft, berechnet,...) oder f&#252;r die Ausf&#252;hrung der Aufgabe referenziert wird" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={e406bec5-a2c1-4ab5-b2ff-73dd5aad867f}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={fd340417-c014-43ce-834d-3451546c5381}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={1d295aaa-6915-4246-8594-bd7189f8aafe}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={fd340417-c014-43ce-834d-3451546c5381}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR631_9A_5CFF_4F96_A00E_A173AA767A74" name="Name"/>
          <attribute xmi:idref="EAID_ATTR632_58_7AD1_4A8F_B734_EC80564F3783" name="Beschreibung"/>
          <attribute xmi:idref="EAID_ATTR633_FB_8B80_41EE_B33B_92A755FE3F29" name="Regel"/>
