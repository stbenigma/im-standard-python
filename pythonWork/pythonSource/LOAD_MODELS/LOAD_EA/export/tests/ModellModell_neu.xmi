      <element xmi:idref="EAID_ENTI393_22_9C00_4EBC_8AA0_6E8E6191DE3A" xmi:type="uml:Class" name="Wertebereich" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="45" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:03:22" modified="2022-06-15 18:12:08" keywords="ENTI393" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Beschreibung des Wertebereichs eines (oder mehrerer) Attributs/e oder Columns&#10;&#10;Ein Wertebereich der nicht in einer bestimmten Schnittstelle definiert wurde, ist im allgemein (im IM) defniniert und damit f&#252;r alle (IM und Schnittstellen) verwendbar&#10;&#10;Die Typen Numerisch, Text, Zeitpunkt oder Aufz&#228;hlung sind konzeptionell zu verstehen. Die echten Datentypen und ggf. Formate (f&#252;r Zahlen und Zeitpunkte) f&#252;r die Speicherung werden in der Implementierung festgelegt.&#10;Wertegruppen sind Attributgruppen, d.h. mehrere Attribute, die mehrfach gemeinsam vorkommen  werden f&#252;r eine einfachere Handhabung unter einem neuen Namen zusammengefasst. Beispiel Telefon-Nr bestehend auf Landesvorwahl und Rufnummer." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={fef5d264-6193-48d1-be9d-bd0690669f51}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={8b288426-2808-44e1-9dbd-5a33796ba0ae}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={625b606e-952b-43f5-8959-747aabede6c5}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={8b288426-2808-44e1-9dbd-5a33796ba0ae}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR697_15_780E_4372_8422_42A63F7F82FE" name="Name"/>
          <attribute xmi:idref="EAID_ATTR698_37_2F3E_4F9E_8E65_B9CEA1AA7A21" name="Beschreibung"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI394_1A_136E_4B0A_8199_0DEC29A6C09E" xmi:type="uml:Class" name="Wertebereichgruppe" scope="public">
        <model package="EAPK_B84883B7_A10A_44C2_9450_84582C07A0F7" tpos="0" ea_localid="46" ea_eleType="element"/>
        <project author="stb" created="2020-02-03 20:04:00" modified="2022-06-15 18:12:08" keywords="ENTI394" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Es gibt Attribute, die aus mehreren Bestandteilen bestehen, aber f&#252;r eine Entit&#228;t wie ein Attribut angesehen werden (k&#246;nnen).&#10;Die Bestandteile dieser Attributgruppe treten immer gemeinsam auf.&#10;Dass ein Attribut Teilwerte enth&#228;lt, f&#252;r die man sich separat interessiert, verletzt im Grundsatz die 1. Normalform. Wenn aber die Elemente einer Attributgruppe selber Attribute sind und die Gruppe als Platzhalter von mehreren Attributen verstanden werden kann, ist diese Verletzung aufl&#246;sbar." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={31747e44-1058-4948-9749-c329a3f60a93}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={de56c7ac-371a-4e30-9d60-d006da1ac2f6}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={55d92aa4-6103-40f1-8377-9073f23381f0}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={de56c7ac-371a-4e30-9d60-d006da1ac2f6}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
