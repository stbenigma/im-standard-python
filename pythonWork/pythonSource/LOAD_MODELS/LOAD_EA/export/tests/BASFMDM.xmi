      <element xmi:idref="EAID_ENTI170_B5_A152_47EC_A890_8B843D47F682" xmi:type="uml:Class" name="Supplied Product Batch" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="161" ea_eleType="element"/>
        <project author="stb" created="2019-07-04 09:01:04" modified="2022-06-16 08:58:18" keywords="ENTI170" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="In einem zeitlichen zusammenhang produziertes Material.&#10;Hat unter homogenen Gegebenheiten stattgefunden.&#10;&#10;Eine Charge kann die Lieferung sein oder die Lieferanten-Charge (Herstellbedingungen) &#10;&#10;Chargen sind lagerf&#228;hig und werden weiter ber&#252;cksichtigt (Qualit&#228;t)&#10;oder sie werden nach der Lieferung gemischt und gemittelt.&#10;&#10;Die echten St&#252;ckzahlen / Mengen die hergestellt wurden bzw. die einzel verfolgbaren Einheiten sind in den Beziehungen zwischen Charge und Produkt / Lieferantenartikel verwaltet.&#10;&#10;Die Chargen(-mengen) m&#252;ssen im ganzen Modell &#252;ber die ganze Verarbeitungs-/Verpackungs-/Verkaufs-kette mitgef&#252;hrt werden k&#246;nnen.&#10;(Nachvollziehbarkeit, Beweisbarkeit, Kontrollen)." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={6377ddfd-192e-4b2d-996f-260bfbd4514f}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d06c42e6-3c36-490f-801e-8660fab014f0}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={526cd507-607a-45b6-b148-f383ad1d9d15}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d06c42e6-3c36-490f-801e-8660fab014f0}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
