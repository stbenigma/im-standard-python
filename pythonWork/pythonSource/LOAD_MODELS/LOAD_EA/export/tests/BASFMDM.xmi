        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="what the customer wants to buy/use in the first place&#10;&#10;Coatings calls a material an article when it is packaged, without packaging it is a product.&#10;&#10;Same BI &#10;&#9;once kosher, once not kosher&#10;&#9;once food grade once industrial grade (carbon dioxide for Coca-Cola)&#10;&#9;once one of the ingredients is registered only for France, once for all&#10;&#9;Hydrochloric acid as BI, 20%, 40% and 60% hydrochloric acid are products&#10;&#10;Proposal for name: unpacked product&#10;also loose product?&#10;&#10;Was called until 22.7. Product  (PBG)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
