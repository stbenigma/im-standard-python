      <element xmi:idref="EAID_ENTI62_AE0_5A6D_4B6C_8854_A276DABE0AE0" xmi:type="uml:Class" name="Customer Steering Classification" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="53" ea_eleType="element"/>
        <project author="stb" created="2021-06-15 12:35:35" keywords="ENTI62" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="used for creation/allocation of segments.&#10;Can lead to rules (especially on service level) for controlling the processes (partly informative, partly hard rule usage; e.g. exclusion of delivery of small quantities, change of delivery date)&#10;Customer Classification is used for the allocation of segments, also used for evaluations, purely informative.&#10;&#10;Values can be derived from other classification or Sales figures. Assignement is always done (decided) by people.&#10;&#10;Service Level is derived from Need Base and Customer Attractiveness&#10;Customer Attractivenes (A/B/C) can be determined by sales volume.&#10;&#10;Examples&#10; Customer Attractivness  - Level A / B / C&#10; Value chain   - end customer&#10; Need base (Prize buyer)&#10; Strategic Account (key account)&#10; Service Level" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={19c1ea5f-1fa6-445f-ac8a-44a120a936a7}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={34a6f518-0066-4cf2-9c9a-9b98acc065df}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={2847f1ad-653c-4ab5-bc88-6bb7a9939165}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={34a6f518-0066-4cf2-9c9a-9b98acc065df}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
