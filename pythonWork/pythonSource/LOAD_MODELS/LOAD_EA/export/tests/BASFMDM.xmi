      <element xmi:idref="EAID_ENTI217_C2_69D5_48EE_B281_E0B6E7DF083E" xmi:type="uml:Class" name="Kit" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="79" ea_eleType="element"/>
        <project author="stb" created="2019-07-03 13:46:59" modified="2022-06-16 08:58:18" keywords="ENTI217" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="KIT in der BASF wird nicht zusammen verpackt. KIT ist ein set ohne Sekund&#228;rverpackung. Ein KIT hat nie einen Bestand. Vertriebsorientiert. KIT ist ein Verkaufsartikel der aus verschiedenen anderen Verkaufsartikeln besteht, die aus marketingtechnischen oder anderen nicht zwingenden Gr&#252;nden (Anwendung) gemeinsam kombiniert werden.&lt;br/&gt;&lt;br/&gt;Ein Kit muss nicht als Einheit verschickt werden.&lt;br/&gt;Ein Kit kann Handelsware (auch No-Touch) enthalten, die zum gleichen Verkauf geh&#246;rt, aber nicht von BASF geliefert wird.&lt;br/&gt;&lt;br/&gt;Kit hat eine MaterialNr, gemeinsam verrechnete Ware mit ggf. einem Rabatt auf der Gesamtsendung&lt;br/&gt;&lt;br/&gt;Beispiel: &lt;br/&gt;Farbb&#252;chsen mit Spezialwerkzeug um sie zu &#246;ffnen.&lt;br/&gt;" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={8be8fe2f-46c3-43e8-b9b2-87fc465f1857}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d733f007-6338-4f52-81db-aa44b21ba477}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={36de7062-4496-4d93-8d49-76680e78166e}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d733f007-6338-4f52-81db-aa44b21ba477}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
