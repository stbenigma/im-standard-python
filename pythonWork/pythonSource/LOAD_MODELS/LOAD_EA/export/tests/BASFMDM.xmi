      <element xmi:idref="EAID_ENTI172_CD_C6FE_4656_9A17_256F9E7D629A" xmi:type="uml:Class" name="Supplier Article" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="163" ea_eleType="element"/>
        <project author="stb" created="2019-07-23 13:25:48" keywords="ENTI172" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Artikel eines bestimmten Lieferanten, mit dessen Angaben.&#10;&#10;Dieser Artikel kann mehr oder andere Informationen besitzen als die chemischen Produkte die BASF dazu verwaltet:&#10;Beispiel; Qualit&#228;tsmerkmale, Herstellorte, Farbe, etc.&#10;Der Prozess, der aus ggf. mehreren Lieferantenartikel ein zusammengefasstes Chemisches Produkt macht, in dem nur die f&#252;r wichtigsten Eigenschaften verwaltet werden, muss genau beschrieben sein. &#10;Die Detailinformation des Lieferanten wird ggf. in Spezialprozessen (Nachverfolgbarkeit, Embargos, Qualit&#228;tsanspr&#252;che etc.) verwendet und muss als Zusatzinformation zum Chemischen Produkt verwaltet werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={b46f47d7-0e2a-45f0-b701-fffd6c8b0f77}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={72d5a73c-ad2f-4132-be48-89ac4fab0fad}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={69ef04c3-217d-43c7-87e7-d57926ef9750}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={72d5a73c-ad2f-4132-be48-89ac4fab0fad}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
