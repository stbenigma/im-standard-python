        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Sustainable Material Attributes are a knapsack of specific attributes for sustainable raw materials of different types for different certification standards and different Mass Balance Systems&#10;&#10;The set of attributes depends on the raw material type (Feedstock Characteristic)&#10;There are roughly 10-20 different attribute-sets.&#10;&#10;Massenbilanz-system: &#10;BMB,  Biomasse Recycled, Gr&#252;nstrom&#10;Zertifizierungsstandard: REDcert2&#10;Feedstock type: Biomethane&#10;&#10;&#10;Examples&#10;Palm&#246;l frei (J/N)&#10;PCF &#10;Biogenic C content&#10;Bio-Naphta &#10;pyrolysis oil&#10;biogas" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
