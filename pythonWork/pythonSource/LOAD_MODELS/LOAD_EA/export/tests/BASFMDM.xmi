      <element xmi:idref="EAID_ENTI115_CF_BA82_41D3_BA54_9BF3B606FD8B" xmi:type="uml:Class" name="OD specific Business Relationship" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="106" ea_eleType="element"/>
        <project author="stb" created="2021-06-10 12:31:09" keywords="ENTI115" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="OD-specific relationship between Business Partners (direc customers and others) in different roles (account group type).&#10;&#10;The owner of a Business Relationship must have the SOLD-TO Role and is called Top Node.&#10;&#10;is either automatcially derived from Sales Order (Automated Bus. Relationship)&#10;or manally maintained / defined by OD as an Additional Bus. Relationship or a supplementary Bus. Relationship&#10;&#10;&#10;Example&#10;VW ist Top Node&#10; 3 partners are subcontractors / suppliers for VW (they do not have to be VW owned) and act in different roles (ship-to, payer etc.)&#10; credit is given to or order-parameter are negotiated with the top node, but real handling (order, shipping, paying) is done by leave nodes.  &#10;Brake fluid developed for VW. Turnover should be allocated to VW independent of other customer ordering&#8203;&#10;Business Case: Turnover for one product should be allocated to the defined BP Hierarchy independent of sold-to, ship-to, turnover &#8230;. &#10;&#10;&#10;Base of this relationship  (Automated Bus. Relationshiop) can be determined from sales order customers and legal ownership relations.&#10;The final relationship can be maintained by a OD as Manual Bus. Relationship" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={8f4f48f7-5f03-4b08-880c-184336683f62}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d2c23cae-052c-4caa-ad9f-caf5e4ab06d3}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={da3ab294-aafa-45e0-8b22-b1b501e02b55}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d2c23cae-052c-4caa-ad9f-caf5e4ab06d3}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
