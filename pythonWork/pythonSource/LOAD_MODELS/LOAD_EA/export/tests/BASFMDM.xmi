      <element xmi:idref="EAID_ENTI10_DE6_5827_497C_90BC_6827F536518C" xmi:type="uml:Class" name="Account Group" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="1" ea_eleType="element"/>
        <project author="stb" created="2021-06-08 12:54:46" keywords="ENTI10" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Account group defines which business relations customer is allowed to perform&#10;&#10;from Guidelines p 17&#10;&#10;When creating a master record for a customer or a vendor, an account group &#10;needs to be assigned. An account group bundles a set of partner roles assigned to &#10;a business partner. With this, the account group basically determines&#10;&#8226; Which partner roles in terms of rights and responsibilities the customer / &#10;vendor can adopt in the E2E business processes&#10;&#8226; Which screens and fields are relevant for master data input, i.e. are relevant to describe the customer / vendor appropriately (&#8220;fit-for-purpose&#8221;)&#10;&#8226; Which data entries are mandatory, which are optional&#10;In addition, for vendor master records only, the account group determines whether &#10;there are any other data retention levels below the purchasing organization level &#10;(for example, site or vendor sub-range level) at which data can be retained in the &#10;vendor master, and if so, what these are.Page 18 of 62 &#10;Guidelines for Central Business Partner Master Data : &#10;Version: 1.0" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={d844c571-ffc1-4143-85f9-1be038e98840}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={7e9e2768-611e-4f8f-b41f-1365659f829f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={a0c36231-8b8b-4850-a69a-850520d59b74}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={7e9e2768-611e-4f8f-b41f-1365659f829f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
