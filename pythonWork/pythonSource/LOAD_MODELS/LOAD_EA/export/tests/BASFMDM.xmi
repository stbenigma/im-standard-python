      <element xmi:idref="EAID_ENTI71_1BA_5BCF_4688_BB8B_6CDEF598F9A5" xmi:type="uml:Class" name="Division" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="62" ea_eleType="element"/>
        <project author="stb" created="2021-06-08 13:38:21" keywords="ENTI71" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="DE: Sparte &#10;SAP Definition: A way of grouping materials, products, or services. The system uses divisions to determine the sales areas and the business areas for a material, product, or service&#10;Use: A product or service is always assigned to just one division. From the point of view of sales and distribution, the use of divisions lets you organize your sales structure around groups of similar products or product lines. This allows the people in a division who process orders and service customers to specialize within a manageable area of expertise.&#10;Example: If a sales organization sells food and non-food products through both retail and wholesale distribution channels, each distribution channel could then be further split into food and non-food divisions.&#10;&#10;Only used by one Operating division (EC).&#10;All other users use a dummy entry &quot;general  01&quot;" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={461c7b9d-7dc4-485a-8be1-e39d78acff74}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={d6a92c74-d11a-4153-bbf5-b6a84f7d724e}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={caf27492-16e6-4570-a751-af2e900136c8}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={d6a92c74-d11a-4153-bbf5-b6a84f7d724e}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI211_24_D4C8_4EA3_8376_A7BF0790EDD5" xmi:type="uml:Class" name="Einzelverkaufsartikel" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="63" ea_eleType="element"/>
        <project author="stb" created="2019-07-03 13:34:05" modified="2022-06-16 08:58:18" keywords="ENTI211" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein Einzelartikel der in bestimmten Mengen verkauft wird und damit eine EAN und einen Preis hat.&lt;br/&gt;Im Fall, dass der Einzelartikel als 1 St&#252;ck verkauft wird, ist es Verkaufsartikel mit Menge 1&lt;br/&gt;&lt;br/&gt;Verkaufsgebinde k&#246;nnen (heute) nicht-chemische Handelsware als Zusatz enthalten (draufgeklebt).&lt;br/&gt;&lt;br/&gt;Beispiele:&lt;br/&gt; - 1 Dose Farbe (identisch mit dem verkaufbaren Artikel)&lt;br/&gt; - Kiste mit 6 Spraydosen, die nur als Palette mit 20 Kisten drauf verkauft wird.&lt;br/&gt; - 1 6er Pack Wasser, das in ein Tragpaket zusammengeschweisst ist." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
