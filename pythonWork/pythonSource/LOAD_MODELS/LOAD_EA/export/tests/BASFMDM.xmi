        <properties documentation="Consolidated list of all ingredients (from all bill of material) in a product.&#10;&#10;ONLY used for ISM purposes.&#10;Also called &quot;Connectivity&quot;, the connection between the product and the sustainable raw material. &#10;Proof in a picture / list that this product has a link to the raw material, documented in the consolidated parts list. &#10;For this mass balance calculation, this bill of material must contain sustainable raw materials." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
