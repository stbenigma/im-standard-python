        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Potential customer&#10;&#10;Once a Sales Employee has qualified a person or a company as matching certain criteria (e.g. requirements match BASF product portfolio), appropriate marketing activities are being started and monitored within the M2O process. &#10;To this end, a prospect account is created in a CRM system, not in the master data reference system (MDG) &#10;&#10;A e.g. supplier is a business Partner and can be also a prospect.&#10;&#10;Are prospects always in relation to a product / projects / articles / campaign?&#10;=&gt; CRM -&gt; yes connected with products / articles&#10;=&gt; SAP -&gt; No not connected" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={392e26a0-e920-4fe4-ba24-175bfc4f19e7}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={3a276629-903d-4f48-9dbb-936e68813a85}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={de4a69fa-7aa9-4ec3-ac5c-0f49ac1224ae}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={3a276629-903d-4f48-9dbb-936e68813a85}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
