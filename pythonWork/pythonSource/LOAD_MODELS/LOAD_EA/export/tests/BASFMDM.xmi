        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Person in a  company with whom we are in contact by telephone, mail, or in person to perform business activities&#10;&#10;In MDG, a contact is assigned only to one business partner. Multiple assignments are not supported.&#10;A business partner can have multiple contacts assigned&#10;&#10;In SF, &#10;one contact can be assigned to multiple business partners / customers (direct and/or indirect).&#10;A business partner / customer (direct and/or indirect) can have multiple contacts assigned.&#10;&#10;&#10;22.6.2021: Name changed from Contact Person to Company Person" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
