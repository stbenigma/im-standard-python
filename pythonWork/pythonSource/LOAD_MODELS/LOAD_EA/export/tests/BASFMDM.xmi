        <project author="stb" created="2021-06-01 12:42:00" keywords="ENTI40" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Combines several business scopes, direct customers and prospects into a business responsibility.&#10;&#10;Overlapping responsibilites are resolved by algorithms and rules .&#10;e.g Global Product Manager is responsible for Product Areaa (SBU), Product manager is responsible for several named products.&#10;A rule states, wether lower level responsibilites are to be excluded from higher level repsonsiblity or declare this overalpping as invalid.&#10;Or a system with detailed inclusion / exclusion of responisibilites has be built.&#10;&#10;In the CER-Workpackage (Hagen) a Business Responsibility MUST cover at least one Busines Scope" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
