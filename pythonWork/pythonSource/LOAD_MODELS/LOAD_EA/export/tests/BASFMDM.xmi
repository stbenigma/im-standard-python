        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Synonym subgroup&#10;&#10;eMail Achim Kugel 8/20/2019&#10;First aggregation level of materials; unique assignment to product area.&#10;The alpha code as an element of the reporting hierarchy is indeed globally defined.&#10; &#10;eMail Achim Kugel 8/20/2019&#10;The ownership agreements on the single material always require a global comprehensive alpha code assignment;&#10;All further ownership agreements regarding stock, turnover and sales are assigned as well-defined exceptions; i.e. with organization parameters such as sales organization, company code, plant, storage location from which it is clear under which circumstances they are valid.&#10;To accommodate this idea in the model, one could indeed speak of global alpha code; as a counterpart, I would not speak of regional alpha code, but rather of exception alpha code." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={78d2a67e-aa18-4a12-ae10-bc0bedcdf300}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={59432588-be69-4a4e-b5d0-496b4b34e69f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={0155b945-3517-48cb-94d1-664159bf5fa2}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={59432588-be69-4a4e-b5d0-496b4b34e69f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
