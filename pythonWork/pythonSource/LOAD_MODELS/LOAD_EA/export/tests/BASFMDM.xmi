      <element xmi:idref="EAID_ENTI177_8D_05CB_421C_A0C8_2CE4A828EEF5" xmi:type="uml:Class" name="Technisches Material" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="168" ea_eleType="element"/>
        <project author="stb" created="2019-07-04 07:49:44" keywords="ENTI177" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Pumpen, Reaktor, Schrauben, Kopierpapier&lt;br/&gt;u.a. Ersatzteil&lt;br/&gt;&lt;br/&gt;Prinzipiell / potenziell problematische Artikel, sind Materialien die nicht in das Produkt eingehen aber trotzdemn chemisch sind aber trotzdem in der Produktion genutzt werden. &lt;br/&gt;Beispiel &lt;br/&gt;Motor&#246;r, das zum Betrieb erforderlich ist, aber normalerweise nicht in das Produkt eingeh.&lt;br/&gt;Reinigungsmittel wird als technisches Material angelegt und in der Produktion verbraucht, ist aber eine Chemikalie.&lt;br/&gt;Schwefels&#228;ure-Bad f&#252;r die Herstellung, die Schwefels&#228;ure wird aber nie als gef&#228;hrlich markiert/erkannt.&lt;br/&gt;" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
