      <element xmi:idref="EAID_ENTI68_916_F56D_4AC3_BB72_EF9821C68A3B" xmi:type="uml:Class" name="Direct Customer" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="59" ea_eleType="element"/>
        <project author="stb" created="2021-05-27 06:04:14" modified="2022-06-16 08:58:18" keywords="ENTI68" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Customer with whom BASF has direct business.&#10;Purchases directly from one or more business units&#10;&#10;Is available as customer account in the master data reference system (MDG).&#10;Direct customers with owning hierarchy of their legal entity must have the roles (account group type) SOLD-TO or PAYER.&#10;&#10; Customer can only belong to one account group at a time, assigned by algorithm; can be manually &quot;upgraded&quot; (up- easier than downgrade)&#10;Account group defines which business relations customer is allowed to perform" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={3fad83ff-43e2-4327-ac3b-49bf1a7d6d6b}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={48b2da94-6eaa-496e-af81-1dfe5c8fc54c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={8fc6ab9d-54ea-45e3-a9c5-35faeeb1836a}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={48b2da94-6eaa-496e-af81-1dfe5c8fc54c}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
