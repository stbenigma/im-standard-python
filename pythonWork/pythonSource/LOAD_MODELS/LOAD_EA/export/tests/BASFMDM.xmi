      <element xmi:idref="EAID_ENTI163_00_6F76_4F49_9DC0_852EA1D14BB0" xmi:type="uml:Class" name="Sales Order Customer" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="154" ea_eleType="element"/>
        <project author="stb" created="2021-06-10 12:12:46" keywords="ENTI163" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Customer in a specific role in a sales order.&#10;&#10;Per Sales Order only one role can be (and one role must be) SOLD-TO. This is the customer who legally placed the order and must be a third party (non-BASF Legal Entity).&#10;(Internal Orders are treated somewhere else.)&#10;&#10;customer must have respective role he plays in an sales order according to account group model&#10;&#10;Maintained in OCEAN = application for customer reporting in BW??&#10;This information is used as Enrichment Transactional Data  in the new concept.&#10;&#10;Example&#10;for one order:&#10;   T&#252;mmerlein Werke is SOLD-TO  and Turnover &#10;   Unterwerk b&#246;blingen  is SHIP-TO&#10;   Verrechnungs-GmbH Frankfurt is PAYER&#10;   =&gt; 3 entries as sales order customers for one order" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={9b570c9a-03bc-4edd-9055-45b652bf55eb}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={f5d88bfc-6522-42b4-a057-91a5288aa5ac}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={42fce763-8ebb-4e0a-9fed-d7f6ff83ef91}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={f5d88bfc-6522-42b4-a057-91a5288aa5ac}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
