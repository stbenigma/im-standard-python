        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Legal Entities  people of a legal nature who receive/d or consume/d products (goods or services) from BASF&#10;&#10;&#10;Direct and indirect customer currently created in different systems (MDG, CRM)&#10;&#10;&#10;Customers can define a Buying Center:&#10;Organization for purchasing at the customer's site (buying BASF products), which has purchasing responsibility for a specific area and is managed by BASF (exists only at large customers/companies)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
