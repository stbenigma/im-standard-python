        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="mehrere (mind. 2) fest definierte (nicht alles gleiche) Verkaufsartikel die zusammen verpackt und verkauft werden.&lt;br/&gt;&lt;br/&gt;Ein Multiartikelset besteht aus mehreren Einzelartikeln, die aus Gr&#252;nden der Anwendung oder des Marketings gemeinsam verkauft werden.&lt;br/&gt;&lt;br/&gt;&lt;br/&gt;Beispiel:&lt;br/&gt;  - Farbe und Pinsel und Abstreifgitter&lt;br/&gt;  -" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
