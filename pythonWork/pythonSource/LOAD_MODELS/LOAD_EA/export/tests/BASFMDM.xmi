      <element xmi:idref="EAID_ENTI219_36_EBA9_43B8_B2D6_C1DAD2345080" xmi:type="uml:Class" name="Mehrkomponente Set" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="93" ea_eleType="element"/>
        <project author="stb" created="2019-07-03 13:34:56" modified="2022-06-16 08:58:18" keywords="ENTI219" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Mehrere Einzelartikel die gemeinsam in einem vordefinierten Verh&#228;ltnis in unabh&#228;ngigen Prim&#228;verpackungen verkauft wird.&lt;br/&gt;&lt;br/&gt;Ein Multikomponentenprodukt das z.B. in einer Prim&#228;rverkapckung steckt (z.B. Kanister mit 2 Kammern) ist kein Multikomponentenprodukt. Es ist ein verpackter Artikel in einer Prim&#228;rverpackung.&lt;br/&gt;&lt;br/&gt;Beispiele:&lt;br/&gt;- Kleber 1 Tube H&#228;rter und 1 Tube Grundmaterial&lt;br/&gt;- Haarf&#228;rbemittel ist Grundmasse und Farbe" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={970ed6cf-ab14-47d6-b457-7b4103d1eb56}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={0949fba2-5f10-4336-8e5c-fae9c9928120}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={7e28cae2-f946-403e-9e47-93aef418fc63}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={0949fba2-5f10-4336-8e5c-fae9c9928120}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI103_C5_7B0A_46BB_BB91_52C48513E942" xmi:type="uml:Class" name="Mehrkomponentenprodukt / Anweisung (?)" scope="public">
        <model package="EAPK_A094FDF8_4DBE_4176_AE94_D4C3BA7D0B5E" tpos="0" ea_localid="94" ea_eleType="element"/>
        <project author="stb" created="2019-07-03 13:27:48" keywords="ENTI103" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="2 oder mehr Verkaufsprodukte die nur zusammen verkauft werden, da man ein bestimmtes Mischungsverh&#228;ltnis ben&#246;tigt. &#10;Das Mehrkomponentenprodukt (St&#252;ckliste) ist quasi das Rezept f&#252;r mehre Produkte&#10;&#10;Mit Angabe &#252;ber z.B. Mischverh&#228;ltnis der Komponenten&#10;&#10;Multikomponenten k&#246;nnen auch in 1 Gebinde mit mehreren Kammern verpackt werden.&#10;&#10;Bsp: &#10;Grundmasse und H&#228;rter f&#252;r 2 Komponentendichtung &#10;&#10;Vorschlag f&#252;r andere Namen&#10;- Handlungsanweisung&#10;- Zusammensetzung Abh&#228;ngigkeit&#10;Statt Mehrkomponentenprodukt" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={cd5c260c-15f4-46de-a54a-ebee2863fe45}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={70dec93e-0f88-4fc6-a5fa-200d0c93dd32}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={179d62b4-499e-4209-b0ec-c82cfb1f86a3}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={70dec93e-0f88-4fc6-a5fa-200d0c93dd32}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR414_73_DA12_497B_8B1F_88CCA534733F" name="Mengenverh&#228;ltnis"/>
          <attribute xmi:idref="EAID_ATTR415_7D_F7EE_45D7_9DC2_B21B18CBB4C3" name="Anwendungsregeln"/>
        </attributes>
      </element>
