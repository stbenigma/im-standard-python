        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein Masterbeitrag ist der sprachunabh&#228;ngige Teil eines Beitrages. Er enth&#228;lt alle Beitragselemente, die in allen abh&#228;ngigen Sprachbeitr&#228;gen vorkommen. Falls ein Beitrag (z.B. ein Logo) gar keine Sprachbeitr&#228;ge kennt, ist der Masterbeitrag der einzige Beitrag." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
