        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ersatzteil, das selber ein Verkaufsartikel ist und bestellt / verkauft werden kann.&#10;Ist nich gleich zu setzen mit Konzernartikelart &quot;Ersatzteil&quot;, da alle Typen von Konzernartikelart ein Ersatzteil sein k&#246;nnen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
