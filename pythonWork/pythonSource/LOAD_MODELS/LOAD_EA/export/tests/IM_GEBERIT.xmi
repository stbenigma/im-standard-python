      <element xmi:idref="EAID_ENTI175_13_170A_40EA_9CF9_46F119E54717" xmi:type="uml:Class" name="Ersatzteiltafel" scope="public">
        <model package="EAPK_75C28C79_47EF_4B74_98AB_510388BF2706" tpos="0" ea_localid="56" ea_eleType="element"/>
        <project author="nicolasschweiger" created="2020-02-21 11:15:24" keywords="ENTI175" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Zusammenstellung einer Ersatzteilgruppe, die gemeinsam f&#252;r mehrere Produkte / Verkaufsartikel genutzt werden kann.&#10;Enth&#228;lt ein typisches Bild des Verkaufsartikels zusammen mit den Ersatzteilen. &#10;&#10;Kann auch weitere Ersatzteiltafeln enthalten: &#10;Beispiel: Eine Funktionsgruppe ist ein  Ersatzteil f&#252;r ein Aquaclean Tuma Comfort, hat aber selber auch Ersatzteile.&#10;&#10;Business Rule: Es gibt keine Ersatzteiltafel ohne St&#252;ckliste. Mindestens ein Handels&#252;bliches Ersatzteil oder Ersatzteil muss aufgef&#252;hrt sein." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2c9e1a96-826d-423d-b574-10f8ef4c6eed}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={0fc8e4e0-abb3-4883-8312-ed65c5624d75}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={e0be8561-6653-42ef-8f70-79d594833cc4}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={0fc8e4e0-abb3-4883-8312-ed65c5624d75}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
