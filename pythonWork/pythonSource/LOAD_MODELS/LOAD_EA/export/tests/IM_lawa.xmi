      <element xmi:idref="EAID_ENTI55_893_D468_4670_B27D_6512E8C941E8" xmi:type="uml:Class" name="Ganzjahresbetrieb" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="25" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 09:32:58" modified="2022-06-15 18:12:00" keywords="ENTI55" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff Ganzjahresbetrieb leitet sich ab vom Begriff Betrieb gem&#228;ss LBV SR910.91 Art. 6 Betrieb&#10;&#10;Als Ganzjahresbetrieb gilt (LBV SR910.91 Art. 6 Betrieb) wer:&#10;- Pflanzenbau oder Nutztierhaltung oder beide Betriebszweige betreibt;&#10;- eine oder mehrere Produktionsst&#228;tten umfasst;&#10;- rechtlich, wirtschaftlich, organisatorisch und finanziell selbst&#228;ndig sowie unabh&#228;ngig von anderen Betrieben ist;&#10;- ein eigenes Betriebsergebnis ausweist;&#10;- w&#228;hrend des ganzen Jahres bewirtschaftet wird.&#10;&#10;In der DZV Verordnung SR910.13 Artikel 2 umfasst der Begriff &quot;Ganzjahresbetrieb&quot; auch die Betriebsgemeinschaften. Die  Koordinaten definieren die Hauptproduktionsst&#228;tte des Betriebes ( LBV SR910.91 Artikel 6 Absatz 2) und den Hauptstandort der Nutztierhaltung ( LBV SR910.91 Artikel 11). Umfasst ein Betrieb mehr als eine Produktionsst&#228;tte, so gilt als Betriebszentrum der Ort, an dem sich das Hauptgeb&#228;ude oder das Schwergewicht der Betriebst&#228;tigkeit befinden (LBV SR910.91 Artikel 6 Abschnitt 3).&#10;&#10;Landwirtschaftsbetriebe sind Registerdaten und m&#252;ssen an den Bund (AGIS) &#252;bermittelt werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={732ed867-1064-4852-a8b4-e97400899281}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={f976bc08-f982-48f4-93a9-fc31bea784db}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={2b5cbba0-9350-4b34-b839-e1ae685593ce}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={f976bc08-f982-48f4-93a9-fc31bea784db}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI56_BE0_2FBF_41BD_BDE1_C76DF3927548" xmi:type="uml:Class" name="Gemeinde (eCH0007)" scope="public">
