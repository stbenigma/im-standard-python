      <element xmi:idref="EAID_ENTI121_02_0F5A_411A_B43D_48E7BA61DAF4" xmi:type="uml:Class" name="S&#246;mmerungsbetrieb" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="91" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 09:04:52" modified="2022-06-15 18:12:00" keywords="ENTI121" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff definiert  den Standort des S&#246;mmerungsbetriebs nach LBV SR910.91 Art. 9. Beim Standort handelt es sich gleichzeitig um eine tempor&#228;re Nutztierhaltung (LBV SR910.91 Artikel 11). Der S&#246;mmerungsbetrieb erh&#228;lt eigene Koordinaten und eine separate TVD-Nummer.&#10;&#10;Als S&#246;mmerungsbetrieb gilt nach LBV SR910.91 Art. 9&#160;ein landwirtschaftliches Unternehmen,&#160;das:&#10;&#160;&#10;a) der S&#246;mmerung von Tieren dient;&#10;b) von den Betrieben der Best&#246;sser &#246;rtlich getrennt ist;&#10;c) S&#246;mmerungsweiden (Art. 26) aufweist;&#10;d) &#252;ber Geb&#228;ude oder Einrichtungen verf&#252;gt, die f&#252;r die S&#246;mmerung n&#246;tig sind;&#10;e) w&#228;hrend der S&#246;mmerung bewirtschaftet wird; und&#10;f) von andern S&#246;mmerungsbetrieben unabh&#228;ngig ist.&#160;Ein S&#246;mmerungsbetrieb mit mehreren Stufen gilt als nur ein S&#246;mmerungsbetrieb." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={ba6ab91e-c39b-45f2-97cd-d4ded3137372}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={493034ac-77d7-4506-ac17-5ee669d00347}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={c5daec91-8b94-4fec-90ed-dccec98e9d40}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={493034ac-77d7-4506-ac17-5ee669d00347}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI122_3A_1CC8_4E46_A6AB_A01C41C98AAD" xmi:type="uml:Class" name="S&#246;mmerungstierkategoriebestand" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="92" ea_eleType="element"/>
        <project author="Markus" created="2022-04-20 13:22:28" keywords="ENTI122" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Fasst den Tierbestand einer bestimmten Kategorie auf einem S&#246;mmerungsbetrieb zusammen. Die Merkmale sind in B.1.3 im Merkmalskatalog beschrieben. Die m&#246;glichen Tiercodes sind in C.3 aufgelistet." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={67267d61-5906-44b0-9a7d-865122dcc9b6}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={221e8d8c-de25-47f8-ae7b-88f6c8d08273}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={21ff5786-b863-4dbe-8c5b-db775bb487fd}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={221e8d8c-de25-47f8-ae7b-88f6c8d08273}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI123_E8_7FB6_4E62_A3D8_B8B1743CE88B" xmi:type="uml:Class" name="TVD-Tierart" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="93" ea_eleType="element"/>
        <project author="Markus" created="2022-03-11 09:25:41" keywords="ENTI123" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff definiert die Tierarten, welche auf Registerdatenebene bei Nutztier- oder Hobbytierhaltung schweizweit angegeben werden m&#252;ssen.&#10;&#10;Je nach Tierart ist eine Registrierung des Standortes bei der Tierverkehrsdatenbank notwendig. Klautentiere und Equiden brauchen eine TVD-Nummer. Bei der Gefl&#252;gelhaltung kommt es auf die Anzahl Gefl&#252;gel darauf an. Die Hobbytierhaltung von Gefl&#252;gel braucht keine TVD-Nummer.&#10;&#10;Tierarten nach TVD, welche auf der Nutztier- bzw. Hobbytierhaltung  gehalten werden:&#10;&#10;- Rindvieh&#10;- Schweine&#10;- Schafe&#10;- Ziegen&#10;- Kamelien&#10;- Wild&#10;- Pferde&#10;- Fische&#10;- Gefl&#252;gel&#10;- Bienen&#10;&#10;Die Daten werden an AGIS &#252;bermittelt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
