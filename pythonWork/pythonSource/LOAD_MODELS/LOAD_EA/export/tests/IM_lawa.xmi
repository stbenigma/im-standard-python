      <element xmi:idref="EAID_ENTI133_22_3BCF_4112_A6D9_0EDC459F521E" xmi:type="uml:Class" name="Betriebsgemeinschaft" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="7" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 08:33:03" modified="2022-06-15 18:12:00" keywords="ENTI133" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Betriebsgemeinschaften sind der Zusammenschluss von mehreren Landwirtschaftsbetrieben und gelten als ein Landwirtschaftsbetrieb, wenn:&#10;&#10;- die Zusammenarbeit in einem schriftlichen Vertrag geregelt ist;&#10;- die Bewirtschafter und Bewirtschafterinnen die Betriebsgemeinschaft gemeinsam auf eigene Rechnung und Gefahr f&#252;hren und damit das Gesch&#228;ftsrisiko tragen;&#10;- die Bewirtschafter und Bewirtschafterinnen der beteiligten Betriebe f&#252;r die Betriebsgemeinschaft t&#228;tig sind und nicht mehr als 75 Prozent ausserhalb der Betriebsgemeinschaft arbeiten;&#10;- die Betriebszentren der beteiligten Betriebe innerhalb einer Fahrdistanz von h&#246;chsten 15 km liegen; und&#10;- jeder der beteiligten Betriebe vor dem Zusammenschluss einen Mindestarbeitsbedarf von 0.20 SAK erreicht.&#10;&#10;Die Betriebsgemeinschaften sind Registerdaten und m&#252;ssen an den Bund (AGIS) &#252;bermittelt werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={ab198f5c-59c0-4826-8bd7-0c1dc6db7106}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={0b7b5c84-91d3-4a0d-b425-edbbfdc23312}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={5cdba406-c850-4ee9-abb5-98856a9f3bc9}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={0b7b5c84-91d3-4a0d-b425-edbbfdc23312}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI38_36C_D179_4FA9_A289_F3B262AF19DE" xmi:type="uml:Class" name="Betriebsinformation" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="8" ea_eleType="element"/>
        <project author="Markus" created="2022-04-20 13:30:01" keywords="ENTI38" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Enth&#228;lt die Angaben zu den allgemeinen Betriebsdaten, welchen ein z&#228;hlbarer Wert zugeordnet wird.  Die Merkmale sind in B.1.1 im Merkmalskatalog beschrieben. Die m&#246;glichen Codes sind in C.1 aufgelistet." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={9a4fa3e5-19dd-4d35-8b57-d28f6bab89d6}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={384f10e4-be39-41cc-9ef4-f1bdb70da54f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={37ebd852-bc19-4145-a1a0-0ce1f4355691}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={384f10e4-be39-41cc-9ef4-f1bdb70da54f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
