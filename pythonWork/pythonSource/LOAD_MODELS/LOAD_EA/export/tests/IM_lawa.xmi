      <element xmi:idref="EAID_ENTI64_7F5_F6F4_4E38_AFE6_3DE1B5976A23" xmi:type="uml:Class" name="Hobbytierhaltung" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="34" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 08:50:31" modified="2022-06-15 18:12:00" keywords="ENTI64" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff definiert einen Standort auf dem eine Privatperson Hobbytiere h&#228;lt.  Die Standorte m&#252;ssen mit Koordinaten gef&#252;hrt werden.&#10;&#10;Die Registrierung der Tierhaltung erfolgt auf Grund der Tierseuchenverordnung (SRL 845) Paragraph 11.&#10;&#160;&#10;Die Dienststelle Landwirtschaft und Wald registriert alle Tierhaltungen und Best&#228;nde, in denen Klauentiere, Equiden, Hausgefl&#252;gel, Fische oder Bienen gehalten werden, mit den gem&#228;ss der eidgen&#246;ssischen Tierseuchengesetzgebung f&#252;r die Seuchenbek&#228;mpfung notwendigen Daten und gibt sie dem Bundesamt f&#252;r Landwirtschaft und dem Veterin&#228;rdienst bekannt.&#10;&#10;Hobbytierhalter, welche Klauentiere oder Equiden (Pferde, Esel, Maultiere, Maulesel) halten, m&#252;ssen ihre Tiere zus&#228;tzlich  bei der Tierverkehrsdatenbank (TVD) registrieren. Es gilt die Verordnung &#252;ber die Identitas AG und die Tierverkehrsdatenbank (SR 916.404.1) Art. 19&#10;&#10; Die Hobbytierhaltung sind Registerdaten und m&#252;ssen an den Bund (AGIS) &#252;bermittelt werden.&#10;&#10; Beispiele&#10; - Private H&#252;hnerhalter =&gt; Der Tierhaltungsstandort wird als &quot;Nichtkommerzielle Tierhaltung&quot; gef&#252;hrt&#10; - Stall-/Boxen auf  Landwirtschaftsbetrieb f&#252;r Hobbytierhaltung =&gt; der Tierhaltungsstandort wird als &quot;Ganzjahresbetrieb/Tierhaltung Dritte&quot; (Betriebsform Typ) gef&#252;hrt und ist dem Landwirtschaftsbetrieb noch zugeordnet." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={cc18f337-c2e5-4015-befb-0cb6afbdc899}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={be423a38-f000-4ba8-a3ad-7569e45ab620}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={2e859d94-45bc-4bfe-aaba-6d93ae132c0b}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={be423a38-f000-4ba8-a3ad-7569e45ab620}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
