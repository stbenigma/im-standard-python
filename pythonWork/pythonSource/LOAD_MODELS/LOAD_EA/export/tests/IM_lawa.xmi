        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Definition Kontakttypen:&#10;Kontakt hat Systemaufgaben als Privatperson =&gt; Erfassung Kontakt als Privatkontakt&#10;Kontakt hat Systemaufgaben als Gesch&#228;ftsperson =&gt; Erfassung Kontkat als Gesch&#228;ftskontakt&#10;Kontakt hat keine Systemaufgaben, sondern wird f&#252;r die die Kommunikation gef&#252;hrt =&gt; als Korrespondenzadresse kann der Privatkontakt genutzt werden" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
