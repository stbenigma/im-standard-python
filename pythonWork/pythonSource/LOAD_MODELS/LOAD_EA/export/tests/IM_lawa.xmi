        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff definiert Betriebe, welche Hof- und Recyclingd&#252;nger von Landwirtschaftsbetrieben annehmen und kompostieren bzw. weiterverarbeiten. Die Betriebe brauchen zugriff auf HODUFLU im Agate. HODULU dient zur einheitlichen Verwaltung von Hof- und Recyclingd&#252;ngerverschiebungen in der Landwirtschaft.&#10;&#10;Kompostierungsbetriebe  sind Registerdaten und m&#252;ssen an den Bund (AGIS) &#252;bermittelt werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={5abc3276-b465-44b5-8282-69c7df8bdd28}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={77d981ac-b495-4fe7-a79a-39c79f3c0aae}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={aefd5ed7-4a80-406e-b96d-345b7009aa43}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={77d981ac-b495-4fe7-a79a-39c79f3c0aae}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
