      <element xmi:idref="EAID_ENTI36_8A1_50C9_404D_867F_2914122F9D96" xmi:type="uml:Class" name="Betriebsform" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="6" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 08:14:03" keywords="ENTI36" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Betriebsform  ist georeferenziert und kann umfassen&#10;- einen Tierhaltungsstandort (Nutztiere, Hobbytiere)&#10;- einen Pflanzenbaustandort&#10;- einen Pflanzenbauverwerter (Verg&#228;hrungs- und Kompostierungsanlagen)&#10;&#10;Es gilt der Merkmalskatalog &quot;Registerdaten&quot; des Bundes&#10;Die Betriebsform umfasst s&#228;mtliche Betriebs- und Gemeinschaftsformen gem&#228;ss LBV [4] (Artikel 6 - 12 inkl. Verg&#228;hrungs- und Kompostierungsanlagen) und der TSV [7] (Art. 6, Bst. o) definiert." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={9d4c65b2-ad4d-4351-89b8-e3ac135f7f9c}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={42ac89d8-5c70-48a3-baaa-94edb37de4b8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={b870390d-9fd3-486f-859c-a615c5130f57}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={42ac89d8-5c70-48a3-baaa-94edb37de4b8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
