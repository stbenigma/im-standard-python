      <element xmi:idref="EAID_ENTI43_0F0_D14B_4C0A_8783_0A031CED5EBD" xmi:type="uml:Class" name="Bienenstand- oder Fischstandort" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="13" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 13:37:05" modified="2022-06-15 18:12:00" keywords="ENTI43" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff definiert den Standort von Bienenst&#228;nden oder Fischenzuchten, welche auf Grund der Tierseuchenverordnung erhoben werden m&#252;ssen. Die Standorte m&#252;ssen mit  Koordinaten gef&#252;hrt werden.&#10;&#10;Die Registrierung der Tierhaltung erfolgt auf Grund der Tierseuchenverordnung (SRL 845) Paragraph 11.&#10;&#160;&#10;Die Dienststelle Landwirtschaft und Wald registriert alle Tierhaltungen und Best&#228;nde, in denen Klauentiere, Equiden, Hausgefl&#252;gel, Fische oder Bienen gehalten werden, mit den gem&#228;ss der eidgen&#246;ssischen Tierseuchengesetzgebung f&#252;r die Seuchenbek&#228;mpfung notwendigen Daten und gibt sie dem Bundesamt f&#252;r Landwirtschaft und dem Veterin&#228;rdienst bekannt.&#10;&#10;Die Bienenst&#228;nde definieren den Ort der gehaltenen Bienenv&#246;lker.&#160;Bienenst&#228;nde sind durch den Imker nach den Vorgaben der zust&#228;ndigen kantonalen Stelle mit der Identifikationsnummer zu kennzeichnen. Die Identifikationsnummer muss von aussen gut sichtbar sein (SRL 845, Paragraph 12)&#10;&#10;Bienenst&#228;nde und Fischstandorte sind Registerdaten und m&#252;ssen an den Bund (AGIS) &#252;bermittelt werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={b303fa8b-d223-4a35-be67-31c2e455560a}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={29c41924-64ea-4f00-850d-d374fd146907}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={f933d8cc-6ab8-4499-b772-5f3052902754}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={29c41924-64ea-4f00-850d-d374fd146907}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
