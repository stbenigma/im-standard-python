      <element xmi:idref="EAID_ENTI39_A23_13E6_4DEE_9936_E7A121260074" xmi:type="uml:Class" name="Betriebszweiggemeinschaft" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="9" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 08:55:56" modified="2022-06-15 18:12:00" keywords="ENTI39" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Mehrere Betriebsleiter halten die Nutztiere gemeinsam oder f&#252;hren einen Teil ihrer Betriebszweige gemeinsam.&#10; &#10;Definition gem&#228;ss SR910.91 Artikel 12&#10;Eine Betriebszweiggemeinschaft besteht, wenn:&#10;- mehrere Betriebe Nutztiere gemeinsam halten oder einen Teil ihrer Betriebszweige gemeinsam f&#252;hren;&#10;- die Zusammenarbeit und die Aufteilung der Fl&#228;chen und Tiere in einem schriftlichen Vertrag geregelt sind;&#10;- die Bewirtschafter und Bewirtschafterinnen der beteiligten Betriebe f&#252;r die Betriebszweiggemeinschaft t&#228;tig sind;&#10;- die Betriebszentren der beteiligten Betriebe innerhalb einer Fahrdistanz von h&#246;chstens 15 km liegen und&#10;- jeder der beteiligten Betriebe vor dem Zusammenschluss einen Mindestarbeitsbedarf von 0,20 SAK erreicht." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={4ca378cc-3fd4-4089-9f26-4c713b9d05bd}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={910e2f2a-b8f7-45ba-99f1-f50e2a985f7b}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={17667a0a-db55-43a8-8a67-ab492bd27fa1}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={910e2f2a-b8f7-45ba-99f1-f50e2a985f7b}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR250_1D_8532_43E5_AB2F_C4F57B1778B8" name="Betriebszweig"/>
          <attribute xmi:idref="EAID_ATTR251_A6_9041_415C_9B72_6F49D89D32C2" name="Prozentsatz Betrieb 1"/>
        </attributes>
      </element>
      <element xmi:idref="EAID_ENTI40_603_F6FE_4198_B2DB_4DB4C58847B1" xmi:type="uml:Class" name="Bewirtschafter/in" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="10" ea_eleType="element"/>
        <project author="MMueller14" created="2022-02-03 09:31:41" keywords="ENTI40" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Definition gem&#228;ss SR910.91 Artikel 2&#10;Als Bewirtschafter oder Bewirtschafterin gilt die nat&#252;rliche, juristische Person oder die Personengesellschaft, welche  einen Betrieb auf eigene Rechnung und Gefahr f&#252;hrt und damit das Gesch&#228;ftsrisiko tr&#228;gt. F&#252;hrt ein Bewirtschafter oder eine Bewirtschafterin mehrere Produktionsst&#228;tten, so gelten diese zusammen als ein Betrieb.&#10;&#10;Die Bewirtschafter oder die Bewirtschafterin erh&#228;lt eine UID (Unternehmens-ID) und eine BUR-Nummer (Betriebs- und Unternehmenregister) vom Bund." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={07795ef2-8a1c-4020-a4ba-b200581a461b}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={11176829-5deb-49e4-a047-a2a0240f3cd9}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={238cd385-b07f-492c-9968-013c48f7d0c2}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={11176829-5deb-49e4-a047-a2a0240f3cd9}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
