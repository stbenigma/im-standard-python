      <element xmi:idref="EAID_ENTI112_69_A7D1_4186_881E_7B0246F05276" xmi:type="uml:Class" name="Produktionsst&#228;tte" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="82" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 08:08:37" modified="2022-06-15 18:12:00" keywords="ENTI112" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Beim Begriff  Produktionsst&#228;tte handelt es sich um die &quot;zus&#228;tzliche Produktionsst&#228;tte&quot; eines Landwirtschaftsbetriebes mit eigenen Koordinaten und TVD-Nummer. Die Produktionsst&#228;tte ist immer eine Nutztierhaltung (LBV SR910.91 Artikel 11).&#10;&#10;Definition Produktionsst&#228;tte  gem&#228;ss LBV SR910.91 Artikel 6 Absatz 2&#10;Als Produktionsst&#228;tte gilt eine Einheit von Land, Geb&#228;uden und Einrichtungen:&#10;a. die r&#228;umlich als solche erkennbar und getrennt von anderen Produktionsst&#228;tten ist;&#10;b. auf der eine oder mehrere Personen t&#228;tig sind; und&#10;c. die eine oder mehrere Tierhaltungen nach Artikel 11 umfasst.&#10;&#10;Die Landwirtschaftliche Begriffsverordnung definiert auch den Begriff Tierhaltung. Der Begriff meint die Nutztierhaltung bzw. die kommerzielle Tierhaltung.&#10;&#10;Definition Tierhaltung gem&#228;ss LBV SR910.91 Artikel 11&#10;1 Als Tierhaltung (Nutztierhaltung) gelten Stallungen und Einrichtungen (ohne Weideunterst&#228;nde oder Weidstadel) zum regelm&#228;ssigen Halten von Tieren auf der Produktionsst&#228;tte sowie auf dem S&#246;mmerungs- oder Gemeinschaftsweidebetrieb." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={0cdda9e4-a18f-4387-ac0f-41bca278f8ba}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={bc5f5d4c-7e63-4a52-b150-6abc79620021}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={865145fe-8907-448a-8a2d-7b800f66ed44}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={bc5f5d4c-7e63-4a52-b150-6abc79620021}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
