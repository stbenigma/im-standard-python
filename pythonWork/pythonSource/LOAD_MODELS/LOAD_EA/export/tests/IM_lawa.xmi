      <element xmi:idref="EAID_ENTI104_CD_5705_4DC0_A0FB_2997B095CA1F" xmi:type="uml:Class" name="N&#228;hrstoff-Abgeber" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="74" ea_eleType="element"/>
        <project author="Markus" created="2022-04-20 05:35:31" keywords="ENTI104" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein N&#228;hrstoff-Abgeber ist ein Bewirtschafter oder ein privater Tierhalter, welcher N&#228;hrstoffe an einen anderen Betrieb abgeben will. Der Begriff stammt vom Bund und wird verwendet in HODUFLU.&#10;&#10;HODUFLU ist ein Internetprogramm in Agate zur einheitlichen Verwaltung von Hof- und Recyclingd&#252;ngerverschiebungen in der Landwirtschaft. Es vereinfacht und beschleunigt den administrativen Ablauf von N&#228;hrstoffverschiebungen in der Landwirtschaft und erm&#246;glicht eine transparente Darstellung der N&#228;hrstofffl&#252;sse." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={578dce33-f237-4166-9e47-f9c972f1b425}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={f1217aae-f58f-456f-8157-be9825d65cf8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={0964b09b-5334-4f64-be64-7e5fec33e65e}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={f1217aae-f58f-456f-8157-be9825d65cf8}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI105_FE_ED23_4C35_9C0D_8A91799BC192" xmi:type="uml:Class" name="N&#228;hrstoff-Annehmer" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="75" ea_eleType="element"/>
        <project author="Markus" created="2022-04-20 05:36:26" keywords="ENTI105" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein N&#228;hrstoff-Annehmer ist ein Bewirtschafter oder eine Kompostieranlage, welcher N&#228;hrstoffe von  einem anderen Betrieb annimmt. Der Begriff stammt vom Bund und wird verwendet in HODUFLU.&#10;&#10;HODUFLU ist ein Internetprogramm in Agate zur einheitlichen Verwaltung von Hof- und Recyclingd&#252;ngerverschiebungen in der Landwirtschaft. Es vereinfacht und beschleunigt den administrativen Ablauf von N&#228;hrstoffverschiebungen in der Landwirtschaft und erm&#246;glicht eine transparente Darstellung der N&#228;hrstofffl&#252;sse." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={d8cdaa67-6b86-4256-a258-3b755a31900e}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={58439542-2b43-47f4-a887-76c7334a8b8a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={53bd40ee-b16d-43d6-9ecb-1b994551234d}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={58439542-2b43-47f4-a887-76c7334a8b8a}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
