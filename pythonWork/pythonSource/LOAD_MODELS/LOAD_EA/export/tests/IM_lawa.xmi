      <element xmi:idref="EAID_ENTI119_2A_4643_4219_A395_C02FC4258F22" xmi:type="uml:Class" name="Strukturobjekt" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="89" ea_eleType="element"/>
        <project author="Markus" created="2022-04-20 12:50:52" keywords="ENTI119" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Beim Begriff Strukturobjekt handelt es sich um einen technischen Begriff. Die landwirtschaftlichen Strukturdaten m&#252;ssen dem Bund (AGIS) &#252;bermittelt werden. Um eine schweizweite Normierung zu erreichen, muss jedes Kulturobjekt einem Kultur-Code zugeordnet werden k&#246;nnen.&#10;&#10;S&#228;mtliche Kulutrcodes sind im Kapitel C des Merkmalskatalogs Strukturdaten von AGIS beschrieben.&#10;&#10;Ein Kulturobjekt definiert  Tiere und Fl&#228;chen&#10;&#10;Beispiel Kultur-Code:&#10;Gruppe Fl&#228;chenkatalog&#10;- 501 Sommergerse&#10;- 502 Wintergerste&#10;...&#10;- 555 Ackerschonstreifen&#10;&#10;Tierhaltung&#10;- 1110 Rindergattung und Wasserb&#252;ffel, Milchk&#252;he&#10;..." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={0a76a6b8-6a2a-442e-bdfa-40c65f2f6a32}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={28aa5ced-546a-40d1-ad33-41004221e34e}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={73771878-56be-415d-8470-bbad6b1da44b}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={28aa5ced-546a-40d1-ad33-41004221e34e}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR278_3D_2907_479F_AAF0_BFA099D97ED8" name="Struktur-Code"/>
        </attributes>
      </element>
