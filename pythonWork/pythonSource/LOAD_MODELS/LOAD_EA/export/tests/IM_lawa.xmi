      <element xmi:idref="EAID_ENTI132_C9_9909_4102_84BA_7011AF5D80C7" xmi:type="uml:Class" name="&#246;LN Gemeinschaft" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="102" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 09:42:28" modified="2022-06-15 18:12:00" keywords="ENTI132" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Die &#246;LN-Gemeinschaft ist eine Spezialform der Betreibszweiggemeinschaft. Sie kann nur eingegangen werden, wenn in einem Betriebszweig zusammengearbeitet wird.&#10;&#10;Gemeinschaft von Ganzjahresbetriebe welche &#246;kologischen Leistungsnachweis (&#214;LN) gemeinsam erf&#252;llen. &#10;Die Vereinbarung kann auch nur Teile der &#214;LN beinhalten, dies ist mit folgenden Elementen m&#246;glich: ausgeglichene D&#252;ngerbilanz, Anteil Biodiversit&#228;tsfl&#228;chen, Artikel 16-18 (Fruchtfolge, Bodenschutz, Einsatz Pflanzenschutzmittel) und k&#246;nnen &#252;berbetrieblich erf&#252;llt werden &#10;Eine &#214;LN-Gemeinschaft kann nur bewilligt werden, wenn:&#10;- die Betriebszentren der beteiligten Betriebe innerhalb einer Fahrdistanz von h&#246;chstens 15 km liegen;&#10;- die Betriebe die Zusammenarbeit schriftlich geregelt haben;&#10;- die Betriebe eine gemeinsame Kontrollstelle bestimmt haben;&#10;- keiner der Betriebe bereits eine andere Vereinbarung zur &#252;berbetrieblichen Erf&#252;llung des &#214;LN abgeschlossen hat." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2d28d719-a7a8-4a82-87dc-0277038760d8}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={5aa86c67-3b63-4497-acc3-50c4d0c991ad}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={01dd23e8-b054-4dc6-881c-87797ac1b762}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={5aa86c67-3b63-4497-acc3-50c4d0c991ad}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR247_D3_08D4_4B37_80B2_B4BFFD68C95E" name="&#246;LN-Vertragtypus"/>
        </attributes>
      </element>
