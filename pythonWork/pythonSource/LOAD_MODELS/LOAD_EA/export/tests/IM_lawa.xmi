        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff Entit&#228;t leitet sich aus dem Lateinischen ab und bedeutet &#8222;Seiendes&#8220; oder &#8222;Ding&#8220;. In der Informatik ist eine Entit&#228;t ein eindeutig identifizierbares, einzelnes Informationsobjekt. Entit&#228;ten k&#246;nnen sowohl reale Dinge oder Personen als auch abstrakte Objekte sein." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
