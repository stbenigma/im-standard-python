      <element xmi:idref="EAID_ENTI125_16_DF2F_4B02_86C0_F490A07E71B4" xmi:type="uml:Class" name="Tierhalter/Tierhalterin" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="95" ea_eleType="element"/>
        <project author="Markus" created="2022-03-24 08:52:49" keywords="ENTI125" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Definition gem&#228;ss SR910.91 Artikel 11a&#10;Als Tierhalter und Tierhalterinnen gelten die:&#10;a. Bewirtschafter und Bewirtschafterinnen nach Artikel 2, die Tiere halten;&#10;b.28 Bewirtschafter und Bewirtschafterinnen von S&#246;mmerungs- und Gemeinschaftsweidebetrieben, die Tiere halten.&#10;&#10;Der Tierhalter oder die Tierhalterin  erh&#228;lt eine UID (Unternehmens-ID) und eine BUR-Nummer (Betriebs- und Unternehmenregister) vom Bund." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={132f35fb-76f6-47f4-8380-d34d6329ded0}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={72c8859d-ffda-4484-a3b8-92c5535604ba}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={733efd0a-013d-4ff5-9342-83f9797e5b07}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={72c8859d-ffda-4484-a3b8-92c5535604ba}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
