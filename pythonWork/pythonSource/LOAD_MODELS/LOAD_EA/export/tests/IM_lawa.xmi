        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Bei juristischen Personen handelt es sich um&#160;Unternehmen&#160;wie Aktiengesellschaften oder&#160;Gesellschaften mit beschr&#228;nkter Haftung, oder aber auch um Vereine und Stiftungen.&#10;&#10;Die juristischen Personen sind handlungsf&#228;hig, sobald die nach Gesetz und Statuten hierf&#252;r unentbehrlichen Organe bestellt sind. (Art. 54 ZGB) Die Organe geben dem Willen der juristischen Person Ausdruck. (Art. 55 ZGB)." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
