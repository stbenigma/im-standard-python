      <element xmi:idref="EAID_ENTI126_A0_B5BE_477B_AE5D_6F25558AB6F9" xmi:type="uml:Class" name="Tierhandelsbetrieb" scope="public">
        <model package="EAPK_6BCE1A9A_8F8F_4F00_9382_0046D53D2DF8" tpos="0" ea_localid="96" ea_eleType="element"/>
        <project author="MMueller14" created="2020-02-01 11:23:21" modified="2022-06-15 18:12:00" keywords="ENTI126" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Der Begriff umfasst Tierhandelsunternehmen, Schlachtbetriebe, Tierkliniken. S&#228;mtliche Organisationen haben tempor&#228;r Nutz- oder Hobbytiere vor Ort und m&#252;ssen somit &#252;ber eine TVD-Nummer verf&#252;gen.&#10;&#10;Folgende Betriebstypen geh&#246;ren dazu:&#10;- Schlachtbetriebe&#10;- Tierkliniken&#10;- Viehhandelsunternehmen&#10;- Viehausstellung&#10;- Wanderherde&#10;&#160;&#10;Tierhandelsbetriebe sind Registerdaten und m&#252;ssen an den Bund (AGIS) &#252;bermittelt werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={43cae8a3-96a8-4949-b7d5-c1f10b761b05}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={feee9b7e-7329-4425-9dca-5daef4286470}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={00aa97ec-d3db-4154-8f08-1552817382f6}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={feee9b7e-7329-4425-9dca-5daef4286470}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
