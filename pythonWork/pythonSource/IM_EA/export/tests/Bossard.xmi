      <element xmi:idref="EAID_ENTI260_7B_B13A_405B_A5D9_7C4119D03248" xmi:type="uml:Class" name="Lieferanten Allgemeine Gesch&#228;ftsbedingung" scope="public">
        <model package="EAPK_E0F04F6F_C8B4_4577_AFBB_E54665D2E160" tpos="0" ea_localid="96" ea_eleType="element"/>
        <project author="vew" created="2021-11-17 12:48:58" keywords="ENTI260" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Wir geben die AGB vor. Wenn der Lieferant nichts dagegen sagt, gelten unsere AGBs&#10;AGBs werden von Bossard definiert f&#252;r eine Gruppe von Lieferanten, welch die Lieferanten akzeptieren m&#252;ssen. Gelten, wenn nichts anderes gilt.&#10;&#10;AGBs von Partner. Wenn wir diese nicht zur&#252;ckweisen, gelten diese." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2d6b6b6b-b046-4f9a-a157-8b29325317c7}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={ce114ad9-bd6f-40e7-bc29-9b07f0e8b5b2}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={0f75bb87-4829-45fe-8b51-c0a6a9e0a141}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={ce114ad9-bd6f-40e7-bc29-9b07f0e8b5b2}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
      <element xmi:idref="EAID_ENTI261_64_DB1C_494A_BB83_3DC2FC2F6736" xmi:type="uml:Class" name="Lieferantenartikel" scope="public">
        <model package="EAPK_E0F04F6F_C8B4_4577_AFBB_E54665D2E160" tpos="0" ea_localid="97" ea_eleType="element"/>
        <project author="vew" created="2021-10-19 12:06:33" keywords="ENTI261" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Artikel mit den Angaben des Lieferanten: Name/Bezeichnung/Artikelnummer, der an eine Organisation geliefert wird.&#10;&#10;Kann Organisationsspezifisch sein. Wird von verschiedenen BU's unabh&#228;ngig gepflegt, wissen aber nichts voneinander.&#10;&#10;Nummer, Bezeichnung, ...&#10;&#10;Die Lieferantenartikelnummer kann sein&#10;- die Nummer des Lieferanten&#10;- die Nummer von Bossard, die der Lieferant &#252;bernimmt&#10;&#10;Es ist m&#246;glich, dass der Lieferant das gleich Produkt in unterschiedlichen L&#228;ndern mit unterschiedlichen Lieferantenartikelnummern vertreibt. &#10;&#10;Ein identischen Produkt (z.B. Brand PEM) kann von unterschiedlichen Lieferanten (z.B. H&#228;ndler) geliefert werden mit unterschiedlichen Lieferantenartikelnummern." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={0a805573-c1f4-4329-b7a6-0cff74dd6a3b}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={963c4b65-2148-447d-89b5-944d383985d7}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={9570918a-cd70-4a35-b2f4-894759440694}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={963c4b65-2148-447d-89b5-944d383985d7}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes>
          <attribute xmi:idref="EAID_ATTR587_F0_B907_4A8C_9F57_190687BC0E77" name="Lieferantenartikel Nummer"/>
        </attributes>
      </element>
