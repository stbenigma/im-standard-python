        <project author="stb" created="2021-11-30 14:24:58" keywords="ENTI229" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Spezifische Bedingungen g&#252;ltig f&#252;r eine Bestellposition abweichend von allen &#252;bergeordneten Bedingungen.&#10;&#10;unterschiedliiches Ursprungsland (kann in der Bestellung schon unterschieden werden, wenn wir die Info via Angebot schon erhalten haben), ist aber heute eine manuelle Eingabe auf Positionstext.  Oder wenn wir von uns aus eine spez. Anforderung haben.&#10;(Steuerung Antii Dumping)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={c213490c-5429-4a2a-9d24-5495773efbb3}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={0e575d08-b13f-473a-84eb-d130de19802e}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={24a9142f-3f67-4b9e-9d65-84aa76106871}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={0e575d08-b13f-473a-84eb-d130de19802e}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
