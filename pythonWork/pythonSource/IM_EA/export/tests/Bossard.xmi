      <element xmi:idref="EAID_ENTI343_B9_B07E_4850_8359_2A7C0D9759D0" xmi:type="uml:Class" name="Verkaufs Forecast" scope="public">
        <model package="EAPK_E0F04F6F_C8B4_4577_AFBB_E54665D2E160" tpos="0" ea_localid="179" ea_eleType="element"/>
        <project author="stb" created="2021-11-30 12:11:34" keywords="ENTI343" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Unverbindliche Bestellung, Menge ist nicht freigegeben durch den Kunden. &#10;Macht eine Reservation im System auf unser Risiko. Bietet uns aber Planungsm&#246;glichkeiten.&#10;&#10;Deshalb darf man f&#252;r Non-Core Produkte (eigentlich) keinen Forcast haben ohne Kontrakt. &#10;F&#252;r Core Produkte ist ein Forecast ohne Kontrakt m&#246;glich, weil diese Produkte &quot;Supply Driven&quot; beschafft werden und Lagerbest&#228;nde vorhanden sind. &#10;&#10;Auf einen Forecast muss eine Bestellung des Kunden folgen. Normalerweise l&#228;sst der Verkauf einen Forcast in einen Kontrakt umwandeln, bevor wir grosse Einkaufsseitige Bestellungen f&#252;r den Kunden t&#228;tigen.&#10;&#10;Lagerbewirtschaftung pro Kunde mit Risiko Bossard." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={5e2ce4e9-cf60-4731-892e-a11a3f11c999}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={9ae3f895-7151-4f30-a0bb-95d96814e462}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={cfc769bf-ed4c-4d07-b730-2b06f5d37274}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={9ae3f895-7151-4f30-a0bb-95d96814e462}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
