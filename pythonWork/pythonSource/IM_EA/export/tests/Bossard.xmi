        <project author="vew" created="2021-10-19 12:16:44" keywords="ENTI174" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Ein Bossard Artikel-Los ist gekennzeichnet mit&#10;- einer Bossard Batch ID  (oder einer Bossard Trace ID, interne Batch-Nr)  die mit der Einlagerung eines Lieferantenartikelloses generiert wird.&#10;&#10;Eine Einalgerung (Receipt) entspricht der ganzen Menge oder der Teilmenge eines Lieferantenartikelloses. Liefert der Lieferant Unterlose, werde diese in mehrere Einlagerungen gesplittet. Aus einem Lieferantenartikel-Los k&#246;nnen mehrere Bossard Batch ID generiert werden." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={2bbfb42a-5836-4952-be7f-277175435b07}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={95500746-5505-4011-ac45-7838430ac58f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={dedaecb3-5617-4ee6-818c-d18832b8f023}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={95500746-5505-4011-ac45-7838430ac58f}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
