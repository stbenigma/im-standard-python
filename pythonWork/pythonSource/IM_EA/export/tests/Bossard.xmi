        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Preis, der dem Kunden in Rechnung gestellt wird. &#10;&#10;Individuelle Vereinbarung definiert f&#252;r einen Kunden oder f&#252;r eine Kundengruppe (jeder Kunde (jeder der eine Kundennummer hat) kann einer Gruppe zugeteilt werden) Ein Kunde kann nur in einer Gruppe sein. &#10;&#10;Sichtbar mit Login im eShop" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
