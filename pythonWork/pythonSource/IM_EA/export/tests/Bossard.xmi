        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Einem Kundenkostentr&#228;ber werden die Kosten belastet, die direkt im Zusammenhang mit den Produkten entstehen, die an den Kudnen verkauft wurden. Darunter fallen &#10;- Produkteinstandskosten&#10;- Transportkosten&#10;&#10;Organisatorische Kosten werden nicht auf Kundenkostentr&#228;ger umgelegt.&#10;&#10;Kostentr&#228;gernummer = Kundennummer" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
