        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Vordefinierte Gruppe unter der non-Core Items erfasst werden k&#246;nnen.&#10;&#10;Im FACTS ist dies die Special (SA)-BN.&#10;&#10;In AX sind dies Basket + Subbasket, welche mit der Produkthierarchie verkn&#252;ft sind und welche einen Teil der Produktbeschreibung vorgeben." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
