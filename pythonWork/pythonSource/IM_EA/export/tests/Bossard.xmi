      <element xmi:idref="EAID_ENTI230_D0_AE41_441E_89D8_606EA09136B0" xmi:type="uml:Class" name="Kunde Lieferbedingung" scope="public">
        <model package="EAPK_E0F04F6F_C8B4_4577_AFBB_E54665D2E160" tpos="0" ea_localid="66" ea_eleType="element"/>
        <project author="stb" created="2021-11-30 14:24:58" keywords="ENTI230" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Vereinbarung, wie wir konkret mit einem Kunden zusammenarbeiten&#10;Wird auf dem Kunden hinterlegt und kann dann auf der Bestellung angepasst werden.&#10;&#10;Kann beinhalten:&#10;&#8226;&#9;Qualit&#228;tssicherungsvereinbarung, z.B  Kunde befreit uns von WE-Pr&#252;fung&#10;&#8226;&#9;Zahlungskonditionen (Finanzen)&#10;&#8226;&#9;Inco Terms (Transportvereinbarungen)&#10;&#8226;&#9;Labelling&#10;&#8226;&#9;Packaging&#10;Eine Vereinbarung wird gew&#246;hnlich mit einem Lieferant abgeschlossen.&#10;&#10;Es kann mehrere Bedingungen geben (Auswahl) die man bei einer Bestellung ausw&#228;hlen kann.&#10;+ Unterschiedlich pro OE.&#10;&#10;Inco Term werden immer auf der OE Ebene  definiert. &#10;&#10;Zahlungskonditionen und Rabatte k&#246;nnen Global definert werden &#10;- Mutterhaus Lieferant&#10;- Gruppe oder Region Bossard&#10;&#10;Muss nicht zwingend in einem schrift. Vertrag festgelegt sein. Bei vielen Kunden werden die Details mit der Bestellung &#252;bermittelt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={e1c7dd5e-02b3-4984-8c10-aea328b904ed}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={c654d103-2e0b-4f6f-875a-85e32115ef4d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={9e7bcaca-6f13-4510-8237-9090547ca182}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={c654d103-2e0b-4f6f-875a-85e32115ef4d}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
