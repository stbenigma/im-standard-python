        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Wir geben die AGB vor. Wenn der Kunde  nichts dagegen sagt, gelten unsere AGBs&#10;AGBs werden von Bossard definiert f&#252;r eine Gruppe von Kunden, welche der Kunde akzeptiert muss.&#10;Gelten, wenn nichts anderes gilt.&#10;&#10;AGBs von Kunden. Wenn wir diese nicht zur&#252;ckweisen, gelten diese." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
