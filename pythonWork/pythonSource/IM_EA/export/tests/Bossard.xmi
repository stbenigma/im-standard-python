      <element xmi:idref="EAID_ENTI256_15_02D2_41AC_939C_3BBBE24FF849" xmi:type="uml:Class" name="Lieferant Lieferbedingung" scope="public">
        <model package="EAPK_E0F04F6F_C8B4_4577_AFBB_E54665D2E160" tpos="0" ea_localid="92" ea_eleType="element"/>
        <project author="vew" created="2021-11-17 13:06:52" keywords="ENTI256" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Vereinbarung, wie wir konkret mit einem Lieferanten zusammenarbeiten&#10;Wird auf dem Lieferant hinterlegt und kann dann auf der Bestellung angepasst werden.&#10;&#10;Kann beinhalten:&#10;&#8226;&#9;Qualit&#228;tssicherungsvereinbarung, z.B  Lieferant befreit uns von WE-Pr&#252;fung&#10;&#8226;&#9;Zahlungskonditionen (Finanzen)&#10;&#8226;&#9;Inco Terms (Transportvereinbarungen)&#10;&#8226;&#9;Labelling&#10;&#8226;&#9;Packaging&#10;Eine Vereinbarung wird gew&#246;hnlich mit einem Lieferant abgeschlossen.&#10;&#10;Es kann mehrere Bedingungen geben (Auswahl) die man bei einer Bestellung ausw&#228;hlen kann.&#10;+ Unterschiedlich pro OE.&#10;&#10;Inco Term werden immer auf der OE Ebene  definiert. &#10;&#10;Zahlungskonditionen und Rabatte k&#246;nnen Global definert werden &#10;- Mutterhaus Lieferant&#10;- Gruppe oder Region Bossard&#10;&#10;Muss nicht zwingend in einem schrift. Vertrag festgelegt sein. Bei vielen Lieferanten werden die Details mit der Bestellung &#252;bermittelt." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={a1c5d146-2af8-41e2-886d-69a0c0535d24}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={dfac476a-568f-45e3-8e28-cecfa6c38798}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={4a226d29-fad1-415d-9deb-2124192c0d9c}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={dfac476a-568f-45e3-8e28-cecfa6c38798}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
