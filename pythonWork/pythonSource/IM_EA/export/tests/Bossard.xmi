        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Verwendet unsere Proukte in seinen Endprodukten/Erzeugnissen entweder&#10;- direkt (= Kunde)&#10;- oder eingebaut in Habfabrikaten, welche durch Unterlieferanten gefertigt werden. &#10;&#10;Im Normalfall f&#252;hrt der OEM Preisverhandlungen. Der OEM kann mit Bossard einen Vertrag abschliessen, der anschliessend f&#252;r den Subcontractor gilt. Vertrag erfolgt mit dem OEM oder mit dem Subcontractor." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
