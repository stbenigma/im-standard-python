        <properties documentation="Will Produkte und/oder Dienstleistungen von Bossard in Anspruch nehmen.&#10;Mit der Erteilung des ersten Auftrags wird ein Interessent zum Kunden. &#10;Der Kunde macht mit Bossard Gesch&#228;fte.&#10;Der Kunde verarbeitet und/oder nutzt unsere Produkte und Dienstleistungen." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
