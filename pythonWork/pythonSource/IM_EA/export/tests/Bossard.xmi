        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Spezifische Bedingungen g&#252;ltig f&#252;r eine Bestellposition abweichend von allen &#252;bergeordneten Bedingungen.&#10;&#10;unterschiedliiches Ursprungsland (kann in der Bestellung schon unterschieden werden, wenn wir die Info via Angebot schon erhalten haben), ist aber heute eine manuelle Eingabe auf Positionstext.  Oder wenn wir von uns aus eine spez. Anforderung haben.&#10;(Steuerung Antii Dumping)" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
