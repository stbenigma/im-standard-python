        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine Organisatorische Einheit,  die Kosten  verursacht.&#10;&#10;Muss mindestens 3 Angestellte umfassen.&#10;&#10;Im Normalfall entspricht die KST der Abteilung. Es gibt auch &quot;Technische&quot; Kostenstellen (z.B. Abschreibungen f&#252;r Computersysteme und Digitalisierungsprojekte) aber auch diese KST geh&#246;ren zu einer Abteilung (in Diesem Fall IT)." isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
