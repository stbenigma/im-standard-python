      <element xmi:idref="EAID_ENTI356_B3_ACC8_4DBC_8816_8C20CE7099C5" xmi:type="uml:Class" name="anerkannter Lieferant f&#252;r Standard Produkte" scope="public">
        <model package="EAPK_E0F04F6F_C8B4_4577_AFBB_E54665D2E160" tpos="0" ea_localid="192" ea_eleType="element"/>
        <project author="vew" created="2021-09-29 14:02:22" modified="2022-06-15 18:23:32" keywords="ENTI356" status="Proposed"/>
        <code product_name="Informationmodel" gentype="IM"/>
        <properties documentation="Eine juristische Person, die uns etwas verkauft.&#10;&#10;Dieser Lieferant muss zwingend auf der Liste &quot;Anerkannter Lieferant f&#252;r Standards&quot; aufgenommen werden. Die Liste wird erstellt und regelm&#228;ssig nachgef&#252;hrt von den Einkaufsverantwortlichen der drei Regionen.&#10;&#10;Von diesem Lieferant akzeptieren wir Standard Produkte weil die Produkte klar spezifiziert und indentifizierbar sind.&#10;Die Spezifikation ist online vef&#252;gbar. Die Produkte sind durch eine weltweit eindeutige Referenz identifizierbar.&#10;Von diesen Lieferanten wird eine Spezifikation akzeptiert.&#10;&#10;Der Lieferant ist eine anerkannte Gr&#246;sse in mindestens einer Region (Europa, Asien, Amerika) und kann bevorzugt in mehrere L&#228;nder liefern. L&#228;nder, die dieser Lieferant nicht abdecken kann, k&#246;nnen &#252;ber &quot;Intercompany&quot; (von einem Lager einer anderen Organisation) beschafft werden.&#10;&#10;Damit sind diese Lieferanten vergleichbar mit offiziellen Brands.&#10;&#10;Beispiele: Far, Beneri, Grower Metall" isSpecification="false" sType="Class" nType="0" scope="public" stereotype="Entity" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
        <xrefs value="$XREFPROP=$XID={811072d8-99bc-4851-b44c-fdc47f233b6f}$XID;$NAM=Stereotypes$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@STEREO;Name=Entity;FQName=Informationmodel::Entity;@ENDSTEREO;$DES;$CLT={6325122d-0ef8-4d8c-ba26-c377ba966875}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;$XREFPROP=$XID={8d40d2fe-d7cc-4623-8bd1-30f6515b30fd}$XID;$NAM=CustomProperties$NAM;$TYP=element property$TYP;$VIS=Public$VIS;$PAR=0$PAR;$DES=@PROP=@NAME=_HideUmlLinks@ENDNAME;@TYPE=string@ENDTYPE;@VALU=True@ENDVALU;@PRMT=@ENDPRMT;@ENDPROP;$DES;$CLT={6325122d-0ef8-4d8c-ba26-c377ba966875}$CLT;$SUP=&lt;none&gt;$SUP;$ENDXREF;"/>
        <attributes/>
      </element>
