[ODM]
#base directory for all modeler data (with ending /)
odmbasedirec = "/Users/stb/Documents/Projekte/FYAYC_intern/gitHub/CRM/"

#base directory for all local results of model extract (with ending /)
#default = odmbasedirec
localbasedirec = "/Users/stb/Documents/Projekte/FYAYC_intern/CRM/"

#base directory for odm-model-files (with ending /)
#default <odmBaseDirec> + odmIMDefaultDirec
#odmimdirec = 

#model name
#default: single .dmd file in <odmIMDirec> or <odmIMDirec>/IM or <odmIMDirec>/gitHub/IM
odmmodelname = "IM_CRM_FYAYC"

#directory containing odm-configuration-files (below odmIMDirec)
#odmkonfdirec = "Konfiguration/"

#name of user defined property-File containing translations udp"s
#odmudptranslfilename = "translation"

#name of user defined property-File containing data mapping udp"s
#odmudpmappingfilename = "datamapping"

#directory containing versioned model
odmvcsdirec = "gitHub/"

#default directory for odm-model—file (below odmIMDirec)
odmimdefaultdirec = "IM/"

#default extension of odm-model-base file
odmimextension = ".dmd"

[DB]
#default language of model in DB
#dbdefaultlang = "de"

#comma separated languages to be maintained, choose from de, en, fr, es
#dblanguages = "de,en"

#default directory for DB-file (below odmIMDirec)
#dbdefaultdirec = "DB/"

#directory containing DB-file (with ending /)
#default: <localbasedirec> <dbDefaultDirec>/
#dbdirec =

#default extension for DB-file
#dbfileextension = ".db"

#complete pathinformation (path-filename-extension) of DB-file
#default: <dbDirec>/<odmModelName>/<dbFileExtension>
#dbfilepath = 

[WEB]
#default directory for web-source output
webdefaultdirec = "Web/"

#directory for web-source output
#default <localbasedirec> <webDefaultDirec>
#webdirec =

#filename of logo in Webpage (path webdirec/image/)
#default logo.png
#logofilename = 
