<userDefinedSQL>SELECT&lt;br/&gt;    wertebereich.wrtb_id,&lt;br/&gt;    wertebereich.wrtb_business_rule,&lt;br/&gt;    uetx_name.uetx_originaltext as WRTB_NANE,&lt;br/&gt;    wertebereich.wrtb_uetx_id_name,&lt;br/&gt;    uetx_beschr.uetx_originaltext as WRTB_BESCHR,&lt;br/&gt;    wertebereich.wrtb_uetx_id_beschr,&lt;br/&gt;    wertebereich.wrtb_text_maxlng,&lt;br/&gt;    wertebereich.werb_text_syntaxregel&lt;br/&gt;FROM&lt;br/&gt;    wertebereich&lt;br/&gt;    LEFT JOIN uebersetz_text uetx_name ON uetx_name.uetx_id = wertebereich.wrtb_uetx_id_name                              &lt;br/&gt;    left JOIN uebersetz_text uetx_beschr ON uetx_beschr.uetx_id = wertebereich.wrtb_uetx_id_beschr &lt;br/&gt;WHERE wrtb_typ = &apos;TEXT&apos;&lt;br/&gt;             &lt;br/&gt; </userDefinedSQL>
