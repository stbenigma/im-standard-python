<userDefinedSQL><![CDATA[SELECT
    collect(organisationseinheit.name,firma.name)AS name,
    organisationseinheit.email,
    organisationseinheit."Telefon-Nr",
    collect(organisationseinheit.adresse,firma.adresse)AS adresse
FROM
    betreiber
    INNER JOIN organisationseinheit ON organisationseinheit.name = betreiber.name
                                       AND organisationseinheit.name1 = betreiber.name1
                                       AND organisationseinheit.name11 = betreiber.name11
    INNER JOIN firma ON betreiber.name2 = firma.name
GROUP BY
    organisationseinheit.email,
    organisationseinheit."Telefon-Nr",
    organisationseinheit.adresse,
    firma.adresse,
    organisationseinheit.name,
    firma.name]]></userDefinedSQL>
