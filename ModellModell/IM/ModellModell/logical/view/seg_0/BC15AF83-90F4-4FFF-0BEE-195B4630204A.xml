<userDefinedSQL>SELECT&lt;br/&gt;    collect(organisationseinheit.name,firma.name)AS name,&lt;br/&gt;    organisationseinheit.email,&lt;br/&gt;    organisationseinheit.&quot;Telefon-Nr&quot;,&lt;br/&gt;    collect(organisationseinheit.adresse,firma.adresse)AS adresse&lt;br/&gt;FROM&lt;br/&gt;    betreiber&lt;br/&gt;    INNER JOIN organisationseinheit ON organisationseinheit.name = betreiber.name&lt;br/&gt;                                       AND organisationseinheit.name1 = betreiber.name1&lt;br/&gt;                                       AND organisationseinheit.name11 = betreiber.name11&lt;br/&gt;    INNER JOIN firma ON betreiber.name2 = firma.name&lt;br/&gt;GROUP BY&lt;br/&gt;    organisationseinheit.email,&lt;br/&gt;    organisationseinheit.&quot;Telefon-Nr&quot;,&lt;br/&gt;    organisationseinheit.adresse,&lt;br/&gt;    firma.adresse,&lt;br/&gt;    organisationseinheit.name,&lt;br/&gt;    firma.name</userDefinedSQL>
